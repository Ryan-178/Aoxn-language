{
  "name": "aoxn-ide",
  "version": "0.1.0",
  "private": true,
  "description": "The Aoxn IDE — editor, project explorer and build runner for the Aoxn language",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "ide:dev": "tauri dev",
    "ide:build": "tauri build",
    "ide:build:fast": "tauri build --no-bundle"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.3",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.19.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  }
}