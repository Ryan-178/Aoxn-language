# Aoxn multi-file loader, written in Aoxn (self-hosting).
#
# Resolves `import "..."` recursively like src/files.rs: paths are relative
# to the importing file, each file is included once (canonical-path key =
# the joined path string) and cycles are rejected via an import stack.
#
# All files parse into ONE shared arena (PState), so node indices stay valid
# across files; each file's top-level nodes are appended to a single global
# program root (LoadState.root — parse_program overwrites p.root per file).
# Write-back discipline throughout.

import * from "../stdlib/stdlib.ax"
import * from "./lexer.ax"
import * from "./parser.ax"
import * from "./typecheck.ax"

# environment lookup shared with the driver's option defaults
extern def getenv(name: string) -> string

def env_str(name: string, dflt: string) -> string:
    v = getenv(name)
    if as_ptr(v) == 0:
        return dflt
    return v

def spec_prefix(s: string, p: string) -> int:
    if len(s) < len(p):
        return 0
    i = 0
    while i < len(p):
        if str_get(s, i) != str_get(p, i):
            return 0
        i = i + 1
    return 1

# `stdlib` / `stdlib/<module>` resolve against AOXN_STDLIB, then
# $AOXN_HOME/lib/stdlib, then the repository-relative `stdlib/` directory.
def stdlib_dir() -> string:
    d = env_str("AOXN_STDLIB", "")
    if d != "":
        return d
    h = env_str("AOXN_HOME", "")
    if h != "":
        return h + "/lib/stdlib"
    return "stdlib"

def resolve_specifier(spec: string) -> string:
    if spec == "stdlib":
        return stdlib_dir() + "/stdlib.ax"
    if spec_prefix(spec, "stdlib/") == 1:
        rest = str_slice(spec, 7, len(spec) - 7)
        if len(rest) < 4:
            return stdlib_dir() + "/" + rest + ".ax"
        if str_slice(rest, len(rest) - 3, 3) != ".ax":
            return stdlib_dir() + "/" + rest + ".ax"
        return stdlib_dir() + "/" + rest
    return spec
struct LoadState:
    p: PState
    root: int
    files: Vec
    stack: Vec
    err: int
    errmsg: string
    err_stage: string
    err_line: int
    err_col: int
    err_file: string
    err_raw: string
    n_imports: int

def load_new() -> LoadState:
    ls = LoadState(
        p=parser_new(lex_state_new("")),
        root=-1,
        files=vec_new(),
        stack=vec_new(),
        err=0,
        errmsg="",
        err_stage="",
        err_line=0,
        err_col=0,
        err_file="",
        err_raw="",
        n_imports=0,
    )
    ls.p = new_node(ls.p, N_BLOCK(), "program", 0)
    ls.root = ls.p.res_node
    ls.p.root = ls.root
    return ls

def load_err(ls: LoadState, msg: string) -> LoadState:
    if ls.err == 0:
        ls.err = 1
        ls.errmsg = msg
        ls.err_stage = "io"
        ls.err_line = 0
        ls.err_col = 0
        ls.err_file = ""
        ls.err_raw = msg
    return ls

def load_err_at(ls: LoadState, stage: string, file: string, line: int, col: int, raw: string, msg: string) -> LoadState:
    if ls.err == 0:
        ls.err = 1
        ls.errmsg = msg
        ls.err_stage = stage
        ls.err_line = line
        ls.err_col = col
        ls.err_file = file
        ls.err_raw = raw
    return ls

def path_in(v: Vec, path: string) -> int:
    i = 0
    while i < v.len:
        if as_string(vec_get(v, i)) == path:
            return 1
        i = i + 1
    return 0

def dir_of(path: string) -> string:
    i = len(path) - 1
    while i >= 0:
        c = str_get(path, i)
        if c == 47 or c == 92:
            return str_slice(path, 0, i)
        i = i - 1
    return ""

def is_sep(c: int) -> bool:
    return c == 47 or c == 92

# normalize `.\/` and `..` segments so include-once/cycle keys are stable
# for paths that arrive as `..\/x` or `.\/x`
def normalize_path(p: string) -> string:
    lead = ""
    if len(p) > 0 and is_sep(str_get(p, 0)):
        lead = "/"
    parts = vec_new()
    n = len(p)
    i = 0
    seg = ""
    while i <= n:
        c = 47
        if i < n:
            c = str_get(p, i)
        if i == n or is_sep(c):
            if seg == "" or seg == ".":
                pass
            elif seg == "..":
                if parts.len > 0 and as_string(vec_get(parts, parts.len - 1)) != "..":
                    parts = vec_pop(parts)
                else:
                    parts = vec_push(parts, as_ptr(seg))
            else:
                parts = vec_push(parts, as_ptr(seg))
            seg = ""
        else:
            seg = seg + str_slice(p, i, 1)
        i = i + 1
    out = lead
    k = 0
    while k < parts.len:
        if k > 0:
            out = out + "/"
        out = out + as_string(vec_get(parts, k))
        k = k + 1
    if out == "":
        return "."
    return out

def join_path(dir: string, rel: string) -> string:
    if dir == "":
        return normalize_path(rel)
    return normalize_path(dir + "/" + rel)

def lex_error_msg(st: LexState) -> string:
    n = st.kinds.len
    if n == 0:
        return "lexical error"
    if tk_kind(st, n - 1) == TK_ERROR():
        return tk_sval(st, n - 1)
    return "lexical error"

def resolve_import(importer: string, spec: string) -> string:
    if spec == "stdlib" or spec_prefix(spec, "stdlib/") == 1:
        # stdlib paths are cwd- or env-rooted, never importer-relative
        return normalize_path(resolve_specifier(spec))
    return join_path(dir_of(importer), spec)

def load_file(ls: LoadState, path: string) -> LoadState:
    if ls.err == 1:
        return ls
    if path_in(ls.stack, path) == 1:
        return load_err_at(ls, "io", path, 0, 0, "circular import involving '" + path + "'", "circular import involving '" + path + "'")
    if path_in(ls.files, path) == 1:
        return ls
    ls.files = vec_push(ls.files, as_ptr(path))
    ls.stack = vec_push(ls.stack, as_ptr(path))
    ls.n_imports = ls.n_imports + 1
    src = read_file(path)
    if src == "":
        return load_err_at(ls, "io", path, 0, 0, "cannot open '" + path + "'", "cannot open '" + path + "'")
    lx = lex_all(lex_state_new(src))
    if lx.error == 1:
        return load_err_at(ls, "lex", path, lx.err_line, lx.err_col, lex_error_msg(lx), path + ": " + lex_error_msg(lx))
    ls.p.st = lx
    ls.p.idx = 0
    ls.p.err = 0
    ls.p = parse_program(ls.p)
    if ls.p.err == 1:
        return load_err_at(ls, "parse", path, ls.p.err_line, ls.p.err_col, ls.p.errmsg, path + ": " + ls.p.errmsg)
    file_root = ls.p.root
    ch = node_child(ls.p, file_root)
    while ch != -1 and ls.err == 0:
        nxt = node_next(ls.p, ch)
        if node_tag(ls.p, ch) == N_IMPORT():
            imp = node_child(ls.p, ch)
            if imp == -1:
                return load_err(ls, path + ": malformed import")
            rel = node_sval(ls.p, imp)
            ls = load_file(ls, resolve_import(path, rel))
        else:
            # detach from the per-file chain before splicing into the
            # global program root (append_child does not reset `next`)
            vec_set(ls.p.n_next, ch, -1)
            ls.p = append_child(ls.p, ls.root, ch)
        ch = nxt
    ls.stack = vec_pop(ls.stack)
    return ls

def load_program(path: string) -> LoadState:
    ls = load_new()
    ls = load_file(ls, path)
    ls.p.root = ls.root
    return ls
