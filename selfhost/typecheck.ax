# Aoxn type checker, written in Aoxn (self-hosting stage 3).
#
# Checks the arena AST from parser.ax against the strict Aoxn rules:
# no implicit conversions, bool conditions, all-paths-return, no unreachable
# code, exact struct literals, unchecked index typing, builtin signatures.
#
# Types live in a recursive arena (t_tag / t_elem / t_len / t_sname);
# the scope, struct table and function signatures are flat parallel Vecs.
# Multi-value results travel through c.res_ok + c.r_ty (write-back style).
#
# WIP limits (stage 3): generic declarations/calls are reported as
# unsupported; monomorphization lands in the next milestone.

import * from "../stdlib/stdlib.ax"
import * from "./lexer.ax"
import * from "./parser.ax"
# ---- type tags ----
def TY_INT() -> int:
    return 1

def TY_FLOAT() -> int:
    return 2

def TY_BOOL() -> int:
    return 3

def TY_STR() -> int:
    return 4

def TY_VOID() -> int:
    return 5

def TY_ARRAY() -> int:
    return 6

def TY_STRUCT() -> int:
    return 7

# a generic type parameter (name in t_sname); only inside generic signatures
def TY_VAR() -> int:
    return 8

# v0.40.0: None, T | None, dict[V], fn(...) -> T
def TY_NONE() -> int:
    return 9

def TY_OPT() -> int:
    return 10

def TY_DICT() -> int:
    return 11

def TY_FN() -> int:
    return 12

# ---- checker state ----

struct CState:
    p: PState
    err: int
    errmsg: string
    err_stage: string
    err_line: int
    err_col: int
    err_raw: string
    cur_line: int
    cur_col: int
    loop_depth: int
    cur_ret: int
    res_ok: int
    r_ty: int
    r_node: int
    # type arena
    t_tag: Vec
    t_elem: Vec
    t_len: Vec
    t_sname: Vec
    # function types: return type, parameter-list start into tf_ty, arity
    t_fret: Vec
    t_fstart: Vec
    t_fn: Vec
    tf_ty: Vec
    t_int: int
    t_float: int
    t_bool: int
    t_str: int
    t_void: int
    t_none: int
    # flat function scope: name -> type index
    sc_name: Vec
    sc_ty: Vec
    # struct fields
    sf_struct: Vec
    sf_name: Vec
    sf_ty: Vec
    # function signatures
    fn_name: Vec
    fn_nparam: Vec
    fn_ret: Vec
    fp_fn: Vec
    fp_name: Vec
    fp_ty: Vec
    # generic declarations: signatures use TY_VAR for type params and
    # length -1 for the length parameter N
    g_name: Vec
    g_node: Vec
    g_nparam: Vec
    g_ret: Vec
    g_lenname: Vec
    g_fn: Vec
    g_pname: Vec
    g_pty: Vec
    g_tp: Vec
    g_tpname: Vec
    # type params of the generic whose signature is being resolved
    cur_tps: Vec
    # unification scratch: type param -> concrete type, N -> int
    sub_names: Vec
    sub_tys: Vec
    sub_len_set: int
    sub_len_val: int
    # monomorphized instances
    inst_names: Vec
    inst_fni: Vec
    inst_node: Vec
    q_node: Vec
    call_node: Vec
    call_fni: Vec
    # exceptions and nullable narrowing (v0.40.0)
    try_depth: int
    nar_name: Vec
    nar_ty: Vec
    n_name: string
    n_then: int
    n_else: int
    n_ok: int
    # every file the loader included (for the CLI build cache)
    files: Vec
    # W001 bookkeeping: declarations/reads of the function being checked,
    # and the program-wide warning list the CLI reports
    wd_name: Vec
    wd_line: Vec
    wd_col: Vec
    wr_name: Vec
    wn_name: Vec
    wn_line: Vec
    wn_col: Vec

def alloc_ty(c: CState, tag: int, elem: int, ln: int, sname: string) -> CState:
    c.t_tag = vec_push(c.t_tag, tag)
    c.t_elem = vec_push(c.t_elem, elem)
    c.t_len = vec_push(c.t_len, ln)
    c.t_sname = vec_push(c.t_sname, as_ptr(sname))
    c.t_fret = vec_push(c.t_fret, -1)
    c.t_fstart = vec_push(c.t_fstart, -1)
    c.t_fn = vec_push(c.t_fn, 0)
    c.r_ty = c.t_tag.len - 1
    c.res_ok = 1
    return c

# function type: params is a Vec of type-arena indices
def alloc_fn_ty(c: CState, ret: int, params: Vec) -> CState:
    c = alloc_ty(c, TY_FN(), 0, 0, "")
    idx = c.r_ty
    start = c.tf_ty.len
    i = 0
    while i < params.len:
        c.tf_ty = vec_push(c.tf_ty, vec_get(params, i))
        i = i + 1
    vec_set(c.t_fret, idx, ret)
    vec_set(c.t_fstart, idx, start)
    vec_set(c.t_fn, idx, params.len)
    c.r_ty = idx
    c.res_ok = 1
    return c

def checker_state() -> CState:
    c = CState(
        p=parser_new(lex_state_new("")),
        err=0,
        errmsg="",
        err_stage="",
        err_line=0,
        err_col=0,
        err_raw="",
        cur_line=0,
        cur_col=0,
        loop_depth=0,
        cur_ret=-1,
        res_ok=1,
        r_ty=-1,
        r_node=-1,
        t_tag=vec_new(),
        t_elem=vec_new(),
        t_len=vec_new(),
        t_sname=vec_new(),
        t_fret=vec_new(),
        t_fstart=vec_new(),
        t_fn=vec_new(),
        tf_ty=vec_new(),
        t_int=0,
        t_float=0,
        t_bool=0,
        t_str=0,
        t_void=0,
        t_none=0,
        sc_name=vec_new(),
        sc_ty=vec_new(),
        sf_struct=vec_new(),
        sf_name=vec_new(),
        sf_ty=vec_new(),
        fn_name=vec_new(),
        fn_nparam=vec_new(),
        fn_ret=vec_new(),
        fp_fn=vec_new(),
        fp_name=vec_new(),
        fp_ty=vec_new(),
        g_name=vec_new(),
        g_node=vec_new(),
        g_nparam=vec_new(),
        g_ret=vec_new(),
        g_lenname=vec_new(),
        g_fn=vec_new(),
        g_pname=vec_new(),
        g_pty=vec_new(),
        g_tp=vec_new(),
        g_tpname=vec_new(),
        cur_tps=vec_new(),
        sub_names=vec_new(),
        sub_tys=vec_new(),
        sub_len_set=0,
        sub_len_val=0,
        inst_names=vec_new(),
        inst_fni=vec_new(),
        inst_node=vec_new(),
        q_node=vec_new(),
        call_node=vec_new(),
        call_fni=vec_new(),
        try_depth=0,
        nar_name=vec_new(),
        nar_ty=vec_new(),
        n_name="",
        n_then=-1,
        n_else=-1,
        n_ok=0,
        files=vec_new(),
        wd_name=vec_new(),
        wd_line=vec_new(),
        wd_col=vec_new(),
        wr_name=vec_new(),
        wn_name=vec_new(),
        wn_line=vec_new(),
        wn_col=vec_new(),
    )
    c = alloc_ty(c, TY_INT(), 0, 0, "")
    c.t_int = c.r_ty
    c = alloc_ty(c, TY_FLOAT(), 0, 0, "")
    c.t_float = c.r_ty
    c = alloc_ty(c, TY_BOOL(), 0, 0, "")
    c.t_bool = c.r_ty
    c = alloc_ty(c, TY_STR(), 0, 0, "")
    c.t_str = c.r_ty
    c = alloc_ty(c, TY_VOID(), 0, 0, "")
    c.t_void = c.r_ty
    c = alloc_ty(c, TY_NONE(), 0, 0, "")
    c.t_none = c.r_ty
    return c

# checker over an already-parsed (possibly multi-file) parser state
def checker_new(st0: LexState) -> CState:
    st = lex_all(st0)
    c = checker_state()
    c.p = parser_new(st)
    return c

def cerr(c: CState, msg: string) -> CState:
    if c.err == 0:
        c.err = 1
        c.errmsg = msg
        c.err_stage = "type"
        c.err_line = c.cur_line
        c.err_col = c.cur_col
        c.err_raw = msg
    return c

def ty_tag(c: CState, ty: int) -> int:
    return vec_get(c.t_tag, ty)

def ty_elem(c: CState, ty: int) -> int:
    return vec_get(c.t_elem, ty)

def ty_len(c: CState, ty: int) -> int:
    return vec_get(c.t_len, ty)

def ty_sname(c: CState, ty: int) -> string:
    return as_string(vec_get(c.t_sname, ty))

def ty_eq(c: CState, a: int, b: int) -> int:
    if a == b:
        return 1
    if ty_tag(c, a) != ty_tag(c, b):
        return 0
    t = ty_tag(c, a)
    if t == TY_ARRAY():
        if ty_len(c, a) != ty_len(c, b):
            return 0
        return ty_eq(c, ty_elem(c, a), ty_elem(c, b))
    if t == TY_OPT() or t == TY_DICT():
        return ty_eq(c, ty_elem(c, a), ty_elem(c, b))
    if t == TY_FN():
        if vec_get(c.t_fn, a) != vec_get(c.t_fn, b):
            return 0
        if ty_eq(c, vec_get(c.t_fret, a), vec_get(c.t_fret, b)) == 0:
            return 0
        i = 0
        sa = vec_get(c.t_fstart, a)
        sb = vec_get(c.t_fstart, b)
        while i < vec_get(c.t_fn, a):
            if ty_eq(c, vec_get(c.tf_ty, sa + i), vec_get(c.tf_ty, sb + i)) == 0:
                return 0
            i = i + 1
        return 1
    if t == TY_STRUCT():
        if ty_sname(c, a) == ty_sname(c, b):
            return 1
        return 0
    if t == TY_VAR():
        if ty_sname(c, a) == ty_sname(c, b):
            return 1
        return 0
    return 1

def ty_fn_ret(c: CState, ty: int) -> int:
    return vec_get(c.t_fret, ty)

def ty_fn_n(c: CState, ty: int) -> int:
    return vec_get(c.t_fn, ty)

def ty_fn_param(c: CState, ty: int, k: int) -> int:
    return vec_get(c.tf_ty, vec_get(c.t_fstart, ty) + k)

def ty_display(c: CState, ty: int) -> string:
    t = ty_tag(c, ty)
    if t == TY_INT():
        return "int"
    if t == TY_FLOAT():
        return "float"
    if t == TY_BOOL():
        return "bool"
    if t == TY_STR():
        return "string"
    if t == TY_VOID():
        return "void"
    if t == TY_NONE():
        return "None"
    if t == TY_OPT():
        return ty_display(c, ty_elem(c, ty)) + " | None"
    if t == TY_DICT():
        return "dict[" + ty_display(c, ty_elem(c, ty)) + "]"
    if t == TY_FN():
        s = "fn("
        i = 0
        while i < ty_fn_n(c, ty):
            if i > 0:
                s = s + ", "
            s = s + ty_display(c, ty_fn_param(c, ty, i))
            i = i + 1
        return s + ") -> " + ty_display(c, ty_fn_ret(c, ty))
    if t == TY_ARRAY():
        return "[" + ty_display(c, ty_elem(c, ty)) + "; " + str(ty_len(c, ty)) + "]"
    return ty_sname(c, ty)

# v0.40.0 widening: T -> T | None and None -> T | None; nothing else
def assignable(c: CState, declared: int, actual: int) -> int:
    if ty_eq(c, declared, actual) == 1:
        return 1
    if ty_tag(c, declared) == TY_OPT():
        if ty_tag(c, actual) == TY_NONE():
            return 1
        return ty_eq(c, ty_elem(c, declared), actual)
    return 0

def is_printable(c: CState, ty: int) -> int:
    t = ty_tag(c, ty)
    if t == TY_INT() or t == TY_FLOAT() or t == TY_BOOL() or t == TY_STR():
        return 1
    return 0

def is_compound(c: CState, ty: int) -> int:
    t = ty_tag(c, ty)
    if t == TY_ARRAY() or t == TY_STRUCT():
        return 1
    return 0

# ---- scope ----

def scope_push(c: CState, name: string, ty: int) -> CState:
    c.sc_name = vec_push(c.sc_name, as_ptr(name))
    c.sc_ty = vec_push(c.sc_ty, ty)
    return c

def scope_lookup(c: CState, name: string) -> CState:
    c.res_ok = 0
    c.r_ty = -1
    i = c.sc_name.len - 1
    while i >= 0:
        if as_string(vec_get(c.sc_name, i)) == name:
            c.res_ok = 1
            c.r_ty = vec_get(c.sc_ty, i)
            return c
        i = i - 1
    return c

# overwrite the latest binding of `name` (used by branch-local narrowing)
def scope_set(c: CState, name: string, ty: int) -> CState:
    i = c.sc_name.len - 1
    while i >= 0:
        if as_string(vec_get(c.sc_name, i)) == name:
            vec_set(c.sc_ty, i, ty)
            return c
        i = i - 1
    return c

# ---- nullable narrowing bookkeeping (declared slot type) ----
def nar_find(c: CState, name: string) -> int:
    i = c.nar_name.len - 1
    while i >= 0:
        if as_string(vec_get(c.nar_name, i)) == name:
            return i
        i = i - 1
    return -1

def nar_get(c: CState, name: string) -> CState:
    c.res_ok = 0
    c.r_ty = -1
    i = nar_find(c, name)
    if i != -1:
        c.res_ok = 1
        c.r_ty = vec_get(c.nar_ty, i)
    return c

def nar_set(c: CState, name: string, ty: int) -> CState:
    i = nar_find(c, name)
    if i != -1:
        vec_set(c.nar_ty, i, ty)
        return c
    c.nar_name = vec_push(c.nar_name, as_ptr(name))
    c.nar_ty = vec_push(c.nar_ty, ty)
    return c

def warn_find(v: Vec, name: string) -> int:
    i = 0
    while i < v.len:
        if as_string(vec_get(v, i)) == name:
            return 1
        i = i + 1
    return 0

def warn_decl(c: CState, name: string, line: int, col: int) -> CState:
    c.wd_name = vec_push(c.wd_name, as_ptr(name))
    c.wd_line = vec_push(c.wd_line, line)
    c.wd_col = vec_push(c.wd_col, col)
    return c

def warn_read(c: CState, name: string) -> CState:
    if warn_find(c.wr_name, name) == 0:
        c.wr_name = vec_push(c.wr_name, as_ptr(name))
    return c

def warn_flush(c: CState) -> CState:
    i = 0
    while i < c.wd_name.len:
        nm = as_string(vec_get(c.wd_name, i))
        if warn_find(c.wr_name, nm) == 0:
            c.wn_name = vec_push(c.wn_name, vec_get(c.wd_name, i))
            c.wn_line = vec_push(c.wn_line, vec_get(c.wd_line, i))
            c.wn_col = vec_push(c.wn_col, vec_get(c.wd_col, i))
        i = i + 1
    c.wd_name = vec_new()
    c.wd_line = vec_new()
    c.wd_col = vec_new()
    c.wr_name = vec_new()
    return c

def nar_remove(c: CState, name: string) -> CState:
    ns = vec_new()
    ts = vec_new()
    i = 0
    while i < c.nar_name.len:
        if as_string(vec_get(c.nar_name, i)) != name:
            ns = vec_push(ns, vec_get(c.nar_name, i))
            ts = vec_push(ts, vec_get(c.nar_ty, i))
        i = i + 1
    c.nar_name = ns
    c.nar_ty = ts
    return c

# ---- struct table ----

def struct_known(c: CState, name: string) -> int:
    i = 0
    while i < c.sf_struct.len:
        if as_string(vec_get(c.sf_struct, i)) == name:
            return 1
        i = i + 1
    return 0

def field_lookup(c: CState, sname: string, fname: string) -> CState:
    c.res_ok = 0
    c.r_ty = -1
    i = 0
    while i < c.sf_struct.len:
        if as_string(vec_get(c.sf_struct, i)) == sname and as_string(vec_get(c.sf_name, i)) == fname:
            c.res_ok = 1
            c.r_ty = vec_get(c.sf_ty, i)
            return c
        i = i + 1
    return c

def struct_field_count(c: CState, sname: string) -> int:
    n = 0
    i = 0
    while i < c.sf_struct.len:
        if as_string(vec_get(c.sf_struct, i)) == sname and as_string(vec_get(c.sf_name, i)) != "":
            n = n + 1
        i = i + 1
    return n

# ---- signature helpers ----

def sig_index(c: CState, name: string) -> int:
    i = 0
    while i < c.fn_name.len:
        if as_string(vec_get(c.fn_name, i)) == name:
            return i
        i = i + 1
    return -1

def sig_param_ty(c: CState, fni: int, k: int) -> int:
    seen = 0
    i = 0
    while i < c.fp_fn.len:
        if vec_get(c.fp_fn, i) == fni:
            if seen == k:
                return vec_get(c.fp_ty, i)
            seen = seen + 1
        i = i + 1
    return -1

# ---- type node resolution ----

def resolve_ty_node(c: CState, ty: int) -> CState:
    c.res_ok = 0
    c.r_ty = -1
    if ty == -1:
        return cerr(c, "missing type")
    t = node_tag(c.p, ty)
    if t == N_TYINT():
        c.r_ty = c.t_int
    elif t == N_TYFLOAT():
        c.r_ty = c.t_float
    elif t == N_TYBOOL():
        c.r_ty = c.t_bool
    elif t == N_TYSTRING():
        c.r_ty = c.t_str
    elif t == N_TYVOID():
        c.r_ty = c.t_void
    elif t == N_TYNONE():
        c.r_ty = c.t_none
    elif t == N_TYOPT():
        c = resolve_ty_node(c, node_child(c.p, ty))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) == TY_VOID():
            return cerr(c, "void cannot be nullable")
        inner = c.r_ty
        c = alloc_ty(c, TY_OPT(), inner, 0, "")
    elif t == N_TYDICT():
        c = resolve_ty_node(c, node_child(c.p, ty))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) == TY_VOID():
            return cerr(c, "void cannot be a dict value type")
        inner = c.r_ty
        c = alloc_ty(c, TY_DICT(), inner, 0, "")
    elif t == N_TYFN():
        nparams = node_ival(c.p, ty)
        params = vec_new()
        kid = node_child(c.p, ty)
        k = 0
        ret = -1
        while kid != -1:
            c = resolve_ty_node(c, kid)
            if c.err == 1:
                return c
            if k < nparams:
                params = vec_push(params, c.r_ty)
            else:
                ret = c.r_ty
            k = k + 1
            kid = node_next(c.p, kid)
        if ret == -1:
            return cerr(c, "malformed function type")
        c = alloc_fn_ty(c, ret, params)
    elif t == N_TYARRAY():
        ln = node_ival(c.p, ty)
        if ln == -1 and c.cur_tps.len == 0:
            return cerr(c, "array length parameters are only valid inside generic functions")
        c = resolve_ty_node(c, node_child(c.p, ty))
        if c.err == 1:
            return c
        elem = c.r_ty
        c = alloc_ty(c, TY_ARRAY(), elem, ln, "")
    elif t == N_TYSTRUCT():
        name = node_sval(c.p, ty)
        i = 0
        is_tp = 0
        while i < c.cur_tps.len:
            if as_string(vec_get(c.cur_tps, i)) == name:
                is_tp = 1
            i = i + 1
        if is_tp == 1:
            c = alloc_ty(c, TY_VAR(), 0, 0, name)
        elif struct_known(c, name) == 1:
            c = alloc_ty(c, TY_STRUCT(), 0, 0, name)
        else:
            return cerr(c, "unknown type '" + name + "'")
    else:
        return cerr(c, "malformed type annotation")
    c.res_ok = 1
    return c

# ---- struct collection ----

# does a struct (transitively) contain itself? path = grey nodes on the
# current DFS path (immutable path semantics: each recursion gets an
# extended copy, so sibling branches never see each other's markers)
#
# The path comes BACK with the answer, and that is the whole point. A Vec is
# a handle onto a heap buffer: pushing onto it can realloc, and realloc
# frees the buffer every other copy of the handle still points at.
# `struct_cycle` pushes and then recurses, so the callee may realloc the
# very buffer the caller still holds; when it returns, the caller's `path`
# dangles and the next sibling branch walks freed memory.
#
# So the callee hands back `vec_pop` of its own copy: the caller's ancestor
# chain, restored, but pointing at the LIVE buffer. Returning the extended
# path instead would be wrong in the other direction — the DFS path must be
# the ancestor chain, not every node ever visited, or a node reached twice
# through different branches reads as a cycle.
struct Cycle:
    hit: int
    path: Vec

def struct_cycle(c: CState, name: string, path: Vec) -> Cycle:
    i = 0
    while i < path.len:
        if as_string(vec_get(path, i)) == name:
            return Cycle(hit=1, path=path)
        i = i + 1
    mine = vec_push(path, as_ptr(name))
    i = 0
    while i < c.sf_struct.len:
        if as_string(vec_get(c.sf_struct, i)) == name and as_string(vec_get(c.sf_name, i)) != "":
            fty = vec_get(c.sf_ty, i)
            if ty_tag(c, fty) == TY_STRUCT():
                r = struct_cycle(c, ty_sname(c, fty), mine)
                # adopt the callee's handle: it may have realloc'd ours
                mine = r.path
                if r.hit == 1:
                    return Cycle(hit=1, path=vec_pop(mine))
        i = i + 1
    return Cycle(hit=0, path=vec_pop(mine))

def collect_structs(c: CState) -> CState:
    root = c.p.root
    cyc = Cycle(hit=0, path=vec_new())
    # pass 1: reserve names
    ch = node_child(c.p, root)
    while ch != -1 and c.err == 0:
        if node_tag(c.p, ch) == N_STRUCT():
            sname = node_sval(c.p, ch)
            if struct_known(c, sname) == 1:
                return cerr(c, "struct '" + sname + "' is defined more than once")
            c.sf_struct = vec_push(c.sf_struct, as_ptr(sname))
            c.sf_name = vec_push(c.sf_name, as_ptr(""))
            c.sf_ty = vec_push(c.sf_ty, 0)
        ch = node_next(c.p, ch)
    if c.err == 1:
        return c
    # pass 2: fields
    ch = node_child(c.p, root)
    while ch != -1 and c.err == 0:
        if node_tag(c.p, ch) == N_STRUCT():
            sname = node_sval(c.p, ch)
            fld = node_child(c.p, ch)
            while fld != -1 and c.err == 0:
                fname = node_sval(c.p, fld)
                c2 = field_lookup(c, sname, fname)
                if c2.res_ok == 1:
                    return cerr(c2, "duplicate field '" + fname + "' in struct '" + sname + "'")
                c = c2
                c = resolve_ty_node(c, node_child(c.p, fld))
                if c.err == 1:
                    return c
                if ty_tag(c, c.r_ty) == TY_VOID():
                    return cerr(c, "field '" + fname + "' cannot have type void")
                c.sf_struct = vec_push(c.sf_struct, as_ptr(sname))
                c.sf_name = vec_push(c.sf_name, as_ptr(fname))
                c.sf_ty = vec_push(c.sf_ty, c.r_ty)
                fld = node_next(c.p, fld)
        ch = node_next(c.p, ch)
    if c.err == 1:
        return c
    # cycle check
    i = 0
    while i < c.sf_struct.len:
        sname = as_string(vec_get(c.sf_struct, i))
        cyc = struct_cycle(c, sname, vec_new())
        if cyc.hit == 1:
            return cerr(c, "recursive struct '" + sname + "' (a struct cannot contain itself, directly or indirectly)")
        i = i + 1
    return c

# ---- signature collection ----

def gen_index(c: CState, name: string) -> int:
    i = 0
    while i < c.g_name.len:
        if as_string(vec_get(c.g_name, i)) == name:
            return i
        i = i + 1
    return -1

def is_generic_fn(c: CState, node: int) -> int:
    kid = node_child(c.p, node)
    while kid != -1:
        if node_tag(c.p, kid) == N_TYPEPARAMS():
            return 1
        kid = node_next(c.p, kid)
    return 0

def first_tp_node(c: CState, node: int) -> int:
    kid = node_child(c.p, node)
    while kid != -1:
        if node_tag(c.p, kid) == N_TYPEPARAMS():
            return kid
        kid = node_next(c.p, kid)
    return -1

# name of the length parameter: the sval of the first [T; N] type node
def len_name_in_ty(c: CState, ty: int) -> string:
    if ty == -1:
        return ""
    if node_tag(c.p, ty) == N_TYARRAY():
        if node_ival(c.p, ty) == -1:
            return node_sval(c.p, ty)
        return len_name_in_ty(c, node_child(c.p, ty))
    return ""

def find_len_name(c: CState, node: int) -> string:
    kid = node_child(c.p, node)
    while kid != -1:
        t = node_tag(c.p, kid)
        if t == N_BLOCK():
            break
        if t == N_PARAM():
            r = len_name_in_ty(c, node_child(c.p, kid))
        elif t == N_TYPEPARAMS():
            r = ""
        else:
            r = len_name_in_ty(c, kid)
        if r != "":
            return r
        kid = node_next(c.p, kid)
    return ""

# return type node: the last child for externs, the child before the body
def ret_node_of(c: CState, node: int) -> int:
    last = -1
    kid = node_child(c.p, node)
    while kid != -1:
        last = kid
        kid = node_next(c.p, kid)
    if last == -1:
        return -1
    if node_tag(c.p, last) != N_BLOCK():
        return last
    ret = -1
    kid = node_child(c.p, node)
    while kid != -1:
        if node_next(c.p, kid) == last:
            ret = kid
        kid = node_next(c.p, kid)
    return ret

def collect_sigs(c: CState) -> CState:
    root = c.p.root
    ch = node_child(c.p, root)
    while ch != -1 and c.err == 0:
        t = node_tag(c.p, ch)
        if t == N_FN() or t == N_EXTERN():
            c = collect_one_sig(c, ch)
        ch = node_next(c.p, ch)
    return c

def collect_one_sig(c: CState, ch: int) -> CState:
    name = node_sval(c.p, ch)
    c.cur_line = vec_get(c.p.n_line, ch)
    c.cur_col = vec_get(c.p.n_col, ch)
    is_extern = node_ival(c.p, ch)
    is_generic = is_generic_fn(c, ch)
    if is_generic == 1:
        if is_extern == 1:
            return cerr(c, "extern functions cannot be generic")
        if name == "main":
            return cerr(c, "'main' cannot be generic")
    elif is_extern == 1 and name == "main":
        return cerr(c, "'main' cannot be declared extern")
    if sig_index(c, name) != -1 or gen_index(c, name) != -1:
        return cerr(c, "function '" + name + "' is defined more than once")
    if struct_known(c, name) == 1:
        return cerr(c, "'" + name + "' is already defined as a struct")

    c.cur_tps = vec_new()
    if is_generic == 1:
        tpn = first_tp_node(c, ch)
        tp = node_child(c.p, tpn)
        while tp != -1:
            c.cur_tps = vec_push(c.cur_tps, as_ptr(node_sval(c.p, tp)))
            tp = node_next(c.p, tp)

    if is_generic == 1:
        gi = c.g_name.len
        c.g_name = vec_push(c.g_name, as_ptr(name))
        c.g_node = vec_push(c.g_node, ch)
        c.g_nparam = vec_push(c.g_nparam, 0)
        c.g_ret = vec_push(c.g_ret, c.t_void)
        c.g_lenname = vec_push(c.g_lenname, as_ptr(find_len_name(c, ch)))
        k = 0
        while k < c.cur_tps.len:
            c.g_tp = vec_push(c.g_tp, gi)
            c.g_tpname = vec_push(c.g_tpname, vec_get(c.cur_tps, k))
            k = k + 1
        pnames = vec_new()
        np = 0
        kid = node_child(c.p, ch)
        while kid != -1 and c.err == 0:
            if node_tag(c.p, kid) == N_PARAM():
                pname = node_sval(c.p, kid)
                j = 0
                while j < pnames.len:
                    if as_string(vec_get(pnames, j)) == pname:
                        c.cur_tps = vec_new()
                        return cerr(c, "duplicate parameter '" + pname + "' in function '" + name + "'")
                    j = j + 1
                pnames = vec_push(pnames, as_ptr(pname))
                c = resolve_ty_node(c, node_child(c.p, kid))
                if c.err == 1:
                    c.cur_tps = vec_new()
                    return c
                if ty_tag(c, c.r_ty) == TY_VOID():
                    c.cur_tps = vec_new()
                    return cerr(c, "parameter '" + pname + "' cannot have type void")
                c.g_fn = vec_push(c.g_fn, gi)
                c.g_pname = vec_push(c.g_pname, as_ptr(pname))
                c.g_pty = vec_push(c.g_pty, c.r_ty)
                np = np + 1
            kid = node_next(c.p, kid)
        vec_set(c.g_nparam, gi, np)
        ret_type = ret_node_of(c, ch)
        if ret_type == -1:
            c.cur_tps = vec_new()
            return cerr(c, "malformed function '" + name + "'")
        c = resolve_ty_node(c, ret_type)
        if c.err == 1:
            c.cur_tps = vec_new()
            return c
        vec_set(c.g_ret, gi, c.r_ty)
        c.cur_tps = vec_new()
        return c

    fni = c.fn_name.len
    c.fn_name = vec_push(c.fn_name, as_ptr(name))
    c.fn_nparam = vec_push(c.fn_nparam, 0)
    c.fn_ret = vec_push(c.fn_ret, c.t_void)
    pnames = vec_new()
    np = 0
    kid = node_child(c.p, ch)
    while kid != -1 and c.err == 0:
        if node_tag(c.p, kid) == N_PARAM():
            pname = node_sval(c.p, kid)
            j = 0
            while j < pnames.len:
                if as_string(vec_get(pnames, j)) == pname:
                    return cerr(c, "duplicate parameter '" + pname + "' in function '" + name + "'")
                j = j + 1
            pnames = vec_push(pnames, as_ptr(pname))
            c = resolve_ty_node(c, node_child(c.p, kid))
            if c.err == 1:
                return c
            if ty_tag(c, c.r_ty) == TY_VOID():
                return cerr(c, "parameter '" + pname + "' cannot have type void")
            c.fp_fn = vec_push(c.fp_fn, fni)
            c.fp_name = vec_push(c.fp_name, as_ptr(pname))
            c.fp_ty = vec_push(c.fp_ty, c.r_ty)
            np = np + 1
        kid = node_next(c.p, kid)
    vec_set(c.fn_nparam, fni, np)
    ret_type = ret_node_of(c, ch)
    if ret_type == -1:
        return cerr(c, "malformed function '" + name + "'")
    c = resolve_ty_node(c, ret_type)
    if c.err == 1:
        return c
    vec_set(c.fn_ret, fni, c.r_ty)
    if name == "main":
        if np != 0:
            return cerr(c, "'main' cannot take parameters; read the command line with argc() / arg(i)")
        if ty_tag(c, c.r_ty) != TY_INT() and ty_tag(c, c.r_ty) != TY_VOID():
            return cerr(c, "'main' must return int (the exit code) or void, found " + ty_display(c, c.r_ty))
    return c

# ---- all-paths-return analysis ----

def block_returns_all(c: CState, block: int, try_depth: int) -> int:
    st = node_child(c.p, block)
    while st != -1:
        if stmt_guarantees_return(c, st, try_depth) == 1:
            return 1
        st = node_next(c.p, st)
    return 0

def stmt_guarantees_return(c: CState, stmt: int, try_depth: int) -> int:
    t = node_tag(c.p, stmt)
    if t == N_RETURN():
        return 1
    if t == N_RAISE():
        # inside a try body a raise lands in that try's handler
        if try_depth == 0:
            return 1
        return 0
    if t == N_TRY():
        handler = node_child(c.p, stmt)
        handler = node_next(c.p, handler)
        return block_returns_all(c, handler, 0)
    if t == N_IF():
        then_b = node_child(c.p, stmt)
        then_b = node_next(c.p, then_b)
        c2 = c
        else_b = node_next(c.p, then_b)
        if block_returns_all(c2, then_b, 0) == 0:
            return 0
        if else_b == -1:
            return 0
        return block_returns_all(c2, else_b, 0)
    return 0

# ---- statements ----

def check_block(c: CState, block: int) -> CState:
    st = node_child(c.p, block)
    terminated = 0
    while st != -1 and c.err == 0:
        if terminated == 1:
            return cerr(c, "unreachable statement after 'return'")
        c = check_stmt(c, st)
        if stmt_guarantees_return(c, st, c.try_depth) == 1:
            terminated = 1
        st = node_next(c.p, st)
    return c

def check_stmt(c: CState, stmt: int) -> CState:
    t = node_tag(c.p, stmt)
    if vec_get(c.p.n_line, stmt) > 0:
        c.cur_line = vec_get(c.p.n_line, stmt)
        c.cur_col = vec_get(c.p.n_col, stmt)
    if t == N_LET():
        name = node_sval(c.p, stmt)
        ann = -1
        value = -1
        if node_ival(c.p, stmt) == 1:
            ann = node_child(c.p, stmt)
            value = node_next(c.p, ann)
        else:
            value = node_child(c.p, stmt)
        ann_ty = -1
        if ann != -1:
            c = resolve_ty_node(c, ann)
            if c.err == 1:
                return c
            ann_ty = c.r_ty
        empty_dict = 0
        if node_tag(c.p, value) == N_DICTLIT():
            if node_child(c.p, value) == -1:
                empty_dict = 1
        vty = -1
        if empty_dict == 1:
            if ann_ty == -1 or ty_tag(c, ann_ty) != TY_DICT():
                return cerr(c, "an empty dict literal needs an annotation: d: dict[int] = {}")
            vty = ann_ty
        else:
            c = check_expr(c, value)
            if c.err == 1:
                return c
            vty = c.r_ty
        if ty_tag(c, vty) == TY_VOID():
            return cerr(c, "cannot bind a void expression to '" + name + "'")
        c2 = scope_lookup(c, name)
        if c2.res_ok == 1:
            # re-assignment keeps the DECLARED type when a branch narrowed it
            dy = c2.r_ty
            c = c2
            declared = dy
            ng = nar_get(c, name)
            if ng.res_ok == 1:
                declared = ng.r_ty
            if ann_ty != -1:
                if ty_eq(c, ann_ty, declared) == 0:
                    return cerr(c, "cannot re-declare '" + name + "' as " + ty_display(c, ann_ty) + ": it is already " + ty_display(c, declared))
            if assignable(c, declared, vty) == 0:
                return cerr(c, "cannot assign a value of type " + ty_display(c, vty) + " to '" + name + ": " + ty_display(c, declared) + "'")
            ng2 = nar_get(c, name)
            if ng2.res_ok == 1:
                if ty_eq(c, vty, ng2.r_ty) == 1:
                    c = nar_remove(c, name)
                c = scope_set(c, name, vty)
            return c
        # first binding
        if ann_ty != -1:
            if assignable(c, ann_ty, vty) == 0:
                return cerr(c, "cannot initialize '" + name + ": " + ty_display(c, ann_ty) + "' with an expression of type " + ty_display(c, vty))
            c = scope_push(c, name, ann_ty)
            c = warn_decl(c, name, vec_get(c.p.n_line, stmt), vec_get(c.p.n_col, stmt))
            return c
        c = scope_push(c, name, vty)
        c = warn_decl(c, name, vec_get(c.p.n_line, stmt), vec_get(c.p.n_col, stmt))
        return c
    if t == N_ASSIGN():
        target = node_child(c.p, stmt)
        value = node_next(c.p, target)
        dty = -1
        if node_tag(c.p, target) == N_VAR():
            ng = nar_get(c, node_sval(c.p, target))
            c = ng
            if ng.res_ok == 1:
                dty = ng.r_ty
        if dty == -1:
            c = lvalue_ty(c, target)
            if c.err == 1:
                return c
            dty = c.r_ty
        c = check_expr(c, value)
        if c.err == 1:
            return c
        if assignable(c, dty, c.r_ty) == 0:
            return cerr(c, "cannot assign a value of type " + ty_display(c, c.r_ty) + " to a target of type " + ty_display(c, dty))
        if node_tag(c.p, target) == N_VAR():
            vname = node_sval(c.p, target)
            ng2 = nar_get(c, vname)
            if ng2.res_ok == 1:
                assigned = c.r_ty
                if ty_eq(c, assigned, ng2.r_ty) == 1:
                    c = nar_remove(c, vname)
                c = scope_set(c, vname, assigned)
        return c
    if t == N_IF():
        cond = node_child(c.p, stmt)
        then_b = node_next(c.p, cond)
        c = check_expr(c, cond)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_BOOL():
            return cerr(c, "'if' condition must be bool, found " + ty_display(c, c.r_ty))
        else_b = node_next(c.p, then_b)
        c = narrow_target(c, cond)
        n_ok = c.n_ok
        nname = c.n_name
        nthen = c.n_then
        nelse = c.n_else
        if n_ok == 1:
            sv = scope_lookup(c, nname)
            saved = sv.r_ty
            c = sv
            ng = nar_get(c, nname)
            if ng.res_ok == 0:
                c = nar_set(c, nname, saved)
            c = scope_set(c, nname, nthen)
            c = check_block(c, then_b)
            if c.err == 1:
                return c
            c = scope_set(c, nname, saved)
            then_exits = block_returns_all(c, then_b, 0)
            if else_b != -1:
                c = scope_set(c, nname, nelse)
                c = check_block(c, else_b)
                if c.err == 1:
                    return c
                c = scope_set(c, nname, saved)
                else_exits = block_returns_all(c, else_b, 0)
                if then_exits == 1 and else_exits == 0:
                    c = scope_set(c, nname, nelse)
                elif else_exits == 1 and then_exits == 0:
                    c = scope_set(c, nname, nthen)
            else:
                if then_exits == 1:
                    c = scope_set(c, nname, nelse)
            return c
        c = check_block(c, then_b)
        if c.err == 1:
            return c
        if else_b != -1:
            c = check_block(c, else_b)
        return c
    if t == N_WHILE():
        cond = node_child(c.p, stmt)
        body = node_next(c.p, cond)
        c = check_expr(c, cond)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_BOOL():
            return cerr(c, "'while' condition must be bool, found " + ty_display(c, c.r_ty))
        c.loop_depth = c.loop_depth + 1
        c = check_block(c, body)
        c.loop_depth = c.loop_depth - 1
        return c
    if t == N_FOR():
        return check_for(c, stmt)
    if t == N_BREAK():
        if c.loop_depth == 0:
            return cerr(c, "'break' outside of a loop")
        return c
    if t == N_CONTINUE():
        if c.loop_depth == 0:
            return cerr(c, "'continue' outside of a loop")
        return c
    if t == N_RETURN():
        e = node_child(c.p, stmt)
        rty = c.cur_ret
        if e == -1:
            if ty_tag(c, rty) != TY_VOID():
                return cerr(c, "'return' must return a value of type " + ty_display(c, rty))
            return c
        if ty_tag(c, rty) == TY_VOID():
            return cerr(c, "void function cannot return a value")
        c = check_expr(c, e)
        if c.err == 1:
            return c
        if ty_eq(c, c.r_ty, rty) == 0:
            return cerr(c, "'return' type mismatch: expected " + ty_display(c, rty) + ", found " + ty_display(c, c.r_ty))
        return c
    if t == N_RAISE():
        c = check_expr(c, node_child(c.p, stmt))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_STR():
            return cerr(c, "raise requires a string message, found " + ty_display(c, c.r_ty))
        return c
    if t == N_TRY():
        body = node_child(c.p, stmt)
        handler = node_next(c.p, body)
        c.try_depth = c.try_depth + 1
        c = check_block(c, body)
        c.try_depth = c.try_depth - 1
        if c.err == 1:
            return c
        if node_ival(c.p, stmt) == 1:
            c = scope_push(c, node_sval(c.p, stmt), c.t_str)
        c = check_block(c, handler)
        return c
    if t == N_PASS():
        return c
    if t == N_EXPRSTMT():
        c = check_expr(c, node_child(c.p, stmt))
        return c
    return cerr(c, "unknown statement in the arena (tag " + str(t) + ")")

# `x is None` / `x is not None`: which variable narrows and what each branch
# sees. Mirrors narrow_target in the Rust checker.
def narrow_target(c: CState, cond: int) -> CState:
    c.n_ok = 0
    c.n_name = ""
    c.n_then = -1
    c.n_else = -1
    if node_tag(c.p, cond) != N_BINARY():
        return c
    op = node_ival(c.p, cond)
    if op != OP_IS() and op != OP_ISNOT():
        return c
    lhs = node_child(c.p, cond)
    rhs = node_next(c.p, lhs)
    var = -1
    if node_tag(c.p, rhs) == N_NONE():
        var = lhs
    elif node_tag(c.p, lhs) == N_NONE():
        var = rhs
    else:
        return c
    if node_tag(c.p, var) != N_VAR():
        return c
    name = node_sval(c.p, var)
    sv = scope_lookup(c, name)
    if sv.res_ok == 0:
        return c
    ty = sv.r_ty
    if ty_tag(c, ty) != TY_OPT():
        return c
    inner = ty_elem(c, ty)
    c = sv
    c.n_ok = 1
    c.n_name = name
    if op == OP_ISNOT():
        c.n_then = inner
        c.n_else = c.t_none
    else:
        c.n_then = c.t_none
        c.n_else = inner
    return c

def check_for(c: CState, stmt: int) -> CState:
    var = node_sval(c.p, stmt)
    is_range = node_ival(c.p, stmt)
    var_ty = c.t_int
    if is_range == 1:
        a = node_child(c.p, stmt)
        nargs = 0
        while a != -1:
            if node_tag(c.p, a) == N_BLOCK():
                a = -1
            else:
                c = check_expr(c, a)
                if c.err == 1:
                    return c
                if ty_tag(c, c.r_ty) != TY_INT():
                    return cerr(c, "range arguments must be int, found " + ty_display(c, c.r_ty))
                nargs = nargs + 1
                a = node_next(c.p, a)
        if nargs < 1 or nargs > 3:
            return cerr(c, "range expects 1 to 3 arguments, found " + str(nargs))
    else:
        arr = node_child(c.p, stmt)
        c = check_expr(c, arr)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) == TY_DICT():
            # iterating a dict walks its KEYS in insertion order
            var_ty = c.t_str
        elif ty_tag(c, c.r_ty) == TY_ARRAY():
            var_ty = ty_elem(c, c.r_ty)
        else:
            return cerr(c, "'for' can only iterate over arrays or dicts, found " + ty_display(c, c.r_ty))
    # loop variable may already exist (reuse rules)
    c2 = scope_lookup(c, var)
    if c2.res_ok == 1:
        if ty_eq(c2, c2.r_ty, var_ty) == 0:
            return cerr(c2, "loop variable '" + var + "' is already " + ty_display(c2, c2.r_ty) + ", cannot reuse as " + ty_display(c2, var_ty))
        c = c2
    else:
        c = c2
        c = scope_push(c, var, var_ty)
    # the body is the last child
    body = node_child(c.p, stmt)
    while node_next(c.p, body) != -1:
        body = node_next(c.p, body)
    c.loop_depth = c.loop_depth + 1
    c = check_block(c, body)
    c.loop_depth = c.loop_depth - 1
    return c

# ---- lvalues ----

def lvalue_ty(c: CState, e: int) -> CState:
    t = node_tag(c.p, e)
    if t == N_VAR():
        c = scope_lookup(c, node_sval(c.p, e))
        if c.res_ok == 1:
            c = warn_read(c, node_sval(c.p, e))
        if c.res_ok == 0:
            return cerr(c, "assignment to undeclared variable '" + node_sval(c.p, e) + "'")
        return c
    if t == N_INDEX():
        arr = node_child(c.p, e)
        idx = node_next(c.p, arr)
        c = check_expr(c, arr)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) == TY_DICT():
            val = ty_elem(c, c.r_ty)
            c = check_expr(c, idx)
            if c.err == 1:
                return c
            if ty_tag(c, c.r_ty) != TY_STR():
                return cerr(c, "dict key must be a string, found " + ty_display(c, c.r_ty))
            c.r_ty = val
            return c
        if ty_tag(c, c.r_ty) != TY_ARRAY():
            return cerr(c, "cannot index a value of type " + ty_display(c, c.r_ty))
        elem = ty_elem(c, c.r_ty)
        c = check_expr(c, idx)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            return cerr(c, "array index must be int, found " + ty_display(c, c.r_ty))
        c.r_ty = elem
        return c
    if t == N_FIELDACCESS():
        obj = node_child(c.p, e)
        fname = node_sval(c.p, e)
        c = check_expr(c, obj)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_STRUCT():
            return cerr(c, "type " + ty_display(c, c.r_ty) + " has no field '" + fname + "'")
        c = field_lookup(c, ty_sname(c, c.r_ty), fname)
        if c.res_ok == 0:
            return cerr(c, "struct has no field '" + fname + "'")
        return c
    return cerr(c, "invalid assignment target")

# ---- expressions ----

def check_expr(c: CState, e: int) -> CState:
    if e == -1:
        return cerr(c, "missing expression")
    if vec_get(c.p.n_line, e) > 0:
        c.cur_line = vec_get(c.p.n_line, e)
        c.cur_col = vec_get(c.p.n_col, e)
    t = node_tag(c.p, e)
    if t == N_INT():
        c.r_ty = c.t_int
        return c
    if t == N_FLOAT():
        c.r_ty = c.t_float
        return c
    if t == N_STR():
        c.r_ty = c.t_str
        return c
    if t == N_BOOL():
        c.r_ty = c.t_bool
        return c
    if t == N_NONE():
        c.r_ty = c.t_none
        return c
    if t == N_CAST():
        inner = node_child(c.p, e)
        tyn = node_next(c.p, inner)
        c = check_expr(c, inner)
        if c.err == 1:
            return c
        from = c.r_ty
        c = resolve_ty_node(c, tyn)
        if c.err == 1:
            return c
        to = c.r_ty
        ft = ty_tag(c, from)
        tt = ty_tag(c, to)
        ok = 0
        if ft == tt and (ft == TY_INT() or ft == TY_FLOAT() or ft == TY_BOOL() or ft == TY_STR()):
            ok = 1
        elif ft == TY_INT() and tt == TY_FLOAT():
            ok = 1
        elif ft == TY_FLOAT() and tt == TY_INT():
            ok = 1
        elif ft == TY_BOOL() and tt == TY_INT():
            ok = 1
        elif ft == TY_INT() and tt == TY_BOOL():
            ok = 1
        elif ft == TY_INT() and tt == TY_FN():
            ok = 1
        elif ft == TY_FN() and tt == TY_INT():
            ok = 1
        if ok == 0:
            return cerr(c, "invalid cast from " + ty_display(c, from) + " to " + ty_display(c, to))
        c.r_ty = to
        return c
    if t == N_VAR():
        c = scope_lookup(c, node_sval(c.p, e))
        if c.res_ok == 1:
            c = warn_read(c, node_sval(c.p, e))
        if c.res_ok == 0:
            # a bare function name in value position is its address
            name = node_sval(c.p, e)
            fni = sig_index(c, name)
            if fni == -1:
                return cerr(c, "unknown variable '" + name + "'")
            params = vec_new()
            np = vec_get(c.fn_nparam, fni)
            k = 0
            while k < np:
                params = vec_push(params, sig_param_ty(c, fni, k))
                k = k + 1
            c = alloc_fn_ty(c, vec_get(c.fn_ret, fni), params)
            return c
        return c
    if t == N_BINARY():
        return check_binary(c, e)
    if t == N_UNARY():
        return check_unary(c, e)
    if t == N_INDEX():
        return lvalue_ty(c, e)
    if t == N_FIELDACCESS():
        return lvalue_ty(c, e)
    if t == N_ARRAYLIT():
        return check_arraylit(c, e)
    if t == N_DICTLIT():
        return check_dictlit(c, e)
    if t == N_CALL():
        return check_call(c, e)
    return cerr(c, "unknown expression in the arena (tag " + str(t) + ")")

def check_binary(c: CState, e: int) -> CState:
    op = node_ival(c.p, e)
    lhs = node_child(c.p, e)
    rhs = node_next(c.p, lhs)
    c = check_expr(c, lhs)
    if c.err == 1:
        return c
    lt = c.r_ty
    lname = ty_display(c, lt)
    c = check_expr(c, rhs)
    if c.err == 1:
        return c
    rt = c.r_ty
    rname = ty_display(c, rt)
    ltag = ty_tag(c, lt)
    rtag = ty_tag(c, rt)
    # a nullable value has no operators: point at `is None` instead
    if ltag == TY_OPT() or rtag == TY_OPT():
        none_test = 0
        if (op == OP_IS() or op == OP_ISNOT()) and (ltag == TY_NONE() or rtag == TY_NONE()):
            none_test = 1
        if none_test == 0:
            side = "left"
            if ltag != TY_OPT():
                side = "right"
            shown = lt
            if ltag != TY_OPT():
                shown = rt
            return cerr(c, "the " + side + " operand is " + ty_display(c, shown) + ": a nullable value cannot be used here — test it with `is None` / `is not None` first")
    if op == OP_IS() or op == OP_ISNOT():
        nullable = 0
        if ltag == TY_NONE() or ltag == TY_OPT() or rtag == TY_NONE() or rtag == TY_OPT():
            nullable = 1
        if nullable == 0:
            return cerr(c, "'" + op_str(op) + "' compares against None; found (" + lname + ", " + rname + ")")
        c.r_ty = c.t_bool
        return c
    if op == OP_IN() or op == OP_NOTIN():
        comparable = 0
        if ltag == TY_INT() or ltag == TY_FLOAT() or ltag == TY_BOOL() or ltag == TY_STR():
            comparable = 1
        if comparable == 0:
            return cerr(c, "'" + op_str(op) + "' needs a comparable left operand, found " + lname + " (structs and arrays have no equality)")
        if rtag == TY_STR() and ltag == TY_STR():
            c.r_ty = c.t_bool
            return c
        if rtag == TY_ARRAY():
            elem = ty_elem(c, rt)
            etag = ty_tag(c, elem)
            ce = 0
            if etag == TY_INT() or etag == TY_FLOAT() or etag == TY_BOOL() or etag == TY_STR():
                ce = 1
            if ce == 1 and ty_eq(c, lt, elem) == 1:
                c.r_ty = c.t_bool
                return c
        if rtag == TY_DICT() and ltag == TY_STR():
            c.r_ty = c.t_bool
            return c
        return cerr(c, "'" + op_str(op) + "' cannot test a " + lname + " against " + rname + ": a string is searched for the substring, an array for the element, a dict for the key")
    if op == OP_AND() or op == OP_OR():
        if ltag == TY_BOOL() and rtag == TY_BOOL():
            c.r_ty = c.t_bool
            return c
        return cerr(c, "boolean operator requires bool operands, found (" + lname + ", " + rname + ")")
    if op == OP_EQ() or op == OP_NE():
        if is_compound(c, lt) == 1 or is_compound(c, rt) == 1:
            return cerr(c, "cannot compare compound type " + lname + " with " + rname)
        if ty_eq(c, lt, rt) == 1 and ty_tag(c, lt) != TY_VOID():
            c.r_ty = c.t_bool
            return c
        return cerr(c, "cannot compare " + lname + " with " + rname)
    if op == OP_LT() or op == OP_LE() or op == OP_GT() or op == OP_GE():
        if ltag == TY_STR() and rtag == TY_STR():
            c.r_ty = c.t_bool
            return c
        numeric = (ltag == TY_INT() or ltag == TY_FLOAT()) and ltag == rtag
        if numeric:
            c.r_ty = c.t_bool
            return c
        return cerr(c, "ordering comparison requires two int, two float, or two string operands, found (" + lname + ", " + rname + ")")
    if op == OP_ADD():
        if ltag == TY_STR() or rtag == TY_STR():
            if ltag == TY_STR() and rtag == TY_STR():
                c.r_ty = c.t_str
                return c
            return cerr(c, "cannot concatenate string with " + rname)
        if (ltag == TY_INT() or ltag == TY_FLOAT()) and ltag == rtag:
            c.r_ty = lt
            return c
        return cerr(c, "'+' requires two int or two float operands, found (" + lname + ", " + rname + ")")
    if op == OP_SUB() or op == OP_MUL() or op == OP_DIV():
        if (ltag == TY_INT() or ltag == TY_FLOAT()) and ltag == rtag:
            c.r_ty = lt
            return c
        return cerr(c, "arithmetic requires two int or two float operands, found (" + lname + ", " + rname + ")")
    if op == OP_MOD():
        if ltag == TY_INT() and rtag == TY_INT():
            c.r_ty = c.t_int
            return c
        return cerr(c, "'%' requires two int operands, found (" + lname + ", " + rname + ")")
    # v0.37.0 位运算与移位：与 `%` 同样只接受 int，没有隐式提升
    if op == OP_SHL() or op == OP_SHR() or op == OP_BITAND() or op == OP_BITOR() or op == OP_BITXOR():
        if ltag == TY_INT() and rtag == TY_INT():
            c.r_ty = c.t_int
            return c
        return cerr(c, "bitwise/shift operator requires two int operands, found (" + lname + ", " + rname + ")")
    return cerr(c, "unknown binary operator")

def check_unary(c: CState, e: int) -> CState:
    op = node_ival(c.p, e)
    inner = node_child(c.p, e)
    c = check_expr(c, inner)
    if c.err == 1:
        return c
    t = ty_tag(c, c.r_ty)
    if op == OP_NOT():
        if t == TY_BOOL():
            c.r_ty = c.t_bool
            return c
        return cerr(c, "'!' requires bool, found " + ty_display(c, c.r_ty))
    if op == OP_NEG():
        if t == TY_INT() or t == TY_FLOAT():
            return c
        return cerr(c, "unary '-' requires int or float, found " + ty_display(c, c.r_ty))
    if op == OP_BITNOT():
        if t == TY_INT():
            c.r_ty = c.t_int
            return c
        return cerr(c, "unary '~' requires int, found " + ty_display(c, c.r_ty))
    return cerr(c, "unknown unary operator")

def check_arraylit(c: CState, e: int) -> CState:
    rep_len = node_ival(c.p, e)
    if rep_len != 0:
        # replication form: [elem] * N — the single child is the element
        c = check_expr(c, node_child(c.p, e))
        if c.err == 1:
            return c
        elem = c.r_ty
        c = alloc_ty(c, TY_ARRAY(), elem, rep_len, "")
        return c
    first = node_child(c.p, e)
    if first == -1:
        return cerr(c, "empty array literals are not allowed")
    c = check_expr(c, first)
    if c.err == 1:
        return c
    first_ty = c.r_ty
    elem = first_ty
    n = 1
    saw_none = 0
    if ty_tag(c, first_ty) == TY_NONE():
        saw_none = 1
        elem = -1
    ch = node_next(c.p, first)
    while ch != -1:
        c = check_expr(c, ch)
        if c.err == 1:
            return c
        vt = c.r_ty
        if ty_tag(c, vt) == TY_NONE():
            saw_none = 1
        elif elem == -1:
            elem = vt
        elif ty_eq(c, vt, elem) == 0:
            return cerr(c, "array literal elements must share one type: found " + ty_display(c, elem) + " and " + ty_display(c, vt))
        n = n + 1
        ch = node_next(c.p, ch)
    if saw_none == 1:
        if elem == -1:
            elem = c.t_none
        else:
            c = alloc_ty(c, TY_OPT(), elem, 0, "")
            elem = c.r_ty
    c = alloc_ty(c, TY_ARRAY(), elem, n, "")
    return c

def check_dictlit(c: CState, e: int) -> CState:
    ent = node_child(c.p, e)
    if ent == -1:
        return cerr(c, "an empty dict literal needs an annotation: d: dict[int] = {}")
    val = -1
    while ent != -1:
        key = node_child(c.p, ent)
        vnode = node_next(c.p, key)
        c = check_expr(c, key)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_STR():
            return cerr(c, "dict keys must be strings, found " + ty_display(c, c.r_ty))
        c = check_expr(c, vnode)
        if c.err == 1:
            return c
        vt = c.r_ty
        if ty_tag(c, vt) == TY_VOID():
            return cerr(c, "a dict cannot hold a void value")
        if val == -1:
            val = vt
        elif ty_eq(c, vt, val) == 0:
            return cerr(c, "dict values must share one type: found " + ty_display(c, val) + " and " + ty_display(c, vt))
        ent = node_next(c.p, ent)
    c = alloc_ty(c, TY_DICT(), val, 0, "")
    return c

def op_str(op: int) -> string:
    if op == OP_EQ():
        return "=="
    if op == OP_NE():
        return "!="
    if op == OP_IS():
        return "is"
    if op == OP_ISNOT():
        return "is not"
    if op == OP_IN():
        return "in"
    if op == OP_NOTIN():
        return "not in"
    return "?"

def check_call(c: CState, e: int) -> CState:
    name = node_sval(c.p, e)
    arg = node_child(c.p, e)
    # count args
    nargs = 0
    a = arg
    while a != -1:
        nargs = nargs + 1
        a = node_next(c.p, a)

    # ---- builtins ----
    if name == "argc":
        if nargs != 0:
            return cerr(c, "argc expects no arguments")
        c.r_ty = c.t_int
        return c
    if name == "arg" or name == "exit":
        expected = "arg expects exactly 1 positional argument (index: int)"
        if name == "exit":
            expected = "exit expects exactly 1 positional argument (code: int)"
        if nargs != 1:
            return cerr(c, expected)
        if node_sval(c.p, arg) != "":
            return cerr(c, expected)
        c = check_expr(c, node_child(c.p, arg))
        if c.err != 0:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            if name == "arg":
                return cerr(c, "arg index must be int, found " + ty_display(c, c.r_ty))
            return cerr(c, "exit code must be int, found " + ty_display(c, c.r_ty))
        c.r_ty = c.t_str
        if name == "exit":
            c.r_ty = c.t_void
        return c
    if name == "assert":
        expected = "assert expects (condition: bool[, message: string])"
        if nargs < 1 or nargs > 2:
            return cerr(c, expected)
        a = arg
        while a != -1:
            if node_sval(c.p, a) != "":
                return cerr(c, expected)
            a = node_next(c.p, a)
        c = check_expr(c, node_child(c.p, arg))
        if c.err != 0:
            return c
        if ty_tag(c, c.r_ty) != TY_BOOL():
            return cerr(c, "assert condition must be bool, found " + ty_display(c, c.r_ty))
        if nargs == 2:
            c = check_expr(c, node_child(c.p, node_next(c.p, arg)))
            if c.err != 0:
                return c
            if ty_tag(c, c.r_ty) != TY_STR():
                return cerr(c, "assert message must be string, found " + ty_display(c, c.r_ty))
        c.r_ty = c.t_void
        return c
    if name == "print":
        if nargs != 1:
            return cerr(c, "print expects exactly 1 positional argument")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        if is_printable(c, c.r_ty) == 0:
            return cerr(c, "print requires int, float, bool, or string, found " + ty_display(c, c.r_ty))
        c.r_ty = c.t_void
        return c
    if name == "len":
        if nargs != 1:
            return cerr(c, "len expects exactly 1 positional argument")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        t = ty_tag(c, c.r_ty)
        if t != TY_ARRAY() and t != TY_STR() and t != TY_DICT():
            return cerr(c, "len requires an array, string, or dict, found " + ty_display(c, c.r_ty))
        c.r_ty = c.t_int
        return c
    if name == "dict_has" or name == "dict_del":
        if nargs != 2:
            return cerr(c, name + " expects (dict, key)")
        a1 = node_child(c.p, arg)
        a2 = node_child(c.p, node_next(c.p, arg))
        if node_sval(c.p, arg) != "" or node_sval(c.p, node_next(c.p, arg)) != "":
            return cerr(c, name + " expects (dict, key)")
        c = check_expr(c, a1)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_DICT():
            return cerr(c, name + " requires a dict, found " + ty_display(c, c.r_ty))
        c = check_expr(c, a2)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_STR():
            return cerr(c, name + " key must be a string, found " + ty_display(c, c.r_ty))
        c.r_ty = c.t_bool
        return c
    if name == "to_int" or name == "to_float":
        if nargs != 1:
            return cerr(c, name + " expects exactly 1 positional argument")
        a1 = node_child(c.p, arg)
        if node_sval(c.p, arg) != "":
            return cerr(c, name + " expects exactly 1 positional argument")
        c = check_expr(c, a1)
        if c.err == 1:
            return c
        t = c.r_ty
        if name == "to_int" and ty_tag(c, t) == TY_FN():
            c.r_ty = c.t_int
            return c
        if ty_tag(c, t) != TY_INT() and ty_tag(c, t) != TY_FLOAT() and ty_tag(c, t) != TY_BOOL():
            return cerr(c, name + "() requires int, float, or bool, found " + ty_display(c, t))
        if name == "to_int":
            c.r_ty = c.t_int
        else:
            c.r_ty = c.t_float
        return c
    if name == "str":
        if nargs != 1:
            return cerr(c, "str expects exactly 1 positional argument")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        if is_printable(c, c.r_ty) == 0:
            return cerr(c, "cannot convert " + ty_display(c, c.r_ty) + " to string")
        c.r_ty = c.t_str
        return c
    if name == "load_i64" or name == "load_f64":
        if nargs != 1:
            return cerr(c, "load expects exactly 1 argument (address: int)")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            return cerr(c, "load address must be int, found " + ty_display(c, c.r_ty))
        if name == "load_f64":
            c.r_ty = c.t_float
        else:
            c.r_ty = c.t_int
        return c
    if name == "load_u8":
        if nargs != 2:
            return cerr(c, "load_u8 expects (base: int|string, offset: int)")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        bt = ty_tag(c, c.r_ty)
        if bt != TY_INT() and bt != TY_STR():
            return cerr(c, "load_u8 base must be int or string")
        c = check_expr(c, node_child(c.p, node_next(c.p, arg)))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            return cerr(c, "load_u8 offset must be int")
        c.r_ty = c.t_int
        return c
    if name == "store_i64" or name == "store_f64":
        if nargs != 2:
            return cerr(c, "store expects (address: int, value)")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            return cerr(c, "store address must be int, found " + ty_display(c, c.r_ty))
        c = check_expr(c, node_child(c.p, node_next(c.p, arg)))
        if c.err == 1:
            return c
        want = TY_INT()
        if name == "store_f64":
            want = TY_FLOAT()
        if ty_tag(c, c.r_ty) != want:
            return cerr(c, "store value has the wrong type: " + ty_display(c, c.r_ty))
        c.r_ty = c.t_void
        return c
    if name == "store_u8":
        if nargs != 3:
            return cerr(c, "store_u8 expects (base: int|string, offset: int, value: int)")
        a1 = node_child(c.p, arg)
        a2 = node_child(c.p, node_next(c.p, arg))
        a3 = node_child(c.p, node_next(c.p, node_next(c.p, arg)))
        c = check_expr(c, a1)
        if c.err == 1:
            return c
        bt = ty_tag(c, c.r_ty)
        if bt != TY_INT() and bt != TY_STR():
            return cerr(c, "store_u8 base must be int or string")
        c = check_expr(c, a2)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            return cerr(c, "store_u8 offset must be int")
        c = check_expr(c, a3)
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            return cerr(c, "store_u8 value must be int")
        c.r_ty = c.t_void
        return c
    if name == "target_os":
        # compile-time platform query (mirrors the Rust compiler's builtin)
        if nargs != 0:
            return cerr(c, "target_os expects no arguments")
        c.r_ty = c.t_str
        return c
    if name == "as_string":
        if nargs != 1:
            return cerr(c, "as_string expects exactly 1 argument (ptr: int)")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_INT():
            return cerr(c, "as_string expects int, found " + ty_display(c, c.r_ty))
        c.r_ty = c.t_str
        return c
    if name == "as_ptr":
        if nargs != 1:
            return cerr(c, "as_ptr expects exactly 1 argument (s: string)")
        c = check_expr(c, node_child(c.p, arg))
        if c.err == 1:
            return c
        if ty_tag(c, c.r_ty) != TY_STR():
            return cerr(c, "as_ptr expects string, found " + ty_display(c, c.r_ty))
        c.r_ty = c.t_int
        return c

    # ---- struct construction / indirect calls ----
    fni = sig_index(c, name)
    if fni == -1:
        gi = gen_index(c, name)
        if gi != -1:
            return instantiate_call(c, gi, e, arg, nargs)
        if struct_known(c, name) == 1:
            return check_struct_lit(c, name, arg, nargs)
        # indirect call through a function pointer local
        sv = scope_lookup(c, name)
        if sv.res_ok == 1:
            fty = sv.r_ty
            if ty_tag(c, fty) == TY_FN():
                np = ty_fn_n(c, fty)
                if nargs != np:
                    return cerr(c, "function pointer '" + name + "' expects " + str(np) + " argument(s), found " + str(nargs))
                k = 0
                a = arg
                while a != -1 and c.err == 0:
                    if node_sval(c.p, a) != "":
                        return cerr(c, "function pointer '" + name + "' takes positional arguments only")
                    pty = ty_fn_param(c, fty, k)
                    c = check_expr(c, node_child(c.p, a))
                    if c.err == 1:
                        return c
                    if assignable(c, pty, c.r_ty) == 0:
                        return cerr(c, "argument " + str(k + 1) + " of '" + name + "' must be " + ty_display(c, pty) + ", found " + ty_display(c, c.r_ty))
                    k = k + 1
                    a = node_next(c.p, a)
                c.r_ty = ty_fn_ret(c, fty)
                return c
        return cerr(c, "call to undefined function or struct '" + name + "'")

    # ---- user function ----
    np = vec_get(c.fn_nparam, fni)
    if nargs != np:
        return cerr(c, "function '" + name + "' expects " + str(np) + " argument(s), found " + str(nargs))
    k = 0
    a = arg
    while a != -1 and c.err == 0:
        if node_sval(c.p, a) != "":
            return cerr(c, "function '" + name + "' takes positional arguments only")
        pty = sig_param_ty(c, fni, k)
        c = check_expr(c, node_child(c.p, a))
        if c.err == 1:
            return c
        if assignable(c, pty, c.r_ty) == 0:
            return cerr(c, "argument " + str(k + 1) + " of '" + name + "' must be " + ty_display(c, pty) + ", found " + ty_display(c, c.r_ty))
        k = k + 1
        a = node_next(c.p, a)
    c.r_ty = vec_get(c.fn_ret, fni)
    return c

def check_struct_lit(c: CState, name: string, arg: int, nargs: int) -> CState:
    a = arg
    while a != -1 and c.err == 0:
        fname = node_sval(c.p, a)
        if fname == "":
            return cerr(c, "struct '" + name + "' must be constructed with named fields: " + name + "(field=value, ...)")
        c = field_lookup(c, name, fname)
        if c.res_ok == 0:
            return cerr(c, "struct '" + name + "' has no field '" + fname + "'")
        fty = c.r_ty
        c = check_expr(c, node_child(c.p, a))
        if c.err == 1:
            return c
        if assignable(c, fty, c.r_ty) == 0:
            return cerr(c, "field '" + fname + "' of '" + name + "' must be " + ty_display(c, fty) + ", found " + ty_display(c, c.r_ty))
        a = node_next(c.p, a)
    if c.err == 1:
        return c
    if nargs != struct_field_count(c, name):
        return cerr(c, "struct literal '" + name + "' is missing field(s)")
    c = alloc_ty(c, TY_STRUCT(), 0, 0, name)
    return c

# ---- monomorphization ----
# A call to a generic function unifies the argument types against the declared
# (possibly TY_VAR / length -1) parameter types, then clones the declaration's
# AST with the type parameters and N substituted, registers the instance as a
# normal signature, and queues its body for checking. p.call_node/p.call_fni
# route each (cloned) call site to its instance.

def sub_index(c: CState, name: string) -> int:
    i = 0
    while i < c.sub_names.len:
        if as_string(vec_get(c.sub_names, i)) == name:
            return i
        i = i + 1
    return -1

def generic_param_ty(c: CState, gi: int, k: int) -> int:
    seen = 0
    i = 0
    while i < c.g_fn.len:
        if vec_get(c.g_fn, i) == gi:
            if seen == k:
                return vec_get(c.g_pty, i)
            seen = seen + 1
        i = i + 1
    return -1

# unify a declared (possibly generic) type against a concrete type;
# type params fill sub_names/sub_tys, the length param fills sub_len_*
def unify(c: CState, declared: int, actual: int) -> CState:
    c.res_ok = 1
    dt = ty_tag(c, declared)
    at = ty_tag(c, actual)
    if dt == TY_VAR():
        name = ty_sname(c, declared)
        k = sub_index(c, name)
        if k == -1:
            c.sub_names = vec_push(c.sub_names, as_ptr(name))
            c.sub_tys = vec_push(c.sub_tys, actual)
            return c
        if vec_get(c.sub_tys, k) == actual:
            return c
        c.res_ok = 0
        return c
    if dt == TY_ARRAY():
        if at != TY_ARRAY():
            c.res_ok = 0
            return c
        dl = ty_len(c, declared)
        al = ty_len(c, actual)
        if dl == -1:
            if c.sub_len_set == 1:
                if c.sub_len_val != al:
                    c.res_ok = 0
                    return c
            else:
                c.sub_len_set = 1
                c.sub_len_val = al
        elif dl != al:
            c.res_ok = 0
            return c
        return unify(c, ty_elem(c, declared), ty_elem(c, actual))
    if dt == TY_OPT() or dt == TY_DICT():
        if at != dt:
            c.res_ok = 0
            return c
        return unify(c, ty_elem(c, declared), ty_elem(c, actual))
    if dt == TY_FN():
        if at != TY_FN():
            c.res_ok = 0
            return c
        if ty_fn_n(c, declared) != ty_fn_n(c, actual):
            c.res_ok = 0
            return c
        c = unify(c, ty_fn_ret(c, declared), ty_fn_ret(c, actual))
        if c.res_ok == 0:
            return c
        k = 0
        while k < ty_fn_n(c, declared):
            c = unify(c, ty_fn_param(c, declared, k), ty_fn_param(c, actual, k))
            if c.res_ok == 0:
                return c
            k = k + 1
        return c
    if dt != at:
        c.res_ok = 0
        return c
    if dt == TY_STRUCT():
        if ty_sname(c, declared) != ty_sname(c, actual):
            c.res_ok = 0
    return c

def type_slug(c: CState, ty: int) -> string:
    t = ty_tag(c, ty)
    if t == TY_INT():
        return "i"
    if t == TY_FLOAT():
        return "f"
    if t == TY_BOOL():
        return "b"
    if t == TY_STR():
        return "s"
    if t == TY_VOID():
        return "v"
    if t == TY_NONE():
        return "z"
    if t == TY_OPT():
        return "n" + type_slug(c, ty_elem(c, ty))
    if t == TY_DICT():
        return "d" + type_slug(c, ty_elem(c, ty))
    if t == TY_FN():
        s = "fn_" + type_slug(c, ty_fn_ret(c, ty))
        k = 0
        while k < ty_fn_n(c, ty):
            s = s + "_" + type_slug(c, ty_fn_param(c, ty, k))
            k = k + 1
        return s
    if t == TY_ARRAY():
        return "a" + type_slug(c, ty_elem(c, ty)) + "x" + str(ty_len(c, ty))
    if t == TY_VAR():
        return "?"
    return "s_" + ty_sname(c, ty)

# deterministic mangled name: name.<slug per type param>.<len if bound>
def mangle(c: CState, gi: int, name: string) -> string:
    key = name
    i = 0
    while i < c.g_tp.len:
        if vec_get(c.g_tp, i) == gi:
            tname = as_string(vec_get(c.g_tpname, i))
            k = sub_index(c, tname)
            if k == -1:
                key = key + ".?"
            else:
                key = key + "." + type_slug(c, vec_get(c.sub_tys, k))
        i = i + 1
    if c.sub_len_set == 1:
        key = key + "." + str(c.sub_len_val)
    return key

# AST node helpers that go through the CState's PState
def cnode(c: CState, tag: int, sval: string, ival: int) -> CState:
    c.p = new_node(c.p, tag, sval, ival)
    c.r_node = c.p.res_node
    return c

def cset_child(c: CState, idx: int, child: int) -> CState:
    c.p = set_child(c.p, idx, child)
    return c

def cappend_child(c: CState, parent: int, child: int) -> CState:
    c.p = append_child(c.p, parent, child)
    return c

# build a fresh AST type node from a concrete type arena entry
def build_ty_node(c: CState, ty: int) -> CState:
    t = ty_tag(c, ty)
    if t == TY_INT():
        return cnode(c, N_TYINT(), "", 0)
    if t == TY_FLOAT():
        return cnode(c, N_TYFLOAT(), "", 0)
    if t == TY_BOOL():
        return cnode(c, N_TYBOOL(), "", 0)
    if t == TY_STR():
        return cnode(c, N_TYSTRING(), "", 0)
    if t == TY_VOID():
        return cnode(c, N_TYVOID(), "", 0)
    if t == TY_NONE():
        return cnode(c, N_TYNONE(), "", 0)
    if t == TY_OPT():
        c = build_ty_node(c, ty_elem(c, ty))
        inner = c.r_node
        c = cnode(c, N_TYOPT(), "", 0)
        n = c.r_node
        c = cset_child(c, n, inner)
        c.r_node = n
        return c
    if t == TY_DICT():
        c = build_ty_node(c, ty_elem(c, ty))
        inner = c.r_node
        c = cnode(c, N_TYDICT(), "", 0)
        n = c.r_node
        c = cset_child(c, n, inner)
        c.r_node = n
        return c
    if t == TY_FN():
        c = cnode(c, N_TYFN(), "", ty_fn_n(c, ty))
        n = c.r_node
        k = 0
        while k < ty_fn_n(c, ty):
            c = build_ty_node(c, ty_fn_param(c, ty, k))
            c = cappend_child(c, n, c.r_node)
            k = k + 1
        c = build_ty_node(c, ty_fn_ret(c, ty))
        c = cappend_child(c, n, c.r_node)
        c.r_node = n
        return c
    if t == TY_STRUCT():
        return cnode(c, N_TYSTRUCT(), ty_sname(c, ty), 0)
    if t == TY_ARRAY():
        c = build_ty_node(c, ty_elem(c, ty))
        elem = c.r_node
        c = cnode(c, N_TYARRAY(), "", ty_len(c, ty))
        n = c.r_node
        c = cset_child(c, n, elem)
        c.r_node = n
        return c
    return cerr(c, "internal: cannot build a node for a type variable")

# clone a subtree of the generic declaration into fresh arena nodes,
# substituting type params (via sub_*) and the length param N
def clone_subtree(c: CState, old: int, len_name: string) -> CState:
    t = node_tag(c.p, old)
    if t == N_TYPEPARAMS():
        c.r_node = -1
        return c
    if t == N_TYSTRUCT():
        name = node_sval(c.p, old)
        k = sub_index(c, name)
        if k != -1:
            return build_ty_node(c, vec_get(c.sub_tys, k))
        return cnode(c, N_TYSTRUCT(), name, 0)
    if t == N_TYARRAY():
        old_ln = node_ival(c.p, old)
        c = clone_subtree(c, node_child(c.p, old), len_name)
        elem = c.r_node
        ln = old_ln
        if ln == -1 and c.sub_len_set == 1:
            ln = c.sub_len_val
        c = cnode(c, N_TYARRAY(), node_sval(c.p, old), ln)
        n = c.r_node
        if elem != -1:
            c = cset_child(c, n, elem)
        c.r_node = n
        return c
    if t == N_VAR() and len_name != "" and c.sub_len_set == 1 and node_sval(c.p, old) == len_name:
        return cnode(c, N_INT(), str(c.sub_len_val), c.sub_len_val)
    c = cnode(c, t, node_sval(c.p, old), node_ival(c.p, old))
    n = c.r_node
    vec_set(c.p.n_line, n, vec_get(c.p.n_line, old))
    vec_set(c.p.n_col, n, vec_get(c.p.n_col, old))
    kid = node_child(c.p, old)
    while kid != -1:
        nxt = node_next(c.p, kid)
        c = clone_subtree(c, kid, len_name)
        if c.r_node != -1:
            c = cappend_child(c, n, c.r_node)
        kid = nxt
    c.r_node = n
    return c

def instantiate_call(c: CState, gi: int, e: int, arg: int, nargs: int) -> CState:
    gname = as_string(vec_get(c.g_name, gi))
    np = vec_get(c.g_nparam, gi)
    a = arg
    while a != -1:
        if node_sval(c.p, a) != "":
            return cerr(c, "function '" + gname + "' takes positional arguments only")
        a = node_next(c.p, a)
    if nargs != np:
        return cerr(c, "function '" + gname + "' expects " + str(np) + " argument(s), found " + str(nargs))
    ats = vec_new()
    a = arg
    while a != -1 and c.err == 0:
        c = check_expr(c, node_child(c.p, a))
        if c.err == 1:
            return c
        ats = vec_push(ats, c.r_ty)
        a = node_next(c.p, a)
    c.sub_names = vec_new()
    c.sub_tys = vec_new()
    c.sub_len_set = 0
    c.sub_len_val = 0
    k = 0
    a = arg
    while a != -1 and c.err == 0:
        declared = generic_param_ty(c, gi, k)
        actual = vec_get(ats, k)
        c = unify(c, declared, actual)
        if c.res_ok == 0:
            return cerr(c, "argument " + str(k + 1) + " of '" + gname + "' must be " + ty_display(c, declared) + ", found " + ty_display(c, actual))
        k = k + 1
        a = node_next(c.p, a)
    if c.err == 1:
        return c
    key = mangle(c, gi, gname)
    fni = -1
    i = 0
    while i < c.inst_names.len:
        if as_string(vec_get(c.inst_names, i)) == key:
            fni = vec_get(c.inst_fni, i)
        i = i + 1
    if fni == -1:
        old_fn = vec_get(c.g_node, gi)
        len_name = as_string(vec_get(c.g_lenname, gi))
        c = clone_subtree(c, old_fn, len_name)
        new_fn = c.r_node
        vec_set(c.p.n_sval, new_fn, as_ptr(key))
        vec_set(c.p.n_ival, new_fn, 0)
        c.cur_tps = vec_new()
        c = collect_one_sig(c, new_fn)
        if c.err == 1:
            return c
        fni = c.fn_name.len - 1
        c.inst_names = vec_push(c.inst_names, as_ptr(key))
        c.inst_fni = vec_push(c.inst_fni, fni)
        c.inst_node = vec_push(c.inst_node, new_fn)
        c.q_node = vec_push(c.q_node, new_fn)
    c.call_node = vec_push(c.call_node, e)
    c.call_fni = vec_push(c.call_fni, fni)
    c.r_ty = vec_get(c.fn_ret, fni)
    return c

# ---- function bodies ----

def check_fn_body(c: CState, fn_idx: int) -> CState:
    fname = node_sval(c.p, fn_idx)
    fni = sig_index(c, fname)
    if fni == -1:
        return cerr(c, "internal: missing signature for '" + fname + "'")
    body = -1
    k = 0
    kid = node_child(c.p, fn_idx)
    while kid != -1:
        t = node_tag(c.p, kid)
        if t == N_BLOCK():
            body = kid
        elif t == N_PARAM():
            pname = node_sval(c.p, kid)
            pty = sig_param_ty(c, fni, k)
            c = scope_push(c, pname, pty)
            k = k + 1
        kid = node_next(c.p, kid)
    if body == -1:
        return cerr(c, "malformed function body")
    c.cur_ret = vec_get(c.fn_ret, fni)
    c.wd_name = vec_new()
    c.wd_line = vec_new()
    c.wd_col = vec_new()
    c.wr_name = vec_new()
    c = check_block(c, body)
    if c.err == 1:
        return c
    c = warn_flush(c)
    rty = c.cur_ret
    if ty_tag(c, rty) != TY_VOID() and block_returns_all(c, body, 0) == 0:
        return cerr(c, "function '" + fname + "' does not return a value on all paths")
    return c

def check_all(c0: CState) -> CState:
    c = c0
    if c.p.root == -1:
        c.p = parse_program(c.p)
        if c.p.err == 1:
            return cerr(c, "parse error: " + c.p.errmsg)
    c = collect_structs(c)
    if c.err == 1:
        return c
    c = collect_sigs(c)
    if c.err == 1:
        return c
    if sig_index(c, "main") == -1:
        return cerr(c, "program has no 'main' function")
    root = c.p.root
    ch = node_child(c.p, root)
    while ch != -1 and c.err == 0:
        t = node_tag(c.p, ch)
        if (t == N_FN() or t == N_EXTERN()) and node_ival(c.p, ch) == 0 and is_generic_fn(c, ch) == 0:
            c.sc_name = vec_new()
            c.sc_ty = vec_new()
            c = check_fn_body(c, ch)
        ch = node_next(c.p, ch)
    # drain the monomorphized instances (they can enqueue new ones)
    qi = 0
    while qi < c.q_node.len and c.err == 0:
        node = vec_get(c.q_node, qi)
        qi = qi + 1
        c.sc_name = vec_new()
        c.sc_ty = vec_new()
        c = check_fn_body(c, node)
    return c
