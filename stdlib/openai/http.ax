# Aoxn OpenAI SDK — HTTP transport over WinHTTP (v0.40.1).
#
# The whole SDK rides on ONE Windows system facility: winhttp.dll. It gives
# TLS, the proxy configuration, redirects and chunked responses for free —
# raw ws2_32 sockets (the web/ suite) cannot do HTTPS without a TLS stack,
# and Aoxn has none. Programs using this module link with:
#
#   Aoxn run app.ax -l winhttp
#
# Everything wide-char is converted at the boundary with `oa_to_wide`
# (codec.ax); request bodies stay UTF-8 bytes (the API expects UTF-8 JSON).
# WinHTTP string parameters are declared as `int` (raw pointers) on purpose —
# declaring them `string` would promise C `char*` semantics for UTF-16 data.
#
# Split so offline code never links winhttp: the pure helpers (URL split,
# header text, retry policy, error names) live here but take no WinHTTP
# handles; `client.ax` is the only module that calls the `oa_http_*` flow.
# The self-hosted compiler can compile this file — plain Aoxn only.

import * from "../stdlib.ax"
import * from "./codec.ax"

# ---- WinHTTP surface (-l winhttp) ----

extern def WinHttpOpen(agent: int, access: int, proxy: int, bypass: int, flags: int) -> int
extern def WinHttpConnect(session: int, host: int, port: int, flags: int) -> int
extern def WinHttpOpenRequest(conn: int, verb: int, path: int, ver: int, ref: int, accept: int, flags: int) -> int
extern def WinHttpAddRequestHeaders(req: int, hdrs: int, len: int, mods: int) -> int
extern def WinHttpSendRequest(req: int, hdrs: int, hlen: int, opt: int, olen: int, total: int, ctx: int) -> int
extern def WinHttpReceiveResponse(req: int, reserved: int) -> int
extern def WinHttpQueryHeaders(req: int, level: int, name: int, buf: int, plen: int, idx: int) -> int
extern def WinHttpQueryDataAvailable(req: int, avail: int) -> int
extern def WinHttpReadData(req: int, buf: int, toread: int, read: int) -> int
extern def WinHttpSetTimeouts(h: int, resolve: int, connect: int, send: int, recv: int) -> int
extern def WinHttpCloseHandle(h: int) -> int
extern def GetLastError() -> int
extern def Sleep(ms: int)

# ---- constants (decimal — the repo keeps byte/flag constants decimal) ----

def WINHTTP_FLAG_SECURE() -> int:
    return 8388608

# WINHTTP_ADDREQ_FLAG_ADD | WINHTTP_ADDREQ_FLAG_REPLACE — "set this header"
def OA_HDR_SET() -> int:
    return 2684354560

# WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER
def OA_QUERY_STATUS() -> int:
    return 536870931

def OA_DEFAULT_CONNECT_MS() -> int:
    return 5000

def OA_DEFAULT_TIMEOUT_MS() -> int:
    return 600000

def OA_DEFAULT_RETRIES() -> int:
    return 2

# ---- URL splitting (pure) ----

struct OaUrl:
    secure: bool
    host: string
    port: int
    path: string      # starts with '/', no query string

# split an absolute http(s) URL. Unresolvable shapes come back with host ""
# and the caller reports a clear transport error instead of guessing.
def oa_url_split(url: string) -> OaUrl:
    u = OaUrl(secure=True, host="", port=443, path="/")
    if str_sub(url, 0, 8) == "https://":
        rest = str_sub(url, 8, len(url))
        u.secure = True
        dport = 443
    else:
        if str_sub(url, 0, 7) == "http://":
            rest = str_sub(url, 7, len(url))
            u.secure = False
            dport = 80
        else:
            return u
    # strip a query string: it would confuse WinHttpOpenRequest's path
    hash = -1
    slash = -1
    colon = -1
    i = 0
    while i < len(rest):
        c = load_u8(rest, i)
        if c == 47 and slash == -1:
            slash = i
        if c == 63 and hash == -1:
            hash = i
        if c == 58 and slash == -1:
            colon = i
        i = i + 1
    if hash >= 0:
        rest = str_sub(rest, 0, hash)
        slash = -1
        colon = -1
        i = 0
        while i < len(rest):
            c = load_u8(rest, i)
            if c == 47 and slash == -1:
                slash = i
            if c == 58 and slash == -1:
                colon = i
            i = i + 1
    hostpart = rest
    path = "/"
    if slash >= 0:
        hostpart = str_sub(rest, 0, slash)
        path = str_sub(rest, slash, len(rest))
    host = hostpart
    port = dport
    if colon >= 0:
        host = str_sub(hostpart, 0, colon)
        ptxt = str_sub(hostpart, colon + 1, len(hostpart))
        port = 0
        i = 0
        while i < len(ptxt):
            c = load_u8(ptxt, i)
            if c < 48 or c > 57:
                port = 0
                i = len(ptxt)
            else:
                port = port * 10 + (c - 48)
                i = i + 1
        if port == 0:
            port = dport
    u.host = host
    u.port = port
    u.path = path
    return u

# ---- header block (pure; testable) ----

# CRLF as raw bytes — the language has no \r escape (only \n \t \\ \"),
# so headers are assembled with this, exactly like web/http_buf.ax does.
def oa_crlf() -> string:
    p = malloc(3)
    store_u8(p, 0, 13)
    store_u8(p, 1, 10)
    store_u8(p, 2, 0)
    return as_string(p)

# the standard header block every request carries. `org` / `project` empty
# means omit (the Python SDK omits them when unset).
def oa_headers_build(api_key: string, org: string, project: string, body: string) -> string:
    nl = oa_crlf()
    h = "Authorization: Bearer " + api_key + nl
    if len(org) > 0:
        h = h + "OpenAI-Organization: " + org + nl
    if len(project) > 0:
        h = h + "OpenAI-Project: " + project + nl
    if len(body) > 0:
        h = h + "Content-Type: application/json" + nl
    h = h + "Accept: application/json" + nl
    h = h + "User-Agent: aoxn-openai/" + oa_version() + nl
    return h

# the SDK version, spelled once (kept in step with the compiler release)
def oa_version() -> string:
    return "0.40.1"

# ---- retry policy (pure; mirrors the Python SDK's DEFAULT_MAX_RETRIES) ----

# milliseconds to wait before the retry after attempt `attempt` (0-based
# after the first failure), or -1 = give up. `max_retries` is the client's
# retry budget (retries AFTER the first attempt). `status` 0 means a
# transport error (always retryable); Retry-After (seconds) wins when the
# server sent one.
def oa_retry_delay(attempt: int, max_retries: int, status: int, retry_after_s: int) -> int:
    if attempt >= max_retries:
        return -1
    if status == 0 or status == 429 or status == 500 or status == 502 or status == 503 or status == 504:
        if retry_after_s > 0 and retry_after_s <= 120:
            return retry_after_s * 1000
        return 500 * (attempt + 1)
    return -1

# ---- WinHTTP error names ----

def oa_winhttp_err(code: int) -> string:
    if code == 12002:
        return "timeout"
    if code == 12007:
        return "dns failure"
    if code == 12029:
        return "connection refused"
    if code == 12030 or code == 12031:
        return "connection dropped"
    if code == 12152:
        return "invalid server response"
    if code == 12005:
        return "ssl failure"
    if code == 12175:
        return "ssl certificate authority failure"
    return "winhttp error " + str(code)

# ---- response records ----

struct OaHttpResp:
    status: int       # HTTP status; 0 = transport failure
    body: string      # raw response body ("" when the transport failed)
    err: int          # 1 = transport-level failure
    errmsg: string

struct OaHttpStream:
    session: int
    conn: int
    req: int
    status: int
    got: int          # bytes of the last oa_http_stream_read
    err: int
    errmsg: string

# read the HTTP status off an open request; -1 when unavailable
def oa_query_status(req: int) -> int:
    buf = malloc(8)
    store_i64(buf, 0)
    plen = malloc(8)
    store_i64(plen, 8)
    ok = WinHttpQueryHeaders(req, OA_QUERY_STATUS(), -1, buf, plen, 0)
    if ok == 0:
        free(buf)
        free(plen)
        return -1
    st = load_u8(buf, 0) + load_u8(buf, 1) * 256 + load_u8(buf, 2) * 65536 + load_u8(buf, 3) * 16777216
    free(buf)
    free(plen)
    return st

# one full request/response cycle (no retries here — client.ax owns the
# retry loop). `body` "" means GET-style without a body.
def oa_http_request(method: string, url: string, headers: string, body: string, connect_ms: int, recv_ms: int) -> OaHttpResp:
    r = OaHttpResp(status=0, body="", err=0, errmsg="")
    u = oa_url_split(url)
    if len(u.host) == 0:
        r.err = 1
        r.errmsg = "cannot parse URL: " + url
        return r
    agent = oa_to_wide("aoxn-openai/" + oa_version())
    session = WinHttpOpen(agent, 0, 0, 0, 0)
    free(agent)
    if session == 0:
        code = GetLastError()
        r.errmsg = oa_winhttp_err(code)
        r.err = 1
        return r
    WinHttpSetTimeouts(session, 15000, connect_ms, 30000, recv_ms)
    whost = oa_to_wide(u.host)
    conn = WinHttpConnect(session, whost, u.port, 0)
    free(whost)
    if conn == 0:
        code = GetLastError()
        r.errmsg = oa_winhttp_err(code)
        r.err = 1
        WinHttpCloseHandle(session)
        return r
    flags = 0
    if u.secure:
        flags = WINHTTP_FLAG_SECURE()
    wpath = oa_to_wide(u.path)
    wverb = oa_to_wide(method)
    req = WinHttpOpenRequest(conn, wverb, wpath, 0, 0, 0, flags)
    free(wpath)
    free(wverb)
    if req == 0:
        code = GetLastError()
        r.errmsg = oa_winhttp_err(code)
        r.err = 1
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return r
    whdrs = oa_to_wide(headers)
    ok = WinHttpAddRequestHeaders(req, whdrs, -1, OA_HDR_SET())
    free(whdrs)
    if ok == 0:
        code = GetLastError()
        r.errmsg = oa_winhttp_err(code)
        r.err = 1
        WinHttpCloseHandle(req)
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return r
    bptr = 0
    blen = 0
    if len(body) > 0:
        bptr = as_ptr(body)
        blen = len(body)
    ok = WinHttpSendRequest(req, 0, 0, bptr, blen, blen, 0)
    if ok == 0:
        code = GetLastError()
        r.errmsg = oa_winhttp_err(code)
        r.err = 1
        WinHttpCloseHandle(req)
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return r
    ok = WinHttpReceiveResponse(req, 0)
    if ok == 0:
        code = GetLastError()
        r.errmsg = oa_winhttp_err(code)
        r.err = 1
        WinHttpCloseHandle(req)
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return r
    r.status = oa_query_status(req)
    # drain the body
    cap = 8192
    buf = malloc(cap)
    total = 0
    while True:
        abuf = malloc(8)
        store_i64(abuf, 0)
        ok = WinHttpQueryDataAvailable(req, abuf)
        if ok == 0:
            free(abuf)
            break
        avail = load_i64(abuf)
        free(abuf)
        if avail == 0:
            break
        if total + avail + 1 > cap:
            cap = (total + avail + 1) * 2
            buf = realloc(buf, cap)
        rbuf = malloc(8)
        store_i64(rbuf, 0)
        ok = WinHttpReadData(req, buf + total, avail, rbuf)
        if ok == 0:
            free(rbuf)
            break
        got = load_i64(rbuf)
        free(rbuf)
        total = total + got
        if got == 0:
            break
    store_u8(buf, total, 0)
    r.body = as_string(buf)
    WinHttpCloseHandle(req)
    WinHttpCloseHandle(conn)
    WinHttpCloseHandle(session)
    return r

# ---- streaming ----

# open a request and receive the response headers, but keep the connection
# open: the body streams through oa_http_stream_read. Caller closes with
# oa_http_stream_close (which releases all three handles).
def oa_http_stream_open(method: string, url: string, headers: string, body: string, connect_ms: int, recv_ms: int) -> OaHttpStream:
    s = OaHttpStream(session=0, conn=0, req=0, status=0, got=0, err=0, errmsg="")
    u = oa_url_split(url)
    if len(u.host) == 0:
        s.err = 1
        s.errmsg = "cannot parse URL: " + url
        return s
    agent = oa_to_wide("aoxn-openai/" + oa_version())
    session = WinHttpOpen(agent, 0, 0, 0, 0)
    free(agent)
    if session == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        return s
    WinHttpSetTimeouts(session, 15000, connect_ms, 30000, recv_ms)
    whost = oa_to_wide(u.host)
    conn = WinHttpConnect(session, whost, u.port, 0)
    free(whost)
    if conn == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        WinHttpCloseHandle(session)
        return s
    flags = 0
    if u.secure:
        flags = WINHTTP_FLAG_SECURE()
    wpath = oa_to_wide(u.path)
    wverb = oa_to_wide(method)
    req = WinHttpOpenRequest(conn, wverb, wpath, 0, 0, 0, flags)
    free(wpath)
    free(wverb)
    if req == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return s
    whdrs = oa_to_wide(headers)
    ok = WinHttpAddRequestHeaders(req, whdrs, -1, OA_HDR_SET())
    free(whdrs)
    if ok == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        WinHttpCloseHandle(req)
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return s
    bptr = 0
    blen = 0
    if len(body) > 0:
        bptr = as_ptr(body)
        blen = len(body)
    ok = WinHttpSendRequest(req, 0, 0, bptr, blen, blen, 0)
    if ok == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        WinHttpCloseHandle(req)
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return s
    ok = WinHttpReceiveResponse(req, 0)
    if ok == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        WinHttpCloseHandle(req)
        WinHttpCloseHandle(conn)
        WinHttpCloseHandle(session)
        return s
    s.session = session
    s.conn = conn
    s.req = req
    s.status = oa_query_status(req)
    return s

# one read into `buf` (capacity `cap`); byte count lands in s.got (0 = end)
def oa_http_stream_read(s: OaHttpStream, buf: int, cap: int) -> OaHttpStream:
    s.got = 0
    abuf = malloc(8)
    store_i64(abuf, 0)
    ok = WinHttpQueryDataAvailable(s.req, abuf)
    if ok == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        free(abuf)
        return s
    avail = load_i64(abuf)
    free(abuf)
    if avail == 0:
        return s
    if avail > cap:
        avail = cap
    rbuf = malloc(8)
    store_i64(rbuf, 0)
    ok = WinHttpReadData(s.req, buf, avail, rbuf)
    if ok == 0:
        s.err = 1
        s.errmsg = oa_winhttp_err(GetLastError())
        free(rbuf)
        return s
    s.got = load_i64(rbuf)
    free(rbuf)
    return s

def oa_http_stream_close(s: OaHttpStream):
    if s.req != 0:
        WinHttpCloseHandle(s.req)
    if s.conn != 0:
        WinHttpCloseHandle(s.conn)
    if s.session != 0:
        WinHttpCloseHandle(s.session)
