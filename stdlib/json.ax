# Aoxn standard library — JSON (promoted to stdlib/json.ax in v0.44.0;
# first shipped as stdlib/openai/json.ax in v0.40.1, then stdlib/net/json.ax
# from v0.41.0 — it was provider-neutral all along, and the OpenAI/Anthropic
# SDKs import this exact file at its new home). The v0.44.0 promotion added
# the file-I/O pair (j_read_file / j_write_file) at the bottom.
#
# Aoxn has no dict, no `None`, no `sizeof`, and no address-of-struct. A general
# JSON DOM therefore cannot live in a `Vec` of `JVal` structs (Vec moves 8-byte
# slots, not structs). The design here is the same one the UI's shared heap
# block uses: every value is a fixed 40-byte node record laid out in one slab,
# and an array/object value holds pointers to parallel buffers of child node
# indices.
#
#   node = 40 bytes (5 x i64) at slab + i*40:
#     +0  kind   0=null 1=bool 2=int 3=float 4=str 5=arr 6=obj
#     +8  ival   bool(0/1) | int value | child count (arr/obj)
#     +16 fval   float value
#     +24 ptrA   str: string pointer | arr: child-index buffer
#                | obj: value-index buffer (parallel to keys)
#     +32 ptrB   obj: key-index buffer (parallel to values); 0 otherwise
#
# Child buffers are plain i64 arrays (Vec.data is exactly that — the parse
# loops build `Vec`s and adopt their buffers). Indices are SLAB indices, so
# growing the slab never invalidates them.
#
# Strings never round-trip through the slab: a STR node's pointer aliases
# either an escaped-copy made by the parser or a string handed to the
# constructor. Both leak by the language's design (strings are immutable and
# shared); there is no free list — a response DOM is dropped whole.
#
# The parser is recursive descent with WRITE-BACK: every helper takes the
# `JParse` state by value and returns the updated one (`p = jp_value(p)`);
# extra results travel in fields (`p.res`, `dom.last`). Never nest a mutating
# call as an argument — assign each step (the self-hosting discipline).
#
# Feature budget: plain Aoxn only (no dict/None/fn-ptr/raise) so the self-
# hosted compiler can compile this file too.

import * from "stdlib.ax"
import * from "./net/codec.ax"

# ---- kinds ----

def J_NULL() -> int:
    return 0

def J_BOOL() -> int:
    return 1

def J_INT() -> int:
    return 2

def J_FLOAT() -> int:
    return 3

def J_STR() -> int:
    return 4

def J_ARR() -> int:
    return 5

def J_OBJ() -> int:
    return 6

# ---- the DOM ----

struct JDom:
    slab: int      # node buffer, 40 bytes per node
    cap: int       # node capacity
    n: int         # node count
    last: int      # index of the most recently pushed node

def jdom_new() -> JDom:
    return JDom(slab=0, cap=0, n=0, last=0)

# grow so at least `need` nodes fit (never shrinks); new region zeroed so
# unset fields read as 0 / NULL
def jdom_reserve(dom: JDom, need: int) -> JDom:
    if need <= dom.cap:
        return dom
    newcap = dom.cap * 2
    if newcap < need:
        newcap = need
    if newcap == 0:
        newcap = 16
    if dom.slab == 0:
        slab = malloc(newcap * 40)
    else:
        slab = realloc(dom.slab, newcap * 40)
    fill_zero(slab + dom.cap * 40, (newcap - dom.cap) * 40)
    return JDom(slab=slab, cap=newcap, n=dom.n, last=dom.last)

# append one node; the new node's index comes back in `dom.last`
def jdom_push(dom: JDom, kind: int, ival: int, fval: float, ptr_a: int, ptr_b: int) -> JDom:
    dom = jdom_reserve(dom, dom.n + 1)
    base = dom.slab + dom.n * 40
    store_i64(base, kind)
    store_i64(base + 8, ival)
    store_f64(base + 16, fval)
    store_i64(base + 24, ptr_a)
    store_i64(base + 32, ptr_b)
    dom.n = dom.n + 1
    dom.last = dom.n - 1
    return dom

# ---- accessors ----
# Every accessor tolerates an EMPTY dom (`j_parse` failure leaves slab == 0):
# it reads as a null node instead of dereferencing NULL. It also tolerates a
# NEGATIVE index: -1 is this module's "absent" answer everywhere (j_obj_get,
# j_arr_get, j_obj_val_idx), and callers routinely pipe it straight into
# another accessor — `j_dumps(dom, j_obj_get(dom, i, "input"))` is the
# idiom the SDKs use. Without the guard that reads 40 bytes BEFORE the slab.

def j_kind(dom: JDom, i: int) -> int:
    if dom.slab == 0 or i < 0:
        return J_NULL()
    return load_i64(dom.slab + i * 40)

def j_ival(dom: JDom, i: int) -> int:
    if dom.slab == 0 or i < 0:
        return 0
    return load_i64(dom.slab + i * 40 + 8)

def j_fval(dom: JDom, i: int) -> float:
    if dom.slab == 0 or i < 0:
        return 0.0
    return load_f64(dom.slab + i * 40 + 16)

def j_as_str(dom: JDom, i: int) -> string:
    if dom.slab == 0 or i < 0:
        return ""
    return as_string(load_i64(dom.slab + i * 40 + 24))

def j_is_null(dom: JDom, i: int) -> bool:
    return j_kind(dom, i) == J_NULL()

def j_as_bool(dom: JDom, i: int) -> bool:
    return j_ival(dom, i) == 1

# child count of an array/object node (0 otherwise)
def j_len(dom: JDom, i: int) -> int:
    return j_ival(dom, i)

# k-th child of an array node; -1 when out of range or not an array
def j_arr_get(dom: JDom, i: int, k: int) -> int:
    if j_kind(dom, i) != J_ARR():
        return -1
    if k < 0 or k >= j_ival(dom, i):
        return -1
    buf = load_i64(dom.slab + i * 40 + 24)
    return load_i64(buf + k * 8)

# the k-th KEY node index of an object; -1 when out of range
def j_obj_key_idx(dom: JDom, i: int, k: int) -> int:
    if j_kind(dom, i) != J_OBJ():
        return -1
    if k < 0 or k >= j_ival(dom, i):
        return -1
    kbuf = load_i64(dom.slab + i * 40 + 32)
    return load_i64(kbuf + k * 8)

# the k-th VALUE node index of an object; -1 when out of range
def j_obj_val_idx(dom: JDom, i: int, k: int) -> int:
    if j_kind(dom, i) != J_OBJ():
        return -1
    if k < 0 or k >= j_ival(dom, i):
        return -1
    vbuf = load_i64(dom.slab + i * 40 + 24)
    return load_i64(vbuf + k * 8)

def j_obj_key(dom: JDom, i: int, k: int) -> string:
    ki = j_obj_key_idx(dom, i, k)
    if ki < 0:
        return ""
    return j_as_str(dom, ki)

# look up a key in an object; returns the value node index or -1
def j_obj_get(dom: JDom, i: int, key: string) -> int:
    if j_kind(dom, i) != J_OBJ():
        return -1
    n = j_ival(dom, i)
    k = 0
    while k < n:
        ki = j_obj_key_idx(dom, i, k)
        if j_as_str(dom, ki) == key:
            return j_obj_val_idx(dom, i, k)
        k = k + 1
    return -1

# ---- typed getters with defaults (the "field absent or null" path) ----

def j_get_str(dom: JDom, i: int, key: string, dflt: string) -> string:
    c = j_obj_get(dom, i, key)
    if c < 0:
        return dflt
    if j_kind(dom, c) == J_STR():
        return j_as_str(dom, c)
    return dflt

def j_get_int(dom: JDom, i: int, key: string, dflt: int) -> int:
    c = j_obj_get(dom, i, key)
    if c < 0:
        return dflt
    k = j_kind(dom, c)
    if k == J_INT():
        return j_ival(dom, c)
    if k == J_FLOAT():
        return to_int(j_fval(dom, c))
    return dflt

def j_get_float(dom: JDom, i: int, key: string, dflt: float) -> float:
    c = j_obj_get(dom, i, key)
    if c < 0:
        return dflt
    k = j_kind(dom, c)
    if k == J_FLOAT():
        return j_fval(dom, c)
    if k == J_INT():
        return to_float(j_ival(dom, c))
    return dflt

def j_get_bool(dom: JDom, i: int, key: string, dflt: bool) -> bool:
    c = j_obj_get(dom, i, key)
    if c < 0:
        return dflt
    if j_kind(dom, c) == J_BOOL():
        return j_as_bool(dom, c)
    return dflt

# k-th element of an array-of-strings ("data" lists)
def j_arr_str(dom: JDom, i: int, k: int, dflt: string) -> string:
    c = j_arr_get(dom, i, k)
    if c < 0:
        return dflt
    if j_kind(dom, c) == J_STR():
        return j_as_str(dom, c)
    return dflt

def j_arr_int(dom: JDom, i: int, k: int, dflt: int) -> int:
    c = j_arr_get(dom, i, k)
    if c < 0:
        return dflt
    if j_kind(dom, c) == J_INT():
        return j_ival(dom, c)
    return dflt

# ============================================================
# parser (recursive descent, write-back)
# ============================================================

struct JParse:
    src: string
    sn: int        # len(src), computed ONCE — see j_at
    pos: int
    dom: JDom
    err: int       # 0 = ok, 1 = failed (first error wins)
    errmsg: string
    res: int       # extra result channel (hex escape value, ...)

# The end-of-input test needs the source length, and `len()` on a string IS
# strlen AT EVERY USE SITE (codegen emits __builtin_strlen inline). Testing it
# here made the whole parser O(n^2): every character of every token paid a full
# scan of the remaining document. Measured at -O3, identical shape, doubling the
# document quadrupled the time (13 KB 19 ms, 30 KB 84 ms, 62 KB 343 ms,
# 126 KB 1421 ms, 266 KB 7064 ms) and a 266 KB response took 7 s. The length is
# a pure function of the immutable `src`, so it is computed once at the entry
# point and carried here; `j_parse`/`j_parse_into` are the only constructors.
def j_at(p: JParse) -> int:
    if p.pos >= p.sn:
        return -1
    return load_u8(p.src, p.pos)

def jp_fail(p: JParse, msg: string) -> JParse:
    if p.err == 0:
        p.err = 1
        p.errmsg = msg + " (at " + str(p.pos) + ")"
    return p

def jp_ws(p: JParse) -> JParse:
    c = j_at(p)
    while c == 32 or c == 9 or c == 10 or c == 13:
        p.pos = p.pos + 1
        c = j_at(p)
    return p

# ---- values ----

def jp_value(p: JParse) -> JParse:
    p = jp_ws(p)
    c = j_at(p)
    if c == 123:
        return jp_obj(p)
    if c == 91:
        return jp_arr(p)
    if c == 34:
        return jp_str(p)
    if c == 45 or (c >= 48 and c <= 57):
        return jp_num(p)
    if c == 116:
        return jp_lit(p, "true", J_BOOL(), 1, 0.0)
    if c == 102:
        return jp_lit(p, "false", J_BOOL(), 0, 0.0)
    if c == 110:
        return jp_lit(p, "null", J_NULL(), 0, 0.0)
    return jp_fail(p, "unexpected character")

# match a keyword literal and push its node
def jp_lit(p: JParse, word: string, kind: int, ival: int, fval: float) -> JParse:
    n = len(word)
    i = 0
    while i < n:
        if j_at(p) != load_u8(word, i):
            return jp_fail(p, "bad literal")
        p.pos = p.pos + 1
        i = i + 1
    dom = jdom_push(p.dom, kind, ival, fval, 0, 0)
    return JParse(src=p.src, sn=p.sn, pos=p.pos, dom=dom, err=p.err, errmsg=p.errmsg, res=p.res)

# ---- strings ----

# read 4 hex digits; value in p.res (-1 on bad digit; caller fails)
def jp_hex4(p: JParse) -> JParse:
    v = 0
    i = 0
    while i < 4:
        c = j_at(p)
        if c >= 48 and c <= 57:
            d = c - 48
        elif c >= 97 and c <= 102:
            d = c - 87
        elif c >= 65 and c <= 70:
            d = c - 55
        else:
            p.res = -1
            return p
        v = v * 16 + d
        p.pos = p.pos + 1
        i = i + 1
    p.res = v
    return p

# parse a JSON string (opening quote at p.pos). The output buffer is at most
# the source length: every output byte consumes at least one input byte
# (escapes shrink, `\uXXXX` is 6 bytes -> <= 3 UTF-8 bytes, a surrogate pair
# is 12 -> 4).
#
# The buffer is sized from what is LEFT of the input and then grown
# geometrically, NOT allocated at `len(src)` up front. The old spelling made
# every string allocate the whole document, and strings are never freed by
# design (see the header): a 330 KB document with 20 000 strings pushed 6.29 GB
# of allocator traffic through a 325 MB peak at ~33 KB/s. The amortized cost
# of doubling is identical, and the peak becomes the sum of the actual string
# lengths. `+ 8` is headroom: one iteration stores at most 4 bytes
# (`net_cp_utf8`), and it is re-checked before every store.
def JP_STR_CHUNK() -> int:
    return 64

def jp_str(p: JParse) -> JParse:
    p.pos = p.pos + 1
    cap = p.sn - p.pos
    if cap > JP_STR_CHUNK():
        cap = JP_STR_CHUNK()
    if cap < 32:
        cap = 32
    out = malloc(cap + 8)
    oi = 0
    while True:
        if oi + 8 > cap:
            cap = cap * 2
            out = realloc(out, cap + 8)
        c = j_at(p)
        if c == -1:
            return jp_fail(p, "unterminated string")
        if c == 34:
            p.pos = p.pos + 1
            store_u8(out, oi, 0)
            dom = jdom_push(p.dom, J_STR(), 0, 0.0, out, 0)
            return JParse(src=p.src, sn=p.sn, pos=p.pos, dom=dom, err=p.err, errmsg=p.errmsg, res=p.res)
        if c == 92:
            p.pos = p.pos + 1
            e = j_at(p)
            if e == 34:
                store_u8(out, oi, 34)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 92:
                store_u8(out, oi, 92)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 47:
                store_u8(out, oi, 47)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 98:
                store_u8(out, oi, 8)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 102:
                store_u8(out, oi, 12)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 110:
                store_u8(out, oi, 10)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 114:
                store_u8(out, oi, 13)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 116:
                store_u8(out, oi, 9)
                oi = oi + 1
                p.pos = p.pos + 1
            elif e == 117:
                p.pos = p.pos + 1
                p = jp_hex4(p)
                if p.res < 0:
                    return jp_fail(p, "bad \\u escape")
                cp = p.res
                if cp >= 55296 and cp < 56320:
                    # high surrogate: a \uDC00-\uDFFF must follow
                    if j_at(p) == 92 and load_u8(p.src, p.pos + 1) == 117:
                        p.pos = p.pos + 2
                        p = jp_hex4(p)
                        if p.res < 0:
                            return jp_fail(p, "bad \\u escape")
                        lo = p.res
                        if lo >= 56320 and lo < 57344:
                            cp = 65536 + (cp - 55296) * 1024 + (lo - 56320)
                        else:
                            return jp_fail(p, "lone surrogate")
                    else:
                        return jp_fail(p, "lone surrogate")
                elif cp >= 56320 and cp < 57344:
                    return jp_fail(p, "lone surrogate")
                m = net_cp_utf8(cp, out + oi)
                oi = oi + m
            else:
                return jp_fail(p, "bad escape")
        else:
            store_u8(out, oi, c)
            oi = oi + 1
            p.pos = p.pos + 1
    # unreachable: every loop path returns; the checker needs a tail return
    return jp_fail(p, "unterminated string")

# ---- numbers ----

# the exponent ceiling `j_num_float` clamps at. 400 decimal places is far
# past the double range (the last finite is ~1.8e308), so the clamped answer
# is the IEEE one -- inf, 0.0 or a subnormal -- and the scaling loop stays
# bounded at 400 iterations.
def J_MAX_EXP() -> int:
    return 400

# pure: the mantissa/exponent text of a JSON number -> float
def j_num_float(s: string) -> float:
    i = 0
    neg = False
    if load_u8(s, 0) == 45:
        neg = True
        i = 1
    m = 0.0
    while i < len(s):
        c = load_u8(s, i)
        if c >= 48 and c <= 57:
            m = m * 10.0 + to_float(c - 48)
            i = i + 1
        else:
            break
    if i < len(s) and load_u8(s, i) == 46:
        i = i + 1
        scale = 0.1
        while i < len(s):
            c = load_u8(s, i)
            if c >= 48 and c <= 57:
                m = m + to_float(c - 48) * scale
                scale = scale * 0.1
                i = i + 1
            else:
                break
    if i < len(s) and (load_u8(s, i) == 101 or load_u8(s, i) == 69):
        i = i + 1
        eneg = False
        if i < len(s) and load_u8(s, i) == 43:
            i = i + 1
        else:
            if i < len(s) and load_u8(s, i) == 45:
                eneg = True
                i = i + 1
        e = 0
        while i < len(s):
            c = load_u8(s, i)
            if c >= 48 and c <= 57:
                # Clamp while accumulating. A double saturates to inf/0 long
                # before 10^400, so nothing above that is distinguishable --
                # but the digit run itself used to be unbounded, which made
                # `1e999999999` spin the scaling loop below for minutes (a DoS
                # on any untrusted JSON: an API response, a user file). The
                # accumulator could also wrap past i64 and come back SMALL,
                # so the clamp has to be here, not only on the loop.
                if e < J_MAX_EXP():
                    e = e * 10 + (c - 48)
                    if e > J_MAX_EXP():
                        e = J_MAX_EXP()
                i = i + 1
            else:
                break
        k = 0
        while k < e:
            if eneg:
                m = m / 10.0
            else:
                m = m * 10.0
            k = k + 1
    if neg:
        return -m
    return m

def jp_num(p: JParse) -> JParse:
    start = p.pos
    isf = 0
    c = j_at(p)
    if c == 45:
        p.pos = p.pos + 1
    c = j_at(p)
    if c < 48 or c > 57:
        return jp_fail(p, "bad number")
    while True:
        c = j_at(p)
        if c >= 48 and c <= 57:
            p.pos = p.pos + 1
        else:
            break
    if j_at(p) == 46:
        isf = 1
        p.pos = p.pos + 1
        while True:
            c = j_at(p)
            if c >= 48 and c <= 57:
                p.pos = p.pos + 1
            else:
                break
    c = j_at(p)
    if c == 101 or c == 69:
        isf = 1
        p.pos = p.pos + 1
        c = j_at(p)
        if c == 43 or c == 45:
            p.pos = p.pos + 1
        while True:
            c = j_at(p)
            if c >= 48 and c <= 57:
                p.pos = p.pos + 1
            else:
                break
    text = str_sub(p.src, start, p.pos)
    if isf == 0:
        v = 0
        neg = 0
        i = 0
        if load_u8(text, 0) == 45:
            neg = 1
            i = 1
        while i < len(text):
            v = v * 10 + (load_u8(text, i) - 48)
            i = i + 1
        if neg == 1:
            v = -v
        dom = jdom_push(p.dom, J_INT(), v, 0.0, 0, 0)
    else:
        f = j_num_float(text)
        dom = jdom_push(p.dom, J_FLOAT(), 0, f, 0, 0)
    return JParse(src=p.src, sn=p.sn, pos=p.pos, dom=dom, err=p.err, errmsg=p.errmsg, res=p.res)

# ---- arrays ----

def jp_arr(p: JParse) -> JParse:
    p.pos = p.pos + 1
    kids = vec_new()
    p = jp_ws(p)
    if j_at(p) == 93:
        p.pos = p.pos + 1
        dom = jdom_push(p.dom, J_ARR(), kids.len, 0.0, kids.data, 0)
        return JParse(src=p.src, sn=p.sn, pos=p.pos, dom=dom, err=p.err, errmsg=p.errmsg, res=p.res)
    while True:
        p = jp_value(p)
        if p.err == 1:
            return p
        kids = vec_push(kids, p.dom.last)
        p = jp_ws(p)
        c = j_at(p)
        if c == 44:
            p.pos = p.pos + 1
        elif c == 93:
            p.pos = p.pos + 1
            dom = jdom_push(p.dom, J_ARR(), kids.len, 0.0, kids.data, 0)
            return JParse(src=p.src, sn=p.sn, pos=p.pos, dom=dom, err=p.err, errmsg=p.errmsg, res=p.res)
        else:
            return jp_fail(p, "expected ',' or ']' in array")
    # unreachable: every loop path returns; the checker needs a tail return
    return jp_fail(p, "expected ',' or ']' in array")

# ---- objects ----

def jp_obj(p: JParse) -> JParse:
    p.pos = p.pos + 1
    keys = vec_new()
    vals = vec_new()
    p = jp_ws(p)
    if j_at(p) == 125:
        p.pos = p.pos + 1
        dom = jdom_push(p.dom, J_OBJ(), vals.len, 0.0, vals.data, keys.data)
        return JParse(src=p.src, sn=p.sn, pos=p.pos, dom=dom, err=p.err, errmsg=p.errmsg, res=p.res)
    while True:
        p = jp_ws(p)
        if j_at(p) != 34:
            return jp_fail(p, "expected string key in object")
        p = jp_str(p)
        if p.err == 1:
            return p
        keys = vec_push(keys, p.dom.last)
        p = jp_ws(p)
        if j_at(p) != 58:
            return jp_fail(p, "expected ':' in object")
        p.pos = p.pos + 1
        p = jp_value(p)
        if p.err == 1:
            return p
        vals = vec_push(vals, p.dom.last)
        p = jp_ws(p)
        c = j_at(p)
        if c == 44:
            p.pos = p.pos + 1
        elif c == 125:
            p.pos = p.pos + 1
            dom = jdom_push(p.dom, J_OBJ(), vals.len, 0.0, vals.data, keys.data)
            return JParse(src=p.src, sn=p.sn, pos=p.pos, dom=dom, err=p.err, errmsg=p.errmsg, res=p.res)
        else:
            return jp_fail(p, "expected ',' or '}' in object")
    # unreachable: every loop path returns; the checker needs a tail return
    return jp_fail(p, "expected ',' or '}' in object")

# parse a complete JSON document; the root node is `p.dom.last`. On failure
# `p.err` is 1 and `p.errmsg` carries the message.
def j_parse(src: string) -> JParse:
    return j_parse_into(jdom_new(), src)

# the same parse, but the nodes are APPENDED to a dom that already has
# content instead of starting a fresh one. This is what lets the builder
# below splice a hand-written fragment (`input_schema`, a tool input echoed
# back verbatim) into a larger document: the fragment's nodes land in the
# SAME slab, so their child indices are already correct and no remapping is
# needed. `p.dom.last` is the fragment's root.
def j_parse_into(dom: JDom, src: string) -> JParse:
    p = JParse(src=src, sn=len(src), pos=0, dom=dom, err=0, errmsg="", res=0)
    p = jp_value(p)
    if p.err == 1:
        return p
    p = jp_ws(p)
    if j_at(p) != -1:
        return jp_fail(p, "trailing data after JSON value")
    return p

# ============================================================
# serializer
# ============================================================

# float -> JSON number text, %.15g-ish: up to 15 significant digits, no
# trailing zeros. printf/snprintf is NOT usable here — Aoxn externs are
# fixed-arity, and a variadic callee probed through a fixed prototype reads
# its float varargs from register spill slots the caller never filled.
# Layout: |f| < 1e-15 or >= 1e15 falls back to mantissa/exponent spelling;
# inside the window the fraction is extracted as one i64 (16 digits), rounded
# to 15, and printed with the point inserted (trailing zeros trimmed).
def j_fmt_f(f: float) -> string:
    if f == 0.0:
        return "0"
    sign = ""
    m = f
    if m < 0.0:
        sign = "-"
        m = -m
    if m >= 1000000000000000000.0:
        # above i64 range: exponent spelling (to_int would wrap)
        e = 0
        while m >= 10.0:
            m = m / 10.0
            e = e + 1
        return sign + j_fmt_f(m) + "e" + str(e)
    if m >= 1000000000000000.0:
        # the fraction is below the 15-digit window; the i64 part is exact
        return sign + str(to_int(m))
    if m < 0.000000000000001:
        e = 0
        while m < 1.0:
            m = m * 10.0
            e = e - 1
        while m >= 10.0:
            m = m / 10.0
            e = e + 1
        return sign + j_fmt_f(m) + "e" + str(e)
    ip = to_int(m)
    n = to_int((m - to_float(ip)) * 10000000000000000.0)
    n = (n + 5) / 10
    if n >= 1000000000000000:
        # rounding carried into the integer part ("0.99995..." -> "1")
        ip = ip + 1
        n = 0
    out = sign + str(ip)
    if n == 0:
        return out
    out = out + "."
    # 15 fraction digits, zero-padded, trailing zeros trimmed
    buf = malloc(16)
    i = 14
    while i >= 0:
        store_u8(buf, i, 48 + n % 10)
        n = n / 10
        i = i - 1
    last = 14
    while last >= 0 and load_u8(buf, last) == 48:
        last = last - 1
    store_u8(buf, last + 1, 0)
    return out + as_string(buf)

# A byte sink for the serializer. The language has no address-of, so the write
# cursor travels BY VALUE and every append hands the struct back — the same
# write-back discipline `JParse` and `Vec` use. Growing geometrically keeps
# the whole serialize linear in the output size.
struct JOut:
    buf: int
    n: int
    cap: int

def jw_reserve(w: JOut, need: int) -> JOut:
    if w.n + need + 1 <= w.cap:
        return w
    newcap = w.cap * 2
    if newcap < w.n + need + 1:
        newcap = w.n + need + 1
    if newcap == 0:
        newcap = 64
    w.buf = realloc(w.buf, newcap)
    w.cap = newcap
    return w

def jw_byte(w: JOut, c: int) -> JOut:
    w = jw_reserve(w, 1)
    store_u8(w.buf, w.n, c)
    w.n = w.n + 1
    return w

def jw_str(w: JOut, s: string) -> JOut:
    n = len(s)
    w = jw_reserve(w, n)
    i = 0
    while i < n:
        store_u8(w.buf, w.n + i, load_u8(s, i))
        i = i + 1
    w.n = w.n + n
    return w

# escape a string into a JSON string literal (WITH the surrounding quotes),
# appending into the sink. Control bytes below 32 become \u00XX except the
# named \b \f \n \r \t. Bytes >= 128 pass through: JSON text is UTF-8, and so
# are Aoxn strings.
def jw_quote(w: JOut, s: string) -> JOut:
    w = jw_byte(w, 34)
    n = len(s)
    i = 0
    while i < n:
        c = load_u8(s, i)
        if c == 34:
            w = jw_byte(w, 92)
            w = jw_byte(w, 34)
        elif c == 92:
            w = jw_byte(w, 92)
            w = jw_byte(w, 92)
        elif c == 10:
            w = jw_byte(w, 92)
            w = jw_byte(w, 110)
        elif c == 13:
            w = jw_byte(w, 92)
            w = jw_byte(w, 114)
        elif c == 9:
            w = jw_byte(w, 92)
            w = jw_byte(w, 116)
        elif c == 8:
            w = jw_byte(w, 92)
            w = jw_byte(w, 98)
        elif c == 12:
            w = jw_byte(w, 92)
            w = jw_byte(w, 102)
        elif c < 32:
            w = jw_byte(w, 92)
            w = jw_byte(w, 117)
            w = jw_byte(w, 48)
            w = jw_byte(w, 48)
            w = jw_byte(w, net_hex_digit(c / 16))
            w = jw_byte(w, net_hex_digit(c % 16))
        else:
            w = jw_byte(w, c)
        i = i + 1
    w = jw_byte(w, 34)
    return w

# the single-string form, which is what the BUILDER below routes through.
# Pre-reserved at the worst case (every byte a \u00XX) so it stays one alloc.
def j_quote(s: string) -> string:
    w = JOut(buf=0, n=0, cap=0)
    w = jw_reserve(w, len(s) * 6 + 3)
    w = jw_quote(w, s)
    store_u8(w.buf, w.n, 0)
    return as_string(w.buf)

# serialize a node into the sink. ONE pass with geometric growth, not repeated
# `out = out + ...`: string concatenation allocates a fresh buffer per step and
# abandons the old one, so an n-element container cost O(n^2) allocations AND
# O(n^2) bytes leaked. Measured at -O3 on a 20000-key response, the old
# serializer touched 8.6 GB and took 28 s.
def jw_value(w: JOut, dom: JDom, i: int) -> JOut:
    k = j_kind(dom, i)
    if k == J_STR():
        return jw_quote(w, j_as_str(dom, i))
    if k == J_INT():
        return jw_str(w, str(j_ival(dom, i)))
    if k == J_FLOAT():
        return jw_str(w, j_fmt_f(j_fval(dom, i)))
    if k == J_BOOL():
        if j_ival(dom, i) == 1:
            return jw_str(w, "true")
        return jw_str(w, "false")
    if k == J_ARR():
        w = jw_byte(w, 91)
        n = j_ival(dom, i)
        k2 = 0
        while k2 < n:
            if k2 > 0:
                w = jw_byte(w, 44)
            w = jw_value(w, dom, j_arr_get(dom, i, k2))
            k2 = k2 + 1
        w = jw_byte(w, 93)
        return w
    if k == J_OBJ():
        w = jw_byte(w, 123)
        n = j_ival(dom, i)
        k2 = 0
        while k2 < n:
            if k2 > 0:
                w = jw_byte(w, 44)
            w = jw_quote(w, j_obj_key(dom, i, k2))
            w = jw_byte(w, 58)
            w = jw_value(w, dom, j_obj_val_idx(dom, i, k2))
            k2 = k2 + 1
        w = jw_byte(w, 125)
        return w
    return jw_str(w, "null")

# serialize a node back to a JSON text string (compact, no whitespace)
def j_dumps(dom: JDom, i: int) -> string:
    w = JOut(buf=0, n=0, cap=0)
    w = jw_value(w, dom, i)
    w = jw_reserve(w, 1)
    store_u8(w.buf, w.n, 0)
    return as_string(w.buf)

# convenience: parse then serialize (round-trip check)
def j_roundtrip(src: string) -> string:
    p = j_parse(src)
    if p.err == 1:
        return ""
    return j_dumps(p.dom, p.dom.last)

# ============================================================
# builder (the other direction: DOM -> JSON text)
# ============================================================
#
# The parser answers "what does this JSON say"; the builder answers "make me
# this JSON". It exists because the Anthropic SDK (v0.41.0) has to EMIT
# nested structures — a tool's input_schema, a tool_use block's `input`, a
# metadata object — and hand-assembling those as escaped string literals is
# where a missing backslash turns into a 400 from the server. Everything
# below routes through `j_quote`, so escaping is the parser's problem again.
#
# It writes into the SAME slab the parser produces, so a built DOM can be
# read with every accessor above and serialized with `j_dumps`. A builder
# node and a parsed node are the same thing; only their provenance differs.
#
# Capacity lives in the +16 slot of an ARR/OBJ node, which the parser leaves
# at 0.0 because neither kind stores a float there. `j_fval` on such a node
# is meaningless anyway (floats live in FLOAT nodes), so nothing that read
# the DOM before can be confused by it. A node the PARSER made has capacity
# 0 and no child buffers sized for appending, so `jb_grow` treats 0 as "give
# me the default" — a parsed object can still be extended, just not for free.

def JB_MIN_CAP() -> int:
    return 8

# the capacity a grown node must reach. The floor is the LIVE CHILD COUNT, and
# that floor is load-bearing: a node the PARSER made adopted a Vec's buffer
# but left its stored capacity at 0, so "0 means give me the default" used to
# mean 8 — and reallocating a 32-slot (256 byte) buffer DOWN to 16 (128 bytes)
# then writing slot 20 walked off the end. Any parsed object or array with 16+
# members crashed with 0xC0000005 the first time a field was added to it, which
# is exactly what `jb_set_raw` exists to do (see the AGENTS.md splice pattern).
# `n + 1` is the one quantity that is always known, and 2*(n+1) > n means the
# store the caller is about to make always lands inside the block.
def jb_grow_cap(base: int) -> int:
    n = load_i64(base + 8)
    cap = to_int(load_f64(base + 16))
    if cap < n + 1:
        cap = n + 1
    return cap * 2

# make room for one more child on node `i`, doubling from its stored
# capacity. Objects move BOTH buffers (values then keys); arrays move one.
def jb_grow_arr(dom: JDom, i: int) -> JDom:
    base = dom.slab + i * 40
    newcap = jb_grow_cap(base)
    store_i64(base + 24, realloc(load_i64(base + 24), newcap * 8))
    store_f64(base + 16, to_float(newcap))
    return dom

def jb_grow_obj(dom: JDom, i: int) -> JDom:
    base = dom.slab + i * 40
    newcap = jb_grow_cap(base)
    store_i64(base + 24, realloc(load_i64(base + 24), newcap * 8))
    store_i64(base + 32, realloc(load_i64(base + 32), newcap * 8))
    store_f64(base + 16, to_float(newcap))
    return dom

# push an empty object; its index lands in `dom.last`
def jb_obj(dom: JDom) -> JDom:
    dom = jdom_push(dom, J_OBJ(), 0, 0.0, malloc(JB_MIN_CAP() * 8), malloc(JB_MIN_CAP() * 8))
    store_f64(dom.slab + dom.last * 40 + 16, to_float(JB_MIN_CAP()))
    return dom

# push an empty array; its index lands in `dom.last`
def jb_arr(dom: JDom) -> JDom:
    dom = jdom_push(dom, J_ARR(), 0, 0.0, malloc(JB_MIN_CAP() * 8), 0)
    store_f64(dom.slab + dom.last * 40 + 16, to_float(JB_MIN_CAP()))
    return dom

# append the node `child` (an existing index) to the array `i`
def jb_push(dom: JDom, i: int, child: int) -> JDom:
    if j_kind(dom, i) != J_ARR():
        return dom
    base = dom.slab + i * 40
    n = load_i64(base + 8)
    cap = to_int(load_f64(base + 16))
    if n >= cap:
        dom = jb_grow_arr(dom, i)
        base = dom.slab + i * 40
    store_i64(load_i64(base + 24) + n * 8, child)
    store_i64(base + 8, n + 1)
    return dom

# append `key` = node `child` to the object `i`. A duplicate key is appended
# like any other — JSON objects are not maps here, and a repeated key is the
# caller's bug, not something to silently paper over.
def jb_set(dom: JDom, i: int, key: string, child: int) -> JDom:
    if j_kind(dom, i) != J_OBJ():
        return dom
    base = dom.slab + i * 40
    n = load_i64(base + 8)
    cap = to_int(load_f64(base + 16))
    if n >= cap:
        dom = jb_grow_obj(dom, i)
    dom = jdom_push(dom, J_STR(), 0, 0.0, as_ptr(key), 0)
    ki = dom.last
    base = dom.slab + i * 40
    store_i64(load_i64(base + 32) + n * 8, ki)
    store_i64(load_i64(base + 24) + n * 8, child)
    store_i64(base + 8, n + 1)
    return dom

# ---- leaf nodes ----

def jb_null(dom: JDom) -> JDom:
    return jdom_push(dom, J_NULL(), 0, 0.0, 0, 0)

def jb_bool(dom: JDom, v: bool) -> JDom:
    if v:
        return jdom_push(dom, J_BOOL(), 1, 0.0, 0, 0)
    return jdom_push(dom, J_BOOL(), 0, 0.0, 0, 0)

def jb_int(dom: JDom, v: int) -> JDom:
    return jdom_push(dom, J_INT(), v, 0.0, 0, 0)

def jb_num(dom: JDom, v: float) -> JDom:
    return jdom_push(dom, J_FLOAT(), 0, v, 0, 0)

# a string node aliases `s` directly — strings are immutable and shared, and
# the builder does not outlive the caller's buffer anyway
def jb_str(dom: JDom, s: string) -> JDom:
    return jdom_push(dom, J_STR(), 0, 0.0, as_ptr(s), 0)

# ---- typed object members (build the child, then attach it) ----

def jb_set_null(dom: JDom, i: int, key: string) -> JDom:
    dom = jb_null(dom)
    return jb_set(dom, i, key, dom.last)

def jb_set_bool(dom: JDom, i: int, key: string, v: bool) -> JDom:
    dom = jb_bool(dom, v)
    return jb_set(dom, i, key, dom.last)

def jb_set_int(dom: JDom, i: int, key: string, v: int) -> JDom:
    dom = jb_int(dom, v)
    return jb_set(dom, i, key, dom.last)

def jb_set_num(dom: JDom, i: int, key: string, v: float) -> JDom:
    dom = jb_num(dom, v)
    return jb_set(dom, i, key, dom.last)

def jb_set_str(dom: JDom, i: int, key: string, v: string) -> JDom:
    dom = jb_str(dom, v)
    return jb_set(dom, i, key, dom.last)

# attach a member whose value is raw JSON text. The text is PARSED INTO THE
# SAME SLAB (j_parse_into), so it nests like any other value and every escape
# inside it is validated — an `input_schema` written by hand, or a tool input
# echoed back verbatim, both land here. Unparseable text attaches nothing,
# leaving the key absent rather than emitting something invalid.
#
# `p.dom`, never `dom`, is what goes on: parsing grows the slab, and
# realloc frees the buffer the stale `dom.slab` still points at.
def jb_set_raw(dom: JDom, i: int, key: string, json_text: string) -> JDom:
    p = j_parse_into(dom, json_text)
    if p.err == 1:
        return p.dom
    return jb_set(p.dom, i, key, p.dom.last)

# append a raw JSON text as an array element (same parsing rule as above)
def jb_push_raw(dom: JDom, i: int, json_text: string) -> JDom:
    p = j_parse_into(dom, json_text)
    if p.err == 1:
        return p.dom
    return jb_push(p.dom, i, p.dom.last)


# ============================================================
# file I/O (the v0.44.0 promotion's addition)
# ============================================================

def j_readable(path: string) -> bool:
    f = fopen(path, "rb")
    if f == 0:
        return False
    fclose(f)
    return True

# parse a whole file. err: 0 = ok, 1 = parse error, 2 = I/O failure
# (missing/unreadable file — read_file() hands back "" and the parser
# reports the empty document, so the fopen probe here upgrades the cause;
# an EMPTY but readable file still reports 1, which is the honest error).
def j_read_file(path: string) -> JParse:
    p = j_parse(read_file(path))
    if p.err == 1 and not j_readable(path):
        p.err = 2
    return p

# serialize one DOM node to a file (pretty-free, compact spelling)
def j_write_file(path: string, dom: JDom, i: int) -> bool:
    return write_file(path, j_dumps(dom, i))
