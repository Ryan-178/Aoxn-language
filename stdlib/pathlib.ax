# Aoxn standard library — pathlib (v0.44.0, docs/stdlib-todo.md #2).
#
# Path manipulation as PURE STRING OPERATIONS — no filesystem access lives
# here (that is stdlib/os.ax). Both separators (`/` and `\`) are recognized
# everywhere on INPUT, because a Windows path may carry either; results
# never change what they do not touch. Python-parity names: parent / name /
# stem / suffix / join, spelled `path_*` (Aoxn's flat namespace).
#
# What a function BUILDS is platform-native, though, and that asymmetry is
# the whole point: `path_is_sep` accepts both separators, but a path that
# JOINS two components must come out spelled the way the platform spells
# paths, or it names a different path — `os_exists("sandbox\sub")` is false
# on Linux. Every join below therefore goes through `path_sep()`. Writing a
# literal `"\\"` into a join is how v0.50.3 found four of them.
#
# A `Path` struct wrapper adds nothing over the functions (Aoxn structs are
# plain data and the functions are already chainable), so this module ships
# the functions only — docs/stdlib-todo.md #2's "os.path 兼容门面" role.
#
# Plain Aoxn only (no dict/None/fn-ptr/raise): self-host compilable.

import * from "stdlib.ax"

def SEP_F() -> int:
    return 47  # '/'

def SEP_B() -> int:
    return 92  # '\'

def path_is_sep(c: int) -> bool:
    return c == SEP_F() or c == SEP_B()

# the separator this platform's paths are spelled with, as a byte
def path_sep_byte() -> int:
    if target_os() == "windows":
        return SEP_B()
    return SEP_F()

# ...and as a one-character string. The language has no chr(), and the byte
# is written through a two-byte buffer the way dt_chr does it in datetime.ax.
def path_sep() -> string:
    p = malloc(2)
    store_u8(p, 0, path_sep_byte())
    store_u8(p, 1, 0)
    return as_string(p)

# the final component, "" when the path ends in a separator
def path_name(p: string) -> string:
    i = len(p) - 1
    while i >= 0:
        if path_is_sep(str_get(p, i)):
            return str_sub(p, i + 1, len(p))
        i = i - 1
    return p

# everything before the final component ("" when there is no separator;
# the separator itself is dropped, like Python's os.path.dirname)
def path_parent(p: string) -> string:
    i = len(p) - 1
    while i >= 0:
        if path_is_sep(str_get(p, i)):
            return str_sub(p, 0, i)
        i = i - 1
    return ""

# absolute in the Windows sense: drive letter prefix or a leading separator
def path_is_abs(p: string) -> bool:
    if len(p) == 0:
        return False
    if path_is_sep(str_get(p, 0)):
        return True
    # "C:" or "C:\..." — a colon before the first separator
    i = 0
    pn = len(p)
    while i < pn and i < 3:
        c = str_get(p, i)
        if c == 58:
            return True
        if path_is_sep(c):
            return False
        i = i + 1
    return False

# join: an absolute (or empty) right side wins, otherwise a separator is
# inserted when `a` does not already end with one
def path_join(a: string, b: string) -> string:
    if len(b) == 0:
        return a
    if path_is_abs(b):
        return b
    if len(a) == 0:
        return b
    if path_is_sep(str_get(a, len(a) - 1)):
        return a + b
    return a + path_sep() + b

# the suffix WITH its dot (".txt"), or "" when the final component has no
# extension; a leading dot ("." ".." ".gitignore") is a name, not a suffix
def path_suffix(p: string) -> string:
    name = path_name(p)
    i = len(name) - 1
    while i >= 0:
        c = str_get(name, i)
        if c == 46:
            if i == 0:
                return ""
            return str_sub(name, i, len(name))
        if path_is_sep(c):
            return ""
        i = i - 1
    return ""

# the final component without its suffix (and without the dot)
def path_stem(p: string) -> string:
    name = path_name(p)
    suf = path_suffix(p)
    if len(suf) == 0:
        return name
    return str_sub(name, 0, len(name) - len(suf))

# the path with its suffix replaced ("" removes it); a name without a
# suffix gains one
def path_with_suffix(p: string, suffix: string) -> string:
    stem = path_stem(p)
    parent = path_parent(p)
    if len(parent) == 0:
        return stem + suffix
    return parent + path_sep() + stem + suffix

# the path with its final component replaced
def path_with_name(p: string, name: string) -> string:
    parent = path_parent(p)
    if len(parent) == 0:
        return name
    return parent + path_sep() + name

# collapse `//` and `\`, resolve `.` and `..` lexically (no filesystem
# access, no symlink awareness — `..` after a directory the OS may have
# aliased is NOT special-cased, which Python's PurePath does either)
def path_norm(p: string) -> string:
    # keep the root exactly as given, but SPELLED the platform's way: a `/`
    # root stays `/` on Linux and a `\` root stays `\` on Windows, and the
    # UNC form (`\\server\share`) exists only on Windows — on Linux `//` is
    # just the root spelled twice, so it collapses to one separator.
    prefix = ""
    i = 0
    if path_is_abs(p):
        if path_is_sep(str_get(p, 0)):
            if len(p) > 1 and path_is_sep(str_get(p, 1)):
                if target_os() == "windows":
                    prefix = path_sep() + path_sep()
                else:
                    prefix = path_sep()
                i = 2
            else:
                prefix = path_sep()
                i = 1
        else:
            prefix = str_sub(p, 0, 2)
            i = 2
            if i < len(p) and path_is_sep(str_get(p, i)):
                prefix = prefix + path_sep()
                i = i + 1
    # split the rest, drop "." and resolve ".." against a stack of parts
    parts = vec_new()
    pn = len(p)
    while i <= pn:
        j = i
        while j < pn and not path_is_sep(str_get(p, j)):
            j = j + 1
        if j > i:
            part = str_sub(p, i, j)
            if part == "..":
                if parts.len > 0:
                    parts = vec_pop(parts)
                elif not path_is_abs(p):
                    parts = vec_push_str(parts, "..")
            elif part != ".":
                parts = vec_push_str(parts, part)
        i = j + 1
    # join. The old spelling appended with `out = out + ...` per part,
    # which is two allocations (separator + part) copying the whole
    # accumulated path each time: a 65-part path spent ~130 mallocs here
    # and measured 108 us. One sink, a couple of geometric reallocs.
    w = sb_new(len(prefix) + 16)
    w = sb_str(w, prefix)
    k = 0
    while k < parts.len:
        if w.n > 0 and not path_is_sep(load_u8(w.buf, w.n - 1)):
            w = sb_byte(w, path_sep_byte())
        w = sb_str(w, vec_get_str(parts, k))
        k = k + 1
    if w.n == 0:
        return "."
    return sb_text(w)

# (directory, file name) split at the LAST separator — Python's
# os.path.split; the directory keeps no trailing separator except at root
struct PathSplit:
    dir: string
    name: string

def path_split(p: string) -> PathSplit:
    return PathSplit(dir=path_parent(p), name=path_name(p))
