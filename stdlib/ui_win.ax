# Aoxn UI — Windows backend (Win32 + GDI), Qt-flavored immediate mode.
#
# Import this INSTEAD of ui_draw.ax to get the full widget set in one flat
# namespace; ui_draw.ax (the portable widget layer) comes in transitively:
#   import "../stdlib/ui_win.ax"
#   ... Aoxn run app.ax -l user32 -l gdi32
#
# Backend notes (why there are no callbacks anywhere):
#   - The window procedure IS DefWindowProcW (address via GetProcAddress —
#     Aoxn cannot pass function pointers). Messages are drained and
#     dispatched by plat_pump; everything else is POLLED per frame:
#     GetCursorPos + ScreenToClient (mouse), GetAsyncKeyState (buttons and
#     a 256-key snapshot with per-frame edge detection), GetClientRect
#     (resize). Clicking X destroys the window; IsWindow() goes false and
#     the app loop ends.
#   - Drawing is GDI into a memory DC (double buffered, CS_OWNDC) blitted
#     once per frame by plat_present; the class background brush is NULL so
#     nothing else ever erases the window (no flicker).
#   - MsgWaitForMultipleObjects caps idle frames at c.cap_ms (default 15ms
#     ~ 66 fps): the loop sleeps when nothing happens instead of spinning.
#   - All Win32 constants are DECIMAL (no hex literals, no bitwise ops in
#     the language — flags are summed by hand and byte fields are read via
#     i32_at from ui.ax).
#   - exes are console-subsystem (the compiler links the default CRT
#     entry), so plat_init calls FreeConsole() to drop the stray console
#     window. Piped stdout (tests, CI) keeps working: handles stay valid.
#   - GDI's clip region is part of the DC's saved state, so the widget layer's
#     push/pop stack is SaveDC/RestoreDC (st 820/821), one saved handle per
#     level. IntersectClipRect only ever narrows, so re-intersecting on pop
#     could not restore the parent clip — see plat_clip_push.
#
# Widget state lives where the language can express it: with the caller
# (checkbox/slider values are taken and returned) or in the shared heap
# block (ui.ax header documents the slot layout) — never in callbacks.

import * from "./ui_draw.ax"
# ---- C ABI surface (kernel32 + CRT link by default; -l user32 -l gdi32) ----

extern def LoadLibraryA(name: string) -> int
extern def GetProcAddress(mod: int, name: string) -> int
extern def GetModuleHandleW(name: int) -> int
extern def RegisterClassW(wc: int) -> int
extern def CreateWindowExW(ex: int, cls: string, title: string, style: int, x: int, y: int, w: int, h: int, parent: int, menu: int, inst: int, param: int) -> int
extern def ShowWindow(hwnd: int, cmd: int) -> int
extern def DestroyWindow(hwnd: int) -> int
extern def IsWindow(hwnd: int) -> int
extern def GetClientRect(hwnd: int, rect: int) -> int
extern def AdjustWindowRect(rect: int, style: int, menu: int) -> int
extern def GetDC(hwnd: int) -> int
extern def ReleaseDC(hwnd: int, dc: int) -> int
extern def GetCursorPos(pt: int) -> int
extern def ScreenToClient(hwnd: int, pt: int) -> int
extern def GetAsyncKeyState(vk: int) -> int
extern def GetForegroundWindow() -> int
extern def LoadCursorW(inst: int, id: int) -> int
extern def SetProcessDPIAware() -> int
extern def FreeConsole() -> int
extern def MsgWaitForMultipleObjects(n: int, handles: int, all: int, ms: int, mask: int) -> int
extern def PeekMessageW(msg: int, hwnd: int, lo: int, hi: int, remove: int) -> int
# TranslateMessage has no W-suffixed export: its MSG* parameter is
# charset-neutral, and user32.lib only carries the bare name
extern def TranslateMessage(msg: int) -> int
extern def DispatchMessageW(msg: int) -> int
extern def MessageBoxW(parent: int, text: string, caption: string, flags: int) -> int
extern def lstrlenW(s: string) -> int
extern def SetTextAlign(dc: int, mode: int) -> int
extern def CreateCompatibleDC(dc: int) -> int
extern def CreateCompatibleBitmap(dc: int, w: int, h: int) -> int
extern def SelectObject(dc: int, obj: int) -> int
extern def DeleteObject(obj: int) -> int
extern def DeleteDC(dc: int) -> int
extern def BitBlt(dst: int, x: int, y: int, w: int, h: int, src: int, sx: int, sy: int, rop: int) -> int
extern def SetBkMode(dc: int, mode: int) -> int
extern def SetTextColor(dc: int, color: int) -> int
extern def SetDCBrushColor(dc: int, color: int) -> int
extern def SetDCPenColor(dc: int, color: int) -> int
extern def GetStockObject(i: int) -> int
extern def Rectangle(dc: int, l: int, t: int, r: int, b: int) -> int
extern def RoundRect(dc: int, l: int, t: int, r: int, b: int, ew: int, eh: int) -> int
extern def MoveToEx(dc: int, x: int, y: int, prev: int) -> int
extern def LineTo(dc: int, x: int, y: int) -> int
extern def TextOutW(dc: int, x: int, y: int, s: string, n: int) -> int
extern def GetTextExtentPoint32W(dc: int, s: string, n: int, size: int) -> int
extern def CreateFontW(h: int, w: int, esc: int, ori: int, weight: int, italic: int, underline: int, strike: int, charset: int, outp: int, clipp: int, qual: int, pitch: int, face: string) -> int
extern def GetTickCount64() -> int
extern def SaveDC(dc: int) -> int
extern def RestoreDC(dc: int, saved: int) -> int
extern def IntersectClipRect(dc: int, l: int, t: int, r: int, b: int) -> int
extern def Ellipse(dc: int, l: int, t: int, r: int, b: int) -> int
extern def OpenClipboard(owner: int) -> int
extern def CloseClipboard() -> int
extern def EmptyClipboard() -> int
extern def GetClipboardData(fmt: int) -> int
extern def SetClipboardData(fmt: int, hmem: int) -> int
extern def GlobalAlloc(flags: int, size: int) -> int
extern def GlobalLock(hmem: int) -> int
extern def GlobalUnlock(hmem: int) -> int

# ---- backend identity ----

def plat_supported() -> bool:
    return target_os() == "windows"

# monotonic milliseconds — the tooltip hover timer
def plat_now_ms() -> int:
    return GetTickCount64()

# is there a live window AND a live off-screen surface to draw on?
def plat_canvas_ok(c: UI) -> bool:
    return c.open and c.win_dc != 0 and c.mem_dc != 0

# ---- drawing primitives ----
# stock objects used below: NULL_BRUSH=5 NULL_PEN=8 DC_BRUSH=18 DC_PEN=19
#
# ---- DC state cache (v0.47.0) ----
# Every primitive used to re-select both stock objects and both colors on
# every call, so a 40-button frame spent ~300 GDI calls remembering what it
# had already told the DC. Consecutive ops almost always want the same pen,
# brush and color (a table's row separator, a scrollbar's groove, a run of
# labels in one text color), so the backend remembers what is selected:
#   835/836  selected brush / pen object
#   837/838  the DC_BRUSH / DC_PEN colors
#   839      selected font handle
#   840      text color
# Anything that can change the DC behind our back — RestoreDC on a clip pop,
# and swapping the bitmap on a resize — calls dc_cache_drop first. A wrong
# cached value would paint in the wrong color, so the drop list is the short
# list to keep in sync, not the primitives.

def dc_select_brush(c: UI, stock: int):
    if st_get(c, 835) != stock:
        SelectObject(c.mem_dc, GetStockObject(stock))
        st_set(c, 835, stock)

def dc_select_pen(c: UI, stock: int):
    if st_get(c, 836) != stock:
        SelectObject(c.mem_dc, GetStockObject(stock))
        st_set(c, 836, stock)

def dc_brush_color(c: UI, color: int):
    if st_get(c, 837) != color:
        SetDCBrushColor(c.mem_dc, color)
        st_set(c, 837, color)

def dc_pen_color(c: UI, color: int):
    if st_get(c, 838) != color:
        SetDCPenColor(c.mem_dc, color)
        st_set(c, 838, color)

def dc_font(c: UI, f: int):
    if st_get(c, 839) != f:
        SelectObject(c.mem_dc, f)
        st_set(c, 839, f)

def dc_text_color(c: UI, color: int):
    if st_get(c, 840) != color:
        SetTextColor(c.mem_dc, color)
        st_set(c, 840, color)

# the DC is no longer in the state we cached
def dc_cache_drop(c: UI):
    st_set(c, 835, 0)
    st_set(c, 836, 0)
    st_set(c, 837, -1)
    st_set(c, 838, -1)
    st_set(c, 839, 0)
    st_set(c, 840, -1)

def plat_fill_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    dc_select_brush(c, 18)
    dc_brush_color(c, color)
    dc_select_pen(c, 8)
    Rectangle(c.mem_dc, x, y, x + w, y + h)

def plat_frame_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    dc_select_pen(c, 19)
    dc_pen_color(c, color)
    dc_select_brush(c, 5)
    Rectangle(c.mem_dc, x, y, x + w, y + h)

def plat_round_fill(c: UI, x: int, y: int, w: int, h: int, fill: int, border: int):
    dc_select_brush(c, 18)
    dc_brush_color(c, fill)
    dc_select_pen(c, 19)
    dc_pen_color(c, border)
    RoundRect(c.mem_dc, x, y, x + w, y + h, 8, 8)

# filled ellipse with a ring around it (radio button body)
def plat_ellipse(c: UI, x: int, y: int, w: int, h: int, fill: int, border: int):
    dc_select_brush(c, 18)
    dc_brush_color(c, fill)
    dc_select_pen(c, 19)
    dc_pen_color(c, border)
    Ellipse(c.mem_dc, x, y, x + w, y + h)

# filled ellipse, no outline (radio button dot)
def plat_ellipse_fill(c: UI, x: int, y: int, w: int, h: int, fill: int):
    dc_select_brush(c, 18)
    dc_brush_color(c, fill)
    dc_select_pen(c, 8)
    Ellipse(c.mem_dc, x, y, x + w, y + h)

def plat_line(c: UI, x1: int, y1: int, x2: int, y2: int, color: int):
    dc_select_pen(c, 19)
    dc_pen_color(c, color)
    MoveToEx(c.mem_dc, x1, y1, 0)
    LineTo(c.mem_dc, x2, y2)

def plat_text(c: UI, x: int, y: int, s: string, color: int):
    plat_text_sub(c, x, y, s, 0, len(s), color)

def plat_text_big(c: UI, x: int, y: int, s: string, color: int):
    dc_font(c, c.font_big)
    dc_text_color(c, color)
    p = utf16f(c, s)
    TextOutW(c.mem_dc, x, y, as_string(p), lstrlenW(as_string(p)))

def plat_text_sub(c: UI, x: int, y: int, s: string, f: int, t: int, color: int):
    dc_font(c, c.font)
    dc_text_color(c, color)
    p = utf16f_sub(c, s, f, t)
    TextOutW(c.mem_dc, x, y, as_string(p), lstrlenW(as_string(p)))

def plat_measure(c: UI, s: string) -> TextSize:
    return plat_measure_sub(c, s, 0, len(s))

def plat_measure_sub(c: UI, s: string, f: int, t: int) -> TextSize:
    dc_font(c, c.font)
    p = utf16f_sub(c, s, f, t)
    n = lstrlenW(as_string(p))
    GetTextExtentPoint32W(c.mem_dc, as_string(p), n, c.rect)
    v = load_i64(c.rect)
    return TextSize(w=v % 4294967296, h=v / 4294967296)

# ---- the clip stack: SaveDC/RestoreDC, one saved state per push ----
#
# The old pair kept the pushed rects and re-issued IntersectClipRect on pop,
# which cannot restore anything: GDI's clip only ever narrows, so the pop just
# narrowed it further. The symptom was invisible in a smoke test and brutal
# in use — ONE ui_textbox anywhere in the frame left the whole window clipped
# to that textbox rect for the rest of the process, including the final BitBlt
# (a blit copies only the part of the source the source DC's clip allows), so
# nothing outside that rect was ever painted again. ui_x11.ax's comment on
# clip_apply describes exactly this failure.
#
# SaveDC snapshots the region (plus the selected objects and colors) and
# RestoreDC puts it back, which is what a push/pop stack means. st 820 = block
# of saved-state handles (one i64 per level), 821 = depth, 30 levels max — the
# same cap the widget layer's shadow stack uses, so the two stay in step.

def plat_clip_push(c: UI, l: int, t: int, r: int, b: int):
    depth = st_get(c, 821)
    if depth >= 30:
        # no room for another saved state, so this push is a no-op on both
        # stacks; a matching pop would unbalance them, but the widget layer
        # only nests a handful deep (scroll area > list > text)
        return
    if st_get(c, 820) == 0:
        st_set(c, 820, malloc(240))
    store_i64(st_get(c, 820) + depth * 8, SaveDC(c.mem_dc))
    st_set(c, 821, depth + 1)
    IntersectClipRect(c.mem_dc, l, t, r, b)

def plat_clip_pop(c: UI):
    depth = st_get(c, 821)
    if depth > 0:
        depth = depth - 1
        st_set(c, 821, depth)
        id = load_i64(st_get(c, 820) + depth * 8)
        if id != 0:
            RestoreDC(c.mem_dc, id)
            # RestoreDC rolls the selected objects and colors back too, so
            # whatever the DC state cache remembers is now a lie
            dc_cache_drop(c)

# ---- window / canvas lifecycle ----

def plat_init(c: UI, title: string, w: int, h: int) -> UI:
    SetProcessDPIAware()
    FreeConsole()
    c.msg = malloc(48)
    fill_zero(c.msg, 48)
    c.pt = malloc(8)
    c.rect = malloc(16)
    # WNDCLASSW (x64, 72 bytes): style, wndproc, extras, instance, cursor,
    # background brush = NULL (no erase flicker), class name
    cls = ui_utf16("AoxnUI")
    wc = malloc(72)
    fill_zero(wc, 72)
    user32 = LoadLibraryA("user32.dll")
    store_i64(wc, 35)
    store_i64(wc + 8, GetProcAddress(user32, "DefWindowProcW"))
    store_i64(wc + 24, GetModuleHandleW(0))
    store_i64(wc + 40, LoadCursorW(0, 32512))
    store_i64(wc + 64, cls)
    RegisterClassW(wc)
    # size the window so the CLIENT area is exactly w x h; the client rect is
    # {0, 0, w, h} — right and bottom share one i64 store (two 32-bit halves)
    store_i64(c.rect, 0)
    store_i64(c.rect + 8, w + h * 4294967296)
    AdjustWindowRect(c.rect, 13565952, 0)
    ww = i32_at(c.rect + 8) - i32_at(c.rect)
    wh = i32_at(c.rect + 12) - i32_at(c.rect + 4)
    t16 = ui_utf16(title)
    # CW_USEDEFAULT position = -2147483648; WS_OVERLAPPEDWINDOW = 13565952
    hwnd = CreateWindowExW(0, as_string(cls), as_string(t16), 13565952,
        -2147483648, -2147483648, ww, wh, 0, 0, load_i64(wc + 24), 0)
    free(wc)
    free(cls)
    free(t16)
    c.hwnd = hwnd
    c.open = hwnd != 0
    if not c.open:
        return c
    c.win_dc = GetDC(hwnd)
    c.mem_dc = CreateCompatibleDC(c.win_dc)
    # nothing is selected yet: seed the DC state cache with "unknown", so the
    # first draw of the first frame really does select and color everything
    dc_cache_drop(c)
    c.bmp = CreateCompatibleBitmap(c.win_dc, w, h)
    c.old_bmp = SelectObject(c.mem_dc, c.bmp)
    c.font = make_font(-16, 400)
    c.font_big = make_font(-26, 700)
    c.font_mono = make_font_mono(-16)
    st_set(c, 826, c.font)
    SetBkMode(c.mem_dc, 1)
    SetTextAlign(c.mem_dc, 0)
    GetClientRect(hwnd, c.rect)
    c.w = i32_at(c.rect + 8)
    c.h = i32_at(c.rect + 12)
    pal = ui_palette_get(c)
    plat_fill_rect(c, 0, 0, c.w, c.h, pal.bg)
    plat_present(c)
    ShowWindow(hwnd, 5)
    return c

def make_font(px: int, weight: int) -> int:
    face = ui_utf16("Segoe UI")
    f = CreateFontW(px, 0, 0, 0, weight, 0, 0, 0, 1, 0, 0, 5, 0, as_string(face))
    free(face)
    return f

# the monospace twin of make_font: same metrics conventions, face Consolas
# (present on every supported Windows; falls back per-glyph through GDI's
# font linking when a codepoint is missing)
def make_font_mono(px: int) -> int:
    face = ui_utf16("Consolas")
    f = CreateFontW(px, 0, 0, 0, 400, 0, 0, 0, 1, 0, 0, 5, 0, as_string(face))
    free(face)
    return f

def plat_canvas_resize(c: UI, nw: int, nh: int) -> UI:
    SelectObject(c.mem_dc, c.old_bmp)
    DeleteObject(c.bmp)
    # a fresh DC state comes with the fresh bitmap as far as we are concerned:
    # forget what we think is selected rather than trust it
    dc_cache_drop(c)
    c.bmp = CreateCompatibleBitmap(c.win_dc, nw, nh)
    c.old_bmp = SelectObject(c.mem_dc, c.bmp)
    return c

def plat_present(c: UI):
    if c.win_dc == 0 or c.mem_dc == 0:
        return
    # SRCCOPY = 13369376
    BitBlt(c.win_dc, 0, 0, c.w, c.h, c.mem_dc, 0, 0, 13369376)

# Pump messages, sample input, follow the window size. The portable
# ui_frame owns the arena reset, focus chain and background fill.
def plat_pump(c: UI) -> UI:
    # idle cap: wake on any input or after cap_ms (~66 fps default);
    # QS_ALLINPUT = 1279
    MsgWaitForMultipleObjects(0, 0, 1, c.cap_ms, 1279)
    # drain pending messages; DefWindowProc validates paint and handles close.
    # MSG (x64): hwnd 0..8, message 8..12, wParam 16..24, lParam 24..32.
    # WM_CHAR (258) feeds the text queue (control units < 32 are dropped —
    # Enter/Backspace/Tab stay key events), WM_MOUSEWHEEL (522) accumulates
    # the signed high word of wParam (WHEEL_DELTA = 120 per notch).
    while PeekMessageW(c.msg, 0, 0, 0, 1) != 0:
        m = i32_at(c.msg + 8)
        if m == 258:
            ch = load_i64(c.msg + 16) % 65536
            if ch >= 32:
                ui_char_push(c, ch)
        elif m == 522:
            wp = load_i64(c.msg + 16)
            d = (wp / 65536) % 65536
            if d >= 32768:
                d = d - 65536
            st_set(c, 544, st_get(c, 544) + d)
        TranslateMessage(c.msg)
        DispatchMessageW(c.msg)
    c.dn_prev = c.dn
    c.open = IsWindow(c.hwnd) != 0
    if not c.open:
        return c
    GetCursorPos(c.pt)
    ScreenToClient(c.hwnd, c.pt)
    c.mx = i32_at(c.pt)
    c.my = i32_at(c.pt + 4)
    if GetForegroundWindow() == c.hwnd:
        # GetAsyncKeyState returns a SHORT: bit 15 (32768) = down now, bit 0
        # (1) = pressed since the previous call — the latch catches presses
        # shorter than one frame gap that pure bit-15 sampling would miss.
        # ONE call per key per frame: a second call would clear the latch.
        k = GetAsyncKeyState(1)
        c.dn = k / 32768 == 1 or k % 2 == 1
        k = GetAsyncKeyState(2)
        c.dn2 = k / 32768 == 1 or k % 2 == 1
    else:
        c.dn = False
        c.dn2 = False
    # Win32 key codes ARE the portable VK codes: store straight into key_cur
    vk = 1
    while vk < 256:
        k = GetAsyncKeyState(vk)
        if k / 32768 == 1 or k % 2 == 1:
            st_set(c, 4 + vk, 1)
        vk = vk + 1
    GetClientRect(c.hwnd, c.rect)
    nw = i32_at(c.rect + 8)
    nh = i32_at(c.rect + 12)
    if nw != c.w or nh != c.h:
        c = ui_resize_canvas(c, nw, nh)
    return c

def plat_close(c: UI):
    if IsWindow(c.hwnd) != 0:
        DestroyWindow(c.hwnd)

def plat_fini(c: UI):
    if IsWindow(c.hwnd) != 0:
        DestroyWindow(c.hwnd)
    if c.mem_dc != 0:
        SelectObject(c.mem_dc, c.old_bmp)
        if c.bmp != 0:
            DeleteObject(c.bmp)
        DeleteDC(c.mem_dc)
    if c.win_dc != 0:
        ReleaseDC(c.hwnd, c.win_dc)
    if c.font != 0:
        DeleteObject(c.font)
    if c.font_big != 0:
        DeleteObject(c.font_big)
    if c.font_mono != 0:
        DeleteObject(c.font_mono)
    if st_get(c, 820) != 0:
        free(st_get(c, 820))

def plat_alert(text: string, caption: string):
    t16 = ui_utf16(text)
    c16 = ui_utf16(caption)
    MessageBoxW(0, as_string(t16), as_string(c16), 0)

# ---- clipboard: CF_UNICODETEXT (13); empty string on failure ----

def plat_clip_get(c: UI) -> string:
    if OpenClipboard(0) == 0:
        return ""
    h = GetClipboardData(13)
    if h == 0:
        CloseClipboard()
        return ""
    p = GlobalLock(h)
    if p == 0:
        CloseClipboard()
        return ""
    s = utf16z_utf8(p)
    GlobalUnlock(h)
    CloseClipboard()
    return s

def plat_clip_set(c: UI, s: string):
    if OpenClipboard(0) == 0:
        return
    EmptyClipboard()
    nb = len(s) * 2 + 2
    h = GlobalAlloc(2, nb)
    if h == 0:
        CloseClipboard()
        return
    p = GlobalLock(h)
    if p == 0:
        CloseClipboard()
        return
    utf16_write(s, p)
    store_u8(p, nb - 2, 0)
    store_u8(p, nb - 1, 0)
    GlobalUnlock(h)
    SetClipboardData(13, h)
    CloseClipboard()
