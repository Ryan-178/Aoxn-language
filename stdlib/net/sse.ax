# Aoxn net layer — server-sent events (v0.41.0).
#
# Streaming responses arrive as SSE frames over the open WinHTTP connection.
# The OpenAI shape is data-only:
#
#     data: {"id":"chatcmpl-...","choices":[{"delta":{"content":"He"}}]}
#
#     data: [DONE]
#
# The Anthropic shape also names the event, and repeats the name inside the
# payload's "type" field:
#
#     event: content_block_delta
#     data: {"type":"content_block_delta","index":0,"delta":{...}}
#
# So the filter below keeps BOTH halves of a frame: `res` is the joined
# `data:` payload and `event` is the `event:` name ("" when the server sent
# none). A client that only cares about payloads ignores `event`; one that
# dispatches on the name — Anthropic — gets it for free, including the
# safety net of falling back to the payload's own "type" when the frame
# carried no `event:` line at all.
#
# The parser is a pull filter: `net_sse_feed` appends network bytes, and
# `net_sse_next` extracts one complete frame per call into `s.res`.
#
# The SSE subset the APIs actually speak: `data:` lines, `event:` lines,
# `:` comment lines (ignored), blank line = event boundary, CRLF or LF
# endings, multiple data lines joined with \n. The `[DONE]` sentinel (an
# OpenAI-ism) sets `s.done`; Anthropic has no sentinel and ends by closing
# the connection.
#
# Buffers grow by doubling; consumed bytes are compacted to the front with
# memmove (memcpy would be UB on overlap). Payload strings are fresh copies
# (str_sub) — they outlive the buffer, which keeps growing underneath.

import * from "../stdlib.ax"

extern def memmove(dst: int, src: int, n: int) -> int

struct NetSse:
    buf: int        # byte buffer (malloc'd, grown by doubling)
    cap: int
    n: int          # bytes currently buffered
    pos: int        # consumed offset (compacted back to 0)
    done: bool      # saw "data: [DONE]"
    res: string     # data payload of the frame extracted by the last next()
    event: string   # its "event:" name ("" when the frame carried none)
    data: string    # data payload of the finished frame ("" while building one)
    ev: string      # event-line accumulator for the frame being built
    # The data-line accumulator is a byte buffer, NOT a string (v0.51.0).
    # `data = data + "\n" + payload` copied everything accumulated so far on
    # every `data:` line, and Aoxn's concatenation never frees the old buffer,
    # so one frame with N data lines cost O(N^2) bytes AND time. Measured on
    # this machine: 1 000 lines 0.08 s, 2 000 0.19 s, 4 000 0.70 s, 8 000
    # 2.83 s — a single streamed response could pin a thread for minutes.
    dbuf: int       # accumulator buffer (malloc'd, grown geometrically)
    dcap: int
    dn: int         # bytes accumulated in it

def net_sse_new() -> NetSse:
    cap = 8192
    return NetSse(buf=malloc(cap), cap=cap, n=0, pos=0, done=False, res="", event="", data="", ev="", dbuf=malloc(1024), dcap=1024, dn=0)

# grow the data accumulator so it can take `need` more bytes
def net_sse_reserve(s: NetSse, need: int) -> NetSse:
    if s.dn + need + 1 <= s.dcap:
        return s
    newcap = s.dcap * 2
    if newcap < s.dn + need + 1:
        newcap = s.dn + need + 1
    s.dbuf = realloc(s.dbuf, newcap)
    s.dcap = newcap
    return s

# append network bytes (does NOT parse; call net_sse_next after feeding)
def net_sse_feed(s: NetSse, p: int, n: int) -> NetSse:
    if s.n + n + 1 > s.cap:
        newcap = (s.n + n + 1) * 2
        s.buf = realloc(s.buf, newcap)
        s.cap = newcap
    memcpy(s.buf + s.n, p, n)
    s.n = s.n + n
    return s

# one complete frame's payload, or "" when nothing complete is buffered.
# `s.event` holds the frame's event name alongside it. After a [DONE]
# sentinel `s.done` is True and res stays "".
def net_sse_next(s: NetSse) -> NetSse:
    s.res = ""
    s.event = ""
    if s.done:
        return s
    while s.pos < s.n:
        # find the line end
        i = s.pos
        while i < s.n and load_u8(s.buf, i) != 10:
            i = i + 1
        if i >= s.n:
            break            # no complete line yet; wait for more bytes
        end = i
        if end > s.pos and load_u8(s.buf, end - 1) == 13:
            end = end - 1    # strip CR of a CRLF ending
        # `str_sub(as_string(s.buf), ...)` read len() of the WHOLE buffer
        # (strlen, inline, per line) -- the pointer-plus-length spelling
        # copies exactly the line's bytes and scans nothing.
        line = buf_str(s.buf + s.pos, end - s.pos)
        s.pos = i + 1
        if len(line) == 0:
            # blank line: dispatch the accumulated frame
            if s.dn > 0:
                s.event = s.ev
                s.ev = ""
                store_u8(s.dbuf, s.dn, 0)
                # COPY, do not alias: the accumulator is reused by the next
                # frame, and `s.res` outlives this call (a caller reads it
                # after further net_sse_next calls). Handing out the
                # accumulator's address made every earlier frame read back as
                # the newest one — `e1` and `e2` both came out "[DONE]".
                frame = buf_str(s.dbuf, s.dn)
                s.dn = 0
                if frame == "[DONE]":
                    s.done = True
                    return s
                s.res = frame
                return s
            # a frame with only an event name and no data line carries
            # nothing this SDK can use; drop the name rather than leak it
            s.ev = ""
            continue
        if load_u8(line, 0) == 58:
            continue         # `: comment` keep-alive line
        if len(line) >= 6 and str_sub(line, 0, 6) == "event:":
            payload = str_sub(line, 6, len(line))
            if len(payload) > 0 and load_u8(payload, 0) == 32:
                payload = str_sub(payload, 1, len(payload))
            s.ev = payload
        elif len(line) >= 5 and str_sub(line, 0, 5) == "data:":
            payload = str_sub(line, 5, len(line))
            if len(payload) > 0 and load_u8(payload, 0) == 32:
                payload = str_sub(payload, 1, len(payload))
            # append into the accumulator, geometrically grown (see the
            # `dbuf` field): one reallocation per doubling, not one per line.
            # The separator is written AT the current end and the counter
            # advanced after it — the other order writes one byte past the
            # data and then overwrites it with the next payload.
            pl = len(payload)
            if s.dn > 0:
                s = net_sse_reserve(s, 1)
                store_u8(s.dbuf, s.dn, 10)     # the '\n' between data lines
                s.dn = s.dn + 1
            s = net_sse_reserve(s, pl)
            memcpy(s.dbuf + s.dn, as_ptr(payload), pl)
            s.dn = s.dn + pl
        # `id:` / `retry:` / anything else: irrelevant for these APIs, ignored
    # compact consumed bytes so the buffer cannot grow without bound
    if s.pos > 0:
        if s.pos == s.n:
            s.pos = 0
            s.n = 0
        else:
            memmove(s.buf, s.buf + s.pos, s.n - s.pos)
            s.n = s.n - s.pos
            s.pos = 0
    return s
