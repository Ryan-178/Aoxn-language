# Aoxn standard library (stdlib) — written in Aoxn itself.
# Generic functions are monomorphized per (type, length) at each call site.
# C FFI math is declared via `extern def`.

# ---- C runtime math (FFI) ----
extern def sqrt(x: float) -> float
extern def floor(x: float) -> float
extern def ceil(x: float) -> float

# ---- integer math ----

def abs_i(n: int) -> int:
    if n < 0:
        return -n
    return n

def min_i(a: int, b: int) -> int:
    if a < b:
        return a
    return b

def max_i(a: int, b: int) -> int:
    if a > b:
        return a
    return b

def clamp_i(v: int, lo: int, hi: int) -> int:
    return min_i(max_i(v, lo), hi)

# fast integer power: base^exp for exp >= 0 (overflow wraps like C)
def pow_i(base: int, exp: int) -> int:
    result = 1
    b = base
    e = exp
    while e > 0:
        if e % 2 == 1:
            result = result * b
        b = b * b
        e = e / 2
    return result

def gcd(a: int, b: int) -> int:
    a = abs_i(a)
    b = abs_i(b)
    while b > 0:
        t = a % b
        a = b
        b = t
    return a

def lcm(a: int, b: int) -> int:
    if a == 0 or b == 0:
        return 0
    return a / gcd(a, b) * b

# integer square root (Newton's method, floors toward zero)
def isqrt(n: int) -> int:
    if n < 2:
        return n
    x = n
    y = (x + 1) / 2
    while y < x:
        x = y
        y = (x + n / x) / 2
    return x

# ---- float math ----

def abs_f(x: float) -> float:
    if x < 0.0:
        return -x
    return x

def min_f(a: float, b: float) -> float:
    if a < b:
        return a
    return b

def max_f(a: float, b: float) -> float:
    if a > b:
        return a
    return b

def clamp_f(v: float, lo: float, hi: float) -> float:
    return min_f(max_f(v, lo), hi)

def hypot(a: float, b: float) -> float:
    return sqrt(a * a + b * b)

# ---- primality ----

def is_prime(n: int) -> bool:
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d = d + 1
    return True

# ---- generic search ----
# returns the index of the first match, or -1 when absent

def linear_search[T, N](arr: [T; N], target: T) -> int:
    for i in range(N):
        if arr[i] == target:
            return i
    return -1

# binary search: arr must be sorted ascending
def binary_search[T, N](arr: [T; N], target: T) -> int:
    lo = 0
    hi = N - 1
    while lo <= hi:
        mid = (lo + hi) / 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

# ---- generic sort ----
# value semantics: returns a sorted copy, the input is untouched

def sort[T, N](arr: [T; N]) -> [T; N]:
    result = arr
    for i in range(N):
        for j in range(N - 1 - i):
            if result[j] > result[j + 1]:
                t = result[j]
                result[j] = result[j + 1]
                result[j + 1] = t
    return result

# ---- generic array helpers ----

def sum_int[N](arr: [int; N]) -> int:
    total = 0
    for x in arr:
        total = total + x
    return total

def sum_float[N](arr: [float; N]) -> float:
    total = 0.0
    for x in arr:
        total = total + x
    return total

def max_of[T, N](arr: [T; N]) -> T:
    m = arr[0]
    for x in arr:
        if x > m:
            m = x
    return m

def min_of[T, N](arr: [T; N]) -> T:
    m = arr[0]
    for x in arr:
        if x < m:
            m = x
    return m

def reverse[T, N](arr: [T; N]) -> [T; N]:
    result = arr
    i = 0
    j = N - 1
    while i < j:
        t = result[i]
        result[i] = result[j]
        result[j] = t
        i = i + 1
        j = j - 1
    return result

# ---- raw memory & dynamic arrays (self-hosting foundation, v0.9) ----
# Addresses are plain `int` (pointer-sized). The load/store builtins are
# unsafe by nature: bounds and lifetimes are the caller's responsibility.

extern def malloc(size: int) -> int
extern def realloc(p: int, size: int) -> int
extern def free(p: int)
extern def memcpy(dst: int, src: int, n: int) -> int

# growable array of 8-byte slots (ints, bools as 0/1, strings via as_ptr)
struct Vec:
    data: int
    len: int
    cap: int

def vec_new() -> Vec:
    return Vec(data=0, len=0, cap=0)

# grow so at least `n` slots fit (never shrinks)
def vec_reserve(v: Vec, n: int) -> Vec:
    if n <= v.cap:
        return v
    newcap = v.cap * 2
    if newcap < n:
        newcap = n
    if newcap == 0:
        newcap = 8
    v.data = realloc(v.data, newcap * 8)
    v.cap = newcap
    return v

def vec_push(v: Vec, item: int) -> Vec:
    v = vec_reserve(v, v.len + 1)
    store_i64(v.data + v.len * 8, item)
    v.len = v.len + 1
    return v

def vec_get(v: Vec, i: int) -> int:
    return load_i64(v.data + i * 8)

def vec_set(v: Vec, i: int, item: int):
    store_i64(v.data + i * 8, item)

def vec_free(v: Vec):
    free(v.data)

def vec_pop(v: Vec) -> Vec:
    return Vec(data=v.data, len=v.len - 1, cap=v.cap)

# ---- byte/string buffers ----

def fill_zero(p: int, n: int):
    i = 0
    while i < n:
        store_u8(p, i, 0)
        i = i + 1

def buf_new(cap: int) -> int:
    b = malloc(cap)
    fill_zero(b, cap)
    return b

def str_get(s: string, i: int) -> int:
    return load_u8(s, i)

# ---- text editing primitives (pure; malloc-per-edit, like concat) ----
# These moved here from stdlib/ui.ax in v0.40.1 so non-UI code (the OpenAI
# client's JSON/SSE layers) does not pull the UI toolkit to get a substring.
# Caret movement stayed in ui.ax: it is a UTF-8 UI concern.

# bytes [from, to) of s as a fresh NUL-terminated string
def str_sub(s: string, from: int, to: int) -> string:
    if from < 0:
        from = 0
    if to > len(s):
        to = len(s)
    if to < from:
        to = from
    n = to - from
    p = malloc(n + 1)
    i = 0
    while i < n:
        store_u8(p, i, load_u8(s, from + i))
        i = i + 1
    store_u8(p, n, 0)
    return as_string(p)

def str_remove(s: string, from: int, to: int) -> string:
    return str_sub(s, 0, from) + str_sub(s, to, len(s))

def str_insert(s: string, at: int, ins: string) -> string:
    return str_sub(s, 0, at) + ins + str_sub(s, at, len(s))

# char classification (bytes as int)
def is_digit(c: int) -> bool:
    return c >= 48 and c <= 57

def is_alpha(c: int) -> bool:
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122)

def is_space(c: int) -> bool:
    return c == 32 or c == 9 or c == 10 or c == 13

# ---- inline CSS (CSS-in-Aoxn, v0.36.0) ----
#
# A typed wrapper around `style="..."` attributes, for the cases a stylesheet
# should not own: a value computed at run time. It is deliberately a *set of
# declarations*, not an object literal — neither language has one without an
# interface, and the alternative (string concatenation at every call site) is
# where quoting bugs live.
#
#   print(inline_style_2("color", "red", "margin", "0 auto"))
#
# The `N` variants exist because the language has one array length parameter
# per function, so a variadic builder cannot be written generically.

# Declarations are joined with "; " and the result is ready to drop into a
# `style` attribute. A value containing a quote is rejected rather than
# escaped: silently producing a broken attribute is worse than a clear error.
def css_decl_2(k1: string, v1: string, k2: string, v2: string) -> string:
    return css_check(k1, v1) + "; " + css_check(k2, v2)

def css_decl_3(k1: string, v1: string, k2: string, v2: string, k3: string, v3: string) -> string:
    return css_decl_2(k1, v1, k2, v2) + "; " + css_check(k3, v3)

def css_decl_1(k1: string, v1: string) -> string:
    return css_check(k1, v1)

# validate one `key: value` pair and return it
def css_check(key: string, value: string) -> string:
    if len(key) == 0:
        return ""
    if css_has_quote(value):
        # no way to report an error from the stdlib's string layer; an empty
        # declaration drops out of the join below rather than corrupting the
        # attribute
        return ""
    return key + ": " + value

def css_has_quote(s: string) -> bool:
    i = 0
    while i < len(s):
        c = str_get(s, i)
        if c == 34 or c == 39:
            return True
        i = i + 1
    return False

# ---- file IO ----

extern def fopen(path: string, mode: string) -> int
extern def fread(buf: int, size: int, count: int, f: int) -> int
extern def fwrite(buf: int, size: int, count: int, f: int) -> int
extern def fseek(f: int, off: int, origin: int) -> int
extern def ftell(f: int) -> int
extern def fclose(f: int) -> int

# read an entire file as a string (empty string when it cannot be opened)
def read_file(path: string) -> string:
    f = fopen(path, "rb")
    if f == 0:
        return ""
    fseek(f, 0, 2)
    size = ftell(f)
    fseek(f, 0, 0)
    buf = malloc(size + 1)
    fread(buf, 1, size, f)
    store_u8(buf, size, 0)
    fclose(f)
    return as_string(buf)

# write a string to a file (returns false when it cannot be opened)
def write_file(path: string, content: string) -> bool:
    f = fopen(path, "wb")
    if f == 0:
        return False
    fwrite(as_ptr(content), 1, len(content), f)
    fclose(f)
    return True

# ---- process location ----
#
# A compiled program cannot learn where it lives on its own: `main` takes no
# arguments and Aoxn has no argv/cwd builtin. Windows answers through
# `GetModuleFileNameA` (kernel32 is linked through the CRT, so this needs no
# compiler change and no `-l`); Linux answers through `readlink` on
# `/proc/self/exe` (extern declarations are prototypes — see os.ax).

extern def GetModuleFileNameA(module: int, buf: int, size: int) -> int
extern def GetModuleHandleA(name: int) -> int
extern def readlink(path: string, buf: int, size: int) -> int

# full path of the running executable, without a trailing separator
def exe_path() -> string:
    buf = malloc(1024)
    if target_os() == "windows":
        n = GetModuleFileNameA(GetModuleHandleA(0), buf, 1024)
        if n <= 0:
            free(buf)
            return ""
        store_u8(buf, n, 0)
        return as_string(buf)
    n = readlink("/proc/self/exe", buf, 1023)
    if n <= 0:
        free(buf)
        return ""
    store_u8(buf, n, 0)
    return as_string(buf)

# directory containing the running executable, without a trailing separator.
# This is where `aoxn build --emit-assets assets` writes its fingerprinted
# files, so a server finds them under `exe_dir() + "/assets"`.
def exe_dir() -> string:
    path = exe_path()
    n = len(path)
    i = n - 1
    # strip the file name; both separators are checked because a Windows path
    # may carry either. The prefix is copied into a fresh buffer rather than
    # sliced, because the language has no substring builtin.
    while i >= 0:
        # str_get yields a byte, so the separators are compared as byte values
        # (47 = '/', 92 = '\'), never as string literals
        c = str_get(path, i)
        if c == 47 or c == 92:
            buf = malloc(i + 1)
            j = 0
            while j < i:
                store_u8(buf, j, load_u8(path, j))
                j = j + 1
            store_u8(buf, i, 0)
            return as_string(buf)
        i = i - 1
    return ""

# Filesystem location of an asset emitted beside the executable. The `name` is
# what `styles_fingerprint()` returns; a server maps a request URL onto this
# directory. The separator matches the platform's own convention (both sides
# accept "/" through the C stdio layer, but Windows emits "\" for parity with
# the paths the compiler itself prints).
def asset_path(name: string) -> string:
    if target_os() == "windows":
        return exe_dir() + "\\assets\\" + name
    return exe_dir() + "/assets/" + name

# run a shell command, returning the raw C `system()` value: a wait status on
# POSIX, the process exit code on Windows. Most callers want `system_exit_code`
# below, which normalizes both.
extern def system(cmd: string) -> int

# run a shell command and return its exit code on every platform.
# POSIX `system()` reports a wait status (`exit 7` -> 1792) while Windows
# reports the exit code directly; a process killed by a signal is reported
# shell-style as 128 + signal. Returns -1 when the shell cannot be started.
def system_exit_code(cmd: string) -> int:
    raw = system(cmd)
    if target_os() == "windows":
        return raw
    if raw == -1:
        return -1
    if raw % 128 != 0:
        return 128 + raw % 128
    return raw / 256

# ============================================================
# v0.39.0 — the error channel (Tier 0.2)
# ============================================================
#
# Aoxn has no exceptions, and this is the replacement: a failure is a VALUE.
# A function that can fail returns an `Err`; a caller tests it with
# `err_is_ok`. Nothing unwinds, nothing is caught.
#
#     p = out_new()
#     e = parse_port("8080", p)
#     if not err_is_ok(e):
#         print(e.message)
#         return -1
#     print(out_get_i(p))
#     out_free(p)
#
# The payload comes back through `p`, a heap out-slot, because Aoxn functions
# return exactly one value and structs are copied on return. Writing the value
# into a slot the CALLER owns is the only shape that survives value semantics:
# a struct field mutated inside a callee is discarded by the caller.
#
# A function with no payload to return just returns the `Err` — that is the
# whole "Result[void]" case, and it needs no slot at all.
#
# Error codes are zero-argument functions rather than top-level constants
# because Aoxn has no module-level bindings; `selfhost/lexer.ax`'s `TK_PLUS()`
# is the same pattern for the same reason.

def ERR_NONE() -> int:
    return 0

def ERR_IO() -> int:
    return 1

def ERR_PARSE() -> int:
    return 2

def ERR_RANGE() -> int:
    return 3

def ERR_NOT_FOUND() -> int:
    return 4

def ERR_INVALID() -> int:
    return 5

def ERR_UNSUPPORTED() -> int:
    return 6

def ERR_NOMEM() -> int:
    return 7

def ERR_AGAIN() -> int:
    return 8


struct Err:
    code: int
    message: string


def err_ok() -> Err:
    return Err(code=ERR_NONE(), message="")


def err_new(code: int, message: string) -> Err:
    return Err(code=code, message=message)


def err_is_ok(e: Err) -> bool:
    return e.code == ERR_NONE()


def err_is_err(e: Err) -> bool:
    return e.code != ERR_NONE()


def err_code_name(c: int) -> string:
    if c == ERR_NONE():
        return "ok"
    if c == ERR_IO():
        return "io"
    if c == ERR_PARSE():
        return "parse"
    if c == ERR_RANGE():
        return "range"
    if c == ERR_NOT_FOUND():
        return "not_found"
    if c == ERR_INVALID():
        return "invalid"
    if c == ERR_UNSUPPORTED():
        return "unsupported"
    if c == ERR_NOMEM():
        return "nomem"
    if c == ERR_AGAIN():
        return "again"
    return "unknown"


def err_with_code(e: Err, code: int) -> Err:
    return Err(code=code, message=e.message)


# `a` on success, `b` when `e` is a failure — the `or`-operator a language
# with no short-circuiting error propagation does not have.
def err_or_int(e: Err, a: int, b: int) -> int:
    if err_is_ok(e):
        return a
    return b


def err_or_str(e: Err, a: string, b: string) -> string:
    if err_is_ok(e):
        return a
    return b


# ---- out-slots: how a value comes back next to an Err ----

# One 8-byte heap slot. `out_new` returns its address; the callee writes
# through it and the caller reads after checking the `Err`.
def out_new() -> int:
    return malloc(8)


def out_free(p: int):
    free(p)


def out_set_i(p: int, v: int):
    store_i64(p, v)


def out_set_f(p: int, v: float):
    store_f64(p, v)


def out_set_s(p: int, v: string):
    store_i64(p, as_ptr(v))


def out_get_i(p: int) -> int:
    return load_i64(p)


def out_get_f(p: int) -> float:
    return load_f64(p)


def out_get_s(p: int) -> string:
    return as_string(load_i64(p))

# ============================================================
# v0.39.0 — variable-length containers (Tier 0.3)
# ============================================================
#
# `[T; N]` is fixed at compile time, so a program that must hold "however many"
# items needs the heap. `Vec` is that: a growable array of 8-byte slots.
#
# The hard constraint worth stating once: Aoxn cannot take the address of a
# struct value (`as_ptr` works on strings only) and there is no `sizeof`. So a
# container can never copy a struct in wholesale — it moves 8-byte slots.
# Anything wider has to be described as a number of slots, which is what
# `VecVec` does: an inner `Vec` is exactly three slots.
#
# That is also why strings work as elements for free (a string IS a pointer),
# and why "a list of structs" has to be a list of slot-tuples.

def vec_len(v: Vec) -> int:
    return v.len


def vec_cap(v: Vec) -> int:
    return v.cap


def vec_last(v: Vec) -> int:
    return load_i64(v.data + (v.len - 1) * 8)


def vec_clear(v: Vec) -> Vec:
    # keeps the allocation for reuse
    return Vec(data=v.data, len=0, cap=v.cap)


def vec_truncate(v: Vec, n: int) -> Vec:
    if n < 0:
        return v
    if n > v.len:
        return v
    return Vec(data=v.data, len=n, cap=v.cap)


# first index holding `item`, or -1
def vec_index_of(v: Vec, item: int) -> int:
    i = 0
    while i < v.len:
        if load_i64(v.data + i * 8) == item:
            return i
        i = i + 1
    return -1


# ---- strings as elements ----
#
# A string is a pointer, so a string element is just that pointer in a slot.
# These are the whole typed-string story.

def vec_push_str(v: Vec, s: string) -> Vec:
    return vec_push(v, as_ptr(s))


def vec_get_str(v: Vec, i: int) -> string:
    return as_string(load_i64(v.data + i * 8))


def vec_set_str(v: Vec, i: int, s: string):
    store_i64(v.data + i * 8, as_ptr(s))


def vec_index_of_str(v: Vec, s: string) -> int:
    return vec_index_of(v, as_ptr(s))


def vec_contains_str(v: Vec, s: string) -> bool:
    return vec_index_of_str(v, s) >= 0


# ---- VecVec: a vector whose elements are themselves vectors ----
#
# The shape a document format needs (a JSON array of arrays, a table of
# variable-length rows). Each element occupies three consecutive slots —
# data, len, cap — which is a `Vec` spread out. Nesting it again gives a
# vector of vectors of vectors, so arbitrary depth needs no new machinery.
#
# Indexing is NOT bounds-checked anywhere in this file, matching the language.

struct VecVec:
    data: int
    len: int
    cap: int


def vecvec_new() -> VecVec:
    return VecVec(data=0, len=0, cap=0)


def vecvec_push(vv: VecVec, v: Vec) -> VecVec:
    if vv.len == vv.cap:
        newcap = vv.cap * 2
        if newcap == 0:
            newcap = 4
        vv.data = realloc(vv.data, newcap * 3 * 8)
        vv.cap = newcap
    base = vv.data + vv.len * 3 * 8
    store_i64(base, v.data)
    store_i64(base + 8, v.len)
    store_i64(base + 16, v.cap)
    vv.len = vv.len + 1
    return vv


def vecvec_get(vv: VecVec, i: int) -> Vec:
    base = vv.data + i * 3 * 8
    return Vec(data=load_i64(base), len=load_i64(base + 8), cap=load_i64(base + 16))


def vecvec_len(vv: VecVec) -> int:
    return vv.len


def vecvec_get_data(vv: VecVec, i: int) -> int:
    return load_i64(vv.data + i * 3 * 8)


def vecvec_free(vv: VecVec):
    free(vv.data)


# free every inner vector's buffer too, then the outer one
def vecvec_free_deep(vv: VecVec):
    i = 0
    while i < vv.len:
        free(load_i64(vv.data + i * 3 * 8))
        i = i + 1
    vecvec_free(vv)
