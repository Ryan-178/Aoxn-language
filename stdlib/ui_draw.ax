# Aoxn UI — the PORTABLE WIDGET LAYER (v3 widgets, platform-neutral).
#
# This file holds every widget, the layout/focus/text machinery and the
# drawing PRIMITIVE CONTRACTS. It declares no platform externs and makes no
# `target_os()` test: it calls a small set of `plat_*` primitives that the
# platform backend defines. Import a backend, not this file:
#
#   import * from "stdlib/ui_win"    # Windows (GDI) — link -l user32 -l gdi32
#
# Aoxn targets Windows only (v0.30.0): the X11 backend is gone, so this is
# the only backend a program can import.
#
# A backend is one file that imports this one and supplies:
#   plat_canvas_new/resize/free   the off-screen drawing surface
#   plat_present                   blit the surface to the window
#   plat_fill_rect / plat_frame_rect / plat_round_fill / plat_ellipse
#   plat_ellipse_fill / plat_line / plat_text / plat_text_big
#   plat_text_sub / plat_measure / plat_measure_sub
#   plat_clip_push / plat_clip_pop
#   plat_pump                      drain events, sample input into `c`
#   plat_close / plat_alert / plat_clip_get / plat_clip_set
#   plat_supported                 is this backend the one for this OS
#   plat_now_ms                    monotonic milliseconds (tooltip timing)
#   plat_canvas_ok                 live window AND live off-screen surface
#
# Design (forced by the language, kept Qt-like in spirit):
#   - Aoxn has no function pointers or closures, so callbacks/signals are
#     impossible. Widgets are plain functions evaluated every frame and the
#     app owns all state: checked = ui_checkbox(c, x, y, "opt", checked)
#   - The context is a plain value; ui_frame returns the updated copy
#     (write-back style, like everything in stdlib). `st` points to a heap
#     block (8192 bytes = 1024 i64 slots) shared by every copy:
#       0        active widget id (press claim, one drag at a time)
#       1..3     frame arena: base ptr / bump offset / capacity
#       4..259   key_cur[vk]  (0/1, this frame's key snapshot)
#       260..515 key_prev[vk] (previous frame's snapshot, for edge detection)
#       516..531 palette (16): bg panel text text_dim widget widget_hover
#                widget_down border accent groove sel sel_text
#                disabled_face disabled_text tooltip_bg tooltip_text
#       536      keyboard focus id (0 = none)
#       537/538  focus registry counts (this frame / previous frame)
#       539      caret byte offset inside the focused textbox
#       540      disabled nesting counter (> 0 = widgets draw inactive)
#       541..543 text queue: buffer ptr / count / capacity (i64 per unit)
#       544      mouse wheel delta accumulated this frame
#       545..555 overlay record (drawn on top in ui_present):
#                  545 kind (0 none, 1 combo popup, 2 tooltip, 3 menu popup)
#                  546 owner widget id
#                  547..551 x, y, w, item_h, n
#                  552 current item (open menu: the keyboard-highlighted
#                  row), 553 scroll (items), 554 items/text ptr
#       556/557  tooltip hover id / hover start (ms)
#       558      layout stack depth
#       560..719 layout stack: 8 levels x 20 slots
#       720..751 focus registry, previous frame (tab order, 32 ids)
#       752..783 focus registry, this frame
#       784..815 combo popup item string pointers (32)
#       816      focused textbox caret owner id (caret lives at 539)
#       817      event block ptr (v3): connect[256] + 32-event ring queue
#       818      line cache block ptr (v3): line starts for multi-line edit
#       820/821  backend clip stack ptr / depth (SaveDC handles on Windows,
#                  rect stack on X11)
#       826      the sans font handle parked by the backend's plat_init
#       827..834 this layer's own two blocks (v0.47.0): 827 clip-shadow stack
#                  ptr, 828 depth, 829..832 the clip in force, 833 the
#                  "canvas known" flag, 834 text-measure cache ptr — see the
#                  "clip bookkeeping" and "measure cache" sections below
#   - Per-frame text goes through a 64 KiB bump arena that resets every
#     frame (utf16f/itoa10), so a steady-state UI leaks nothing.
#   - TWO per-frame costs are cut here rather than in the backends, because
#     both are decisions about WHAT is worth asking the platform for, not
#     about how to ask:
#       - a draw that the current clip cannot show issues no platform call at
#         all (ui_fill_rect and friends), which is what a scroll area's
#         scrolled-out rows used to pay full price for;
#       - a text measure whose (content, range) was already measured this
#         session is answered from a 64-entry cache instead of a font metrics
#         call.
#   - KEY CODES are Win32 virtual-key numbers (VK_*), which is what the
#     whole widget layer speaks. Backends translate their native key codes
#     into this space (see vk_* below) and store the result in key_cur[],
#     so a backend never has to know what any widget asks for.
#   - Colors are COLORREF (0x00BBGGRR) as produced by ui_rgb; backends
#     convert to their native pixel order.

import * from "./ui.ax"

# ---- key codes (Win32 VK numbering; the portable input alphabet) ----
# A backend maps its native key codes onto these (Win32 virtual key,
# ... -> VK numbering), so every widget above is written once and works on
# every platform.
def vk_back() -> int:
    return 8

def vk_tab() -> int:
    return 9

def vk_return() -> int:
    return 13

def vk_shift() -> int:
    return 16

def vk_ctrl() -> int:
    return 17

def vk_esc() -> int:
    return 27

def vk_space() -> int:
    return 32

def vk_end() -> int:
    return 35

def vk_home() -> int:
    return 36

def vk_left() -> int:
    return 37

def vk_up() -> int:
    return 38

def vk_right() -> int:
    return 39

def vk_down() -> int:
    return 40

def vk_delete() -> int:
    return 46

def vk_a() -> int:
    return 65

def vk_c() -> int:
    return 67

def vk_v() -> int:
    return 86

def vk_x() -> int:
    return 88

# ---- platform primitive contract ----
# Implemented by exactly one backend (ui_win.ax). The bodies
# here are the headless fallback: a program that imports a backend always
# gets the real ones (a backend's definitions override these, since it
# imports this file and the loader keeps the first definition — so the
# stubs are only reached if a widget is somehow called with no backend).
# The `plat_*` names are documented, not defensive: the toolkit is always
# used through a backend.

# ---- drawing primitives: thin, stable names over the backend ----
# The widget layer calls THESE; each forwards to the backend primitive of
# the same name. Keeping one spelling in the widget code means a backend
# only has to implement `plat_*`.

# ---- input queries ----

def ui_mouse_in(c: UI, x: int, y: int, w: int, h: int) -> bool:
    return c.mx >= x and c.mx < x + w and c.my >= y and c.my < y + h

def ui_key_down(c: UI, vk: int) -> bool:
    if vk < 0 or vk > 255:
        return False
    return st_get(c, 4 + vk) == 1

# true only on the frame the key went down
def ui_key_pressed(c: UI, vk: int) -> bool:
    if vk < 0 or vk > 255:
        return False
    return st_get(c, 4 + vk) == 1 and st_get(c, 260 + vk) == 0


def draw_combo_popup(c: UI):
    x = st_get(c, 547)
    y = st_get(c, 548)
    w = st_get(c, 549)
    item_h = st_get(c, 550)
    n = st_get(c, 551)
    scroll = st_get(c, 553)
    cap = 12
    is_menu = ui_overlay_kind(c) == 3
    if is_menu:
        cap = 16
    vis = n - scroll
    if vis > cap:
        vis = cap
    room = (c.h - y) / item_h
    if vis > room:
        vis = room
    if vis < 1:
        vis = 1
    ph = vis * item_h
    pal = ui_palette_get(c)
    ui_fill_rect(c, x + 3, y + 3, w, ph, pal.border)
    ui_fill_rect(c, x, y, w, ph, pal.panel)
    ui_frame_rect(c, x, y, w, ph, pal.border)
    ui_clip_push(c, x + 1, y + 1, x + w - 1, y + ph - 1)
    kbd = st_get(c, 552)
    i = 0
    while i < vis:
        it = i + scroll
        if it >= n:
            i = vis
        else:
            iy = y + i * item_h
            hl = ui_mouse_in(c, x, iy, w, item_h)
            if not hl and is_menu and it == kbd:
                hl = True
            if hl:
                ui_fill_rect(c, x + 1, iy, w - 2, item_h, pal.sel)
                ui_draw_text(c, x + 10, iy + 4, overlay_item_str(c, it), pal.sel_text)
            else:
                ui_draw_text(c, x + 10, iy + 4, overlay_item_str(c, it), pal.text)
            i = i + 1
    ui_clip_pop(c)

# tooltip: small framed label near the cursor
def draw_tooltip_overlay(c: UI):
    s = as_string(st_get(c, 554))
    pal = ui_palette_get(c)
    ts = ui_measure(c, s)
    x = st_get(c, 547) + 16
    y = st_get(c, 548) + 24
    if x + ts.w + 16 > c.w:
        x = c.w - ts.w - 16
    if y + ts.h + 12 > c.h:
        y = st_get(c, 548) - ts.h - 12
    if x < 0:
        x = 0
    if y < 0:
        y = 0
    ui_fill_rect(c, x + 2, y + 2, ts.w + 16, ts.h + 10, pal.border)
    ui_fill_rect(c, x, y, ts.w + 16, ts.h + 10, pal.tooltip_bg)
    ui_frame_rect(c, x, y, ts.w + 16, ts.h + 10, pal.border)
    ui_draw_text(c, x + 8, y + 5, s, pal.tooltip_text)

# ---- clip bookkeeping: the EFFECTIVE clip the widget layer works against ----
#
# The widget layer owns a shadow of the clip stack so it can (a) restore the
# previous rect on pop and (b) skip drawing that the platform would clip away
# anyway. Two facts made this necessary rather than clever:
#
#   - GDI's IntersectClipRect only ever NARROWS the DC's region, so the old
#     pop (re-intersect the popped rect) could not restore anything: after one
#     ui_textbox the whole window stayed clipped to the textbox rect — and the
#     final BitBlt with it. SaveDC/RestoreDC in ui_win.ax is the real fix; this
#     shadow is what lets the widget layer KNOW the current rect.
#   - A scroll area makes the app draw content that is scrolled out of view.
#     Those draws cost a full GDI call each (measure + text + fill) and every
#     one of them lands on a clipped pixel.
#
# st 827 = stack base ptr (30 levels x 4 slots: the EFFECTIVE clip in force at
# that level), 828 = depth, 829..832 = the clip in force now (l, t, r, b),
# 833 = "the canvas rect is known" flag. The flag is 0 until a backend hands us
# a real canvas (ui_init / ui_resize_canvas), and while it is 0 nothing is
# culled — which is what keeps the headless portable tests drawing everything.

def ui_clip_canvas(c: UI, l: int, t: int, r: int, b: int):
    st_set(c, 829, l)
    st_set(c, 830, t)
    st_set(c, 831, r)
    st_set(c, 832, b)
    st_set(c, 833, 1)

def ui_clip_depth(c: UI) -> int:
    return st_get(c, 828)

# is any part of the rect (x, y, w, h) inside the clip? Cheap: four slot reads.
def rect_visible(c: UI, x: int, y: int, w: int, h: int) -> bool:
    if st_get(c, 833) == 0:
        return True
    if w <= 0 or h <= 0:
        return False
    if x >= st_get(c, 831) or y >= st_get(c, 832):
        return False
    if x + w <= st_get(c, 829) or y + h <= st_get(c, 830):
        return False
    return True

# Text is culled WITHOUT measuring: a run of n bytes holds at most n codepoints
# and no codepoint in the toolkit's faces advances more than 64 px (26 px bold
# is the largest; a wide glyph is well under that), so `x + n * 64` is an upper
# bound on the right edge and 64 px is an upper bound on the line height. Both
# bounds are deliberately loose — culling too little only costs a clipped draw,
# while culling too much would drop text the user can see.
def text_visible(c: UI, x: int, y: int, nbytes: int) -> bool:
    if st_get(c, 833) == 0:
        return True
    if x >= st_get(c, 831) or y >= st_get(c, 832):
        return False
    if x + nbytes * 64 <= st_get(c, 829) or y + 64 <= st_get(c, 830):
        return False
    return True

def ui_clip_push(c: UI, l: int, t: int, r: int, b: int):
    if st_get(c, 833) == 0:
        plat_clip_push(c, l, t, r, b)
        return
    nl = st_get(c, 829)
    if l > nl:
        nl = l
    nt = st_get(c, 830)
    if t > nt:
        nt = t
    nr = st_get(c, 831)
    if r < nr:
        nr = r
    nb = st_get(c, 832)
    if b < nb:
        nb = b
    d = st_get(c, 828)
    if d < 30:
        # the backend's own stack is capped at the same 30 levels, so the two
        # depths stay in step and every pop has something to restore
        if st_get(c, 827) == 0:
            st_set(c, 827, malloc(960))
        p = st_get(c, 827) + d * 32
        store_i64(p, nl)
        store_i64(p + 8, nt)
        store_i64(p + 16, nr)
        store_i64(p + 24, nb)
        st_set(c, 828, d + 1)
    st_set(c, 829, nl)
    st_set(c, 830, nt)
    st_set(c, 831, nr)
    st_set(c, 832, nb)
    plat_clip_push(c, nl, nt, nr, nb)

def ui_clip_pop(c: UI):
    if st_get(c, 833) != 0:
        d = st_get(c, 828)
        if d > 0:
            d = d - 1
            st_set(c, 828, d)
            if d > 0:
                p = st_get(c, 827) + (d - 1) * 32
                st_set(c, 829, load_i64(p))
                st_set(c, 830, load_i64(p + 8))
                st_set(c, 831, load_i64(p + 16))
                st_set(c, 832, load_i64(p + 24))
            else:
                ui_clip_canvas(c, 0, 0, c.w, c.h)
    plat_clip_pop(c)

# ---- text-measure cache (64 entries, direct mapped) ----
#
# Every button, checkbox, radio, tab, menu title, spin arrow, combo item and
# selected text range measures its text EVERY frame, and a measure is the
# single most expensive thing in a widget frame: a UTF-16 conversion, an
# lstrlenW and a platform text-extent call (GetTextExtentPoint32W on Windows,
# XftTextExtentsUtf8 on X11 — an X round trip). The same string is measured
# again next frame, and the frame after that.
#
# st 834 = block ptr. Entry = [hash+1, from, to, w, h] (hash+1 so 0 = empty).
# The key is (content hash, from, to) rather than the string pointer, so two
# equal strings at different addresses share one entry — the common case for
# literals, table cells and labels that come from a model. The hash is a
# bounded polynomial kept under 2^30 (signed overflow is UB in this
# language, see web/http_buf.ax content_hash), which makes a false hit ~1e-8
# per lookup and costs at most a label centered a few pixels off.
#
# The cache assumes the FONT never changes after plat_init, which is true of
# both backends (ui_font_mono / ui_font_sans swap which face c.font points at
# among the same two sizes). A different size would need ui_state_free + a
# re-init, or an explicit drop.

def measure_hash(s: string, f: int, t: int) -> int:
    h = 7
    i = f
    while i < t:
        h = (h * 131 + load_u8(s, i) + 1) % 1073741789
        i = i + 1
    return h

def measure_cache(c: UI) -> int:
    blk = st_get(c, 834)
    if blk == 0:
        blk = malloc(2560)
        fill_zero(blk, 2560)
        st_set(c, 834, blk)
    return blk

def ui_measure(c: UI, s: string) -> TextSize:
    return ui_measure_sub(c, s, 0, len(s))

def ui_measure_sub(c: UI, s: string, f: int, t: int) -> TextSize:
    n = len(s)
    if f < 0:
        f = 0
    if t > n:
        t = n
    if t <= f:
        return plat_measure_sub(c, s, f, t)
    hv = measure_hash(s, f, t)
    blk = measure_cache(c)
    e = (hv % 64) * 40
    if load_i64(blk + e) == hv + 1 and load_i64(blk + e + 8) == f and load_i64(blk + e + 16) == t:
        return TextSize(w=load_i64(blk + e + 24), h=load_i64(blk + e + 32))
    ts = plat_measure_sub(c, s, f, t)
    store_i64(blk + e, hv + 1)
    store_i64(blk + e + 8, f)
    store_i64(blk + e + 16, t)
    store_i64(blk + e + 24, ts.w)
    store_i64(blk + e + 32, ts.h)
    return ts

# ---- drawing primitives: thin, stable names over the backend ----
# The widget layer calls THESE; each forwards to the backend primitive of
# the same name. Keeping one spelling in the widget code means a backend
# only has to implement `plat_*`. Each one first asks whether the clip can
# possibly show what it is about to draw — a scrolled-away row then costs a
# few slot reads instead of a platform call.

def ui_fill_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    if not rect_visible(c, x, y, w, h):
        return
    plat_fill_rect(c, x, y, w, h, color)

def ui_frame_rect(c: UI, x: int, y: int, w: int, h: int, color: int):
    if not rect_visible(c, x, y, w, h):
        return
    plat_frame_rect(c, x, y, w, h, color)

def round_fill(c: UI, x: int, y: int, w: int, h: int, fill: int, border: int):
    if not rect_visible(c, x, y, w, h):
        return
    plat_round_fill(c, x, y, w, h, fill, border)

def ui_ellipse(c: UI, x: int, y: int, w: int, h: int, fill: int, border: int):
    if not rect_visible(c, x, y, w, h):
        return
    plat_ellipse(c, x, y, w, h, fill, border)

def ui_ellipse_fill(c: UI, x: int, y: int, w: int, h: int, fill: int):
    if not rect_visible(c, x, y, w, h):
        return
    plat_ellipse_fill(c, x, y, w, h, fill)

def ui_draw_line(c: UI, x1: int, y1: int, x2: int, y2: int, color: int):
    l = x1
    if x2 < l:
        l = x2
    r = x1
    if x2 > r:
        r = x2
    t = y1
    if y2 < t:
        t = y2
    b = y1
    if y2 > b:
        b = y2
    if not rect_visible(c, l, t, r - l + 1, b - t + 1):
        return
    plat_line(c, x1, y1, x2, y2, color)

def ui_draw_text(c: UI, x: int, y: int, s: string, color: int):
    if not text_visible(c, x, y, len(s)):
        return
    plat_text(c, x, y, s, color)

def ui_draw_text_big(c: UI, x: int, y: int, s: string, color: int):
    if not text_visible(c, x, y, len(s)):
        return
    plat_text_big(c, x, y, s, color)

def ui_draw_text_sub(c: UI, x: int, y: int, s: string, f: int, t: int, color: int):
    n = t - f
    if n < 0:
        n = 0
    if not text_visible(c, x, y, n):
        return
    plat_text_sub(c, x, y, s, f, t, color)

# ---- widgets (immediate mode: call every frame, own the state yourself) ----

# focus ring + keyboard activation shared by the interactive widgets
def focus_ring(c: UI, x: int, y: int, w: int, h: int, id: int, pal: Palette):
    if ui_focused(c, id):
        ui_frame_rect(c, x - 2, y - 2, w + 4, h + 4, pal.accent)

def key_activate(c: UI, id: int) -> bool:
    if not ui_focused(c, id):
        return False
    return ui_key_pressed(c, 13) or ui_key_pressed(c, 32)

def ui_button(c: UI, x: int, y: int, w: int, h: int, s: string) -> bool:
    id = ui_wid_id(x, y)
    off = ui_disabled(c)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    clicked = False
    if act == id and c.dn_prev and not c.dn:
        if hot:
            clicked = True
        st_set(c, 0, 0)
        act = 0
    if key_activate(c, id) and not off:
        clicked = True
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.widget
    if off:
        face = pal.disabled_face
    if hot and act == id:
        face = pal.widget_down
    elif hot:
        face = pal.widget_hover
    pen = pal.border
    if hot:
        pen = pal.accent
    ts = ui_measure(c, s)
    tx = x + (w - ts.w) / 2
    ty = y + (h - ts.h) / 2
    if hot and act == id:
        ty = ty + 1
    round_fill(c, x, y, w, h, face, pen)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ui_draw_text(c, tx, ty, s, tcol)
    if not off:
        focus_ring(c, x, y, w, h, id, pal)
    return clicked

def ui_label(c: UI, x: int, y: int, s: string):
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, s, pal.text)

def ui_label_dim(c: UI, x: int, y: int, s: string):
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, s, pal.text_dim)

# label + decimal int without building a concatenated string per frame
def ui_label_int(c: UI, x: int, y: int, prefix: string, v: int):
    pal = ui_palette_get(c)
    ui_draw_text(c, x, y, prefix, pal.text)
    ts = ui_measure(c, prefix)
    p = itoa10(c, v)
    ui_draw_text(c, x + ts.w, y, as_string(p), pal.text)

def ui_title(c: UI, x: int, y: int, s: string):
    pal = ui_palette_get(c)
    ui_draw_text_big(c, x, y, s, pal.text)

def ui_checkbox(c: UI, x: int, y: int, s: string, checked: bool) -> bool:
    result = checked
    off = ui_disabled(c)
    ts = ui_measure(c, s)
    hot = ui_mouse_in(c, x, y, 22 + ts.w, 20) and not off
    id = ui_wid_id(x, y)
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        if hot:
            result = not checked
        st_set(c, 0, 0)
    if key_activate(c, id) and not off:
        result = not checked
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    box_face = pal.panel
    if off:
        box_face = pal.disabled_face
    ui_fill_rect(c, x, y + 2, 15, 15, box_face)
    ui_frame_rect(c, x, y + 2, 15, 15, pal.border)
    if checked:
        tick = pal.accent
        if off:
            tick = pal.disabled_text
        ui_draw_line(c, x + 3, y + 9, x + 6, y + 13, tick)
        ui_draw_line(c, x + 6, y + 13, x + 12, y + 4, tick)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ui_draw_text(c, x + 22, y, s, tcol)
    if not off:
        focus_ring(c, x, y, 22 + ts.w, 20, id, pal)
    return result

# horizontal slider, 20 px tall; returns the (possibly dragged) value
def ui_slider(c: UI, x: int, y: int, w: int, value: int, vmin: int, vmax: int) -> int:
    id = ui_wid_id(x, y)
    off = ui_disabled(c)
    hot = ui_mouse_in(c, x - 8, y - 4, w + 16, 28) and not off
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
        act = 0
    if act == id and c.dn:
        span = w - 10
        if span < 1:
            span = 1
        value = vmin + (c.mx - (x + 5)) * (vmax - vmin) / span
    if ui_focused(c, id) and not off:
        step = (vmax - vmin) / 20
        if step < 1:
            step = 1
        if ui_key_pressed(c, 37):
            value = value - step
        if ui_key_pressed(c, 39):
            value = value + step
    if value < vmin:
        value = vmin
    if value > vmax:
        value = vmax
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    ui_fill_rect(c, x + 4, y + 9, w - 8, 4, pal.groove)
    rng = vmax - vmin
    if rng < 1:
        rng = 1
    chunk = (value - vmin) * (w - 10) / rng
    if chunk < 0:
        chunk = 0
    if chunk > w - 10:
        chunk = w - 10
    if chunk > 0:
        fill = pal.accent
        if off:
            fill = pal.disabled_text
        ui_fill_rect(c, x + 4, y + 9, chunk, 4, fill)
    face = pal.widget
    if off:
        face = pal.disabled_face
    round_fill(c, x + chunk, y + 1, 10, 18, face, pal.border)
    if not off:
        focus_ring(c, x, y, w, 20, id, pal)
    return value

def ui_progress(c: UI, x: int, y: int, w: int, value: int, vmax: int):
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, 8, pal.groove)
    top = vmax
    if top < 1:
        top = 1
    cw = value * w / top
    if cw < 0:
        cw = 0
    if cw > w:
        cw = w
    if cw > 0:
        ui_fill_rect(c, x, y, cw, 8, pal.accent)

def ui_separator(c: UI, x: int, y: int, w: int):
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, 1, pal.border)

def ui_panel(c: UI, x: int, y: int, w: int, h: int):
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, h, pal.panel)

# ---- widgets v2: selection, text input, containers, overlays ----

# toggle (checkable push button): on = accent face + selected text
def ui_toggle(c: UI, x: int, y: int, w: int, h: int, s: string, on: bool) -> bool:
    result = on
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        if hot:
            result = not on
        st_set(c, 0, 0)
        act = 0
    if key_activate(c, id) and not off:
        result = not on
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.widget
    tcol = pal.text
    if result:
        face = pal.accent
        tcol = pal.sel_text
    if off:
        face = pal.disabled_face
        tcol = pal.disabled_text
    if hot and act == id:
        face = pal.widget_down
        if result:
            face = pal.sel
    pen = pal.border
    if hot:
        pen = pal.accent
    ts = ui_measure(c, s)
    tx = x + (w - ts.w) / 2
    ty = y + (h - ts.h) / 2
    if hot and act == id:
        ty = ty + 1
    round_fill(c, x, y, w, h, face, pen)
    ui_draw_text(c, tx, ty, s, tcol)
    if not off:
        focus_ring(c, x, y, w, h, id, pal)
    return result

# radio button inside an exclusive group: `group` is the group's current
# value, `item` is this button's value; returns the (possibly new) value
def ui_radio(c: UI, x: int, y: int, s: string, group: int, item: int) -> int:
    result = group
    off = ui_disabled(c)
    ts = ui_measure(c, s)
    hot = ui_mouse_in(c, x, y, 22 + ts.w, 20) and not off
    id = ui_wid_id(x, y)
    act = st_get(c, 0)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
    if act == id and c.dn_prev and not c.dn:
        if hot:
            result = item
        st_set(c, 0, 0)
    if key_activate(c, id) and not off:
        result = item
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    # circle: filled disc + ring, inner dot when selected
    ring_face = pal.panel
    if off:
        ring_face = pal.disabled_face
    ui_ellipse(c, x, y + 3, 15, 15, ring_face, pal.border)
    if result == item:
        dot = pal.accent
        if off:
            dot = pal.disabled_text
        ui_ellipse_fill(c, x + 4, y + 7, 7, 7, dot)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ui_draw_text(c, x + 22, y, s, tcol)
    if not off:
        focus_ring(c, x, y, 22 + ts.w, 20, id, pal)
    return result

# Qt-style group box: thin frame with the title punched through the top line
def ui_groupbox(c: UI, x: int, y: int, w: int, h: int, title: string):
    pal = ui_palette_get(c)
    ui_frame_rect(c, x, y + 8, w, h - 8, pal.border)
    if len(title) > 0:
        ts = ui_measure(c, title)
        ui_fill_rect(c, x + 12, y, ts.w + 10, 16, pal.bg)
        ui_draw_text(c, x + 17, y, title, pal.text_dim)

# integer spin box: value field + stacked up/down buttons; arrows step by 1
# (shift of the range / 20 is NOT done — spin boxes count)
def ui_spinbox(c: UI, x: int, y: int, w: int, value: int, vmin: int, vmax: int) -> int:
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    h = 28
    btn_w = 20
    up_h = h / 2
    hot_up = ui_mouse_in(c, x + w - btn_w, y, btn_w, up_h) and not off
    hot_dn = ui_mouse_in(c, x + w - btn_w, y + up_h, btn_w, h - up_h) and not off
    hot = ui_mouse_in(c, x, y, w, h) and not off
    edge = c.dn and not c.dn_prev
    if edge and st_get(c, 0) == 0:
        if hot_up and value < vmax:
            value = value + 1
            ui_focus(c, id)
        elif hot_dn and value > vmin:
            value = value - 1
            ui_focus(c, id)
        elif hot:
            ui_focus(c, id)
    if ui_focused(c, id) and not off:
        if ui_key_pressed(c, 38) and value < vmax:
            value = value + 1
        if ui_key_pressed(c, 40) and value > vmin:
            value = value - 1
    if value < vmin:
        value = vmin
    if value > vmax:
        value = vmax
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if ui_focused(c, id):
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    # stacked up/down buttons on the right
    up_face = pal.widget
    dn_face = pal.widget
    if hot_up:
        up_face = pal.widget_hover
    if hot_dn:
        dn_face = pal.widget_hover
    if off:
        up_face = pal.disabled_face
        dn_face = pal.disabled_face
    ui_fill_rect(c, x + w - btn_w, y, btn_w, up_h, up_face)
    ui_fill_rect(c, x + w - btn_w, y + up_h, btn_w, h - up_h, dn_face)
    ui_draw_line(c, x + w - btn_w, y + up_h, x + w, y + up_h, pal.border)
    acol = pal.text
    if off:
        acol = pal.disabled_text
    ts_up = ui_measure(c, "▲")
    ui_draw_text(c, x + w - btn_w + (btn_w - ts_up.w) / 2, y + 1, "▲", acol)
    ts_dn = ui_measure(c, "▼")
    ui_draw_text(c, x + w - btn_w + (btn_w - ts_dn.w) / 2, y + up_h + 1, "▼", acol)
    p = itoa10(c, value)
    ts_v = ui_measure(c, as_string(p))
    ui_draw_text(c, x + 8, y + (h - ts_v.h) / 2, as_string(p), acol)
    return value

# ---- text input ----

struct TextEdit:
    text: string
    changed: bool
    enter: bool

# UTF-16 of s[from, to) into the per-frame arena (NUL-terminated) — the
# measure/draw path builds no Aoxn strings and mallocs nothing
def utf16f_sub(c: UI, s: string, from: int, to: int) -> int:
    need = (to - from) * 2 + 2
    off = st_get(c, 2)
    if st_get(c, 1) == 0 or off + need > st_get(c, 3):
        p = malloc(need)
        nb = utf16_write_sub(s, from, to, p)
        store_u8(p, nb, 0)
        store_u8(p, nb + 1, 0)
        return p
    p = st_get(c, 1) + off
    nb = utf16_write_sub(s, from, to, p)
    store_u8(p, nb, 0)
    store_u8(p, nb + 1, 0)
    st_set(c, 2, off + nb + 2)
    return p

# nearest caret byte offset to mouse x within the byte range [from, to).
# Measures ONE codepoint at a time and accumulates — O(n) GDI calls. The
# first version re-measured s[0..j) for every codepoint, which made a click
# into a long line O(n²) (a second of GDI at ~4000 chars); textedit also
# carried two inline copies of that loop.
#
# It goes straight to plat_measure_sub, NOT through the ui_measure_sub cache:
# these ranges are one codepoint wide and never repeat, so caching them would
# cost a hash per codepoint and flush the entries the widgets actually reuse.
def text_pos_in_range(c: UI, s: string, from: int, to: int, tx: int, mx: int) -> int:
    i = from
    acc = 0
    while i < to:
        j = caret_right(s, i)
        w1 = plat_measure_sub(c, s, i, j).w
        if mx < tx + acc + w1 / 2:
            return i
        acc = acc + w1
        i = j
    return to

# single-line convenience: the whole string, left edge at tx
def text_pos_from_x(c: UI, s: string, tx: int, mx: int) -> int:
    return text_pos_in_range(c, s, 0, len(s), tx, mx)

# caret x-offset with a one-entry cache at st 532..535 (owner id / caret /
# text length / width). An idle focused field measures nothing per frame —
# the miss condition is a keystroke, exactly when a re-measure is needed.
# `from` must be determined by (s, caret) — 0 for a textbox, the caret's
# line start for a textedit — so the key does not need it.
def caret_offset(c: UI, id: int, s: string, from: int, caret: int) -> int:
    if st_get(c, 532) == id and st_get(c, 533) == caret and st_get(c, 534) == len(s):
        return st_get(c, 535)
    w = ui_measure_sub(c, s, from, caret).w
    st_set(c, 532, id)
    st_set(c, 533, caret)
    st_set(c, 534, len(s))
    st_set(c, 535, w)
    return w

# single-line text field WITH SELECTION: shift+arrows extend, mouse drag
# selects, Ctrl+A/C/X/V do the usual. Returns the edited text plus
# change/enter flags; caret/anchor live in shared slots (539/819) so the
# selection survives frames without the app storing anything.
def ui_textbox(c: UI, x: int, y: int, w: int, h: int, text: string) -> TextEdit:
    res = TextEdit(text=text, changed=False, enter=False)
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    focused = ui_focused(c, id)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    s = text
    caret = st_get(c, 539)
    anchor = st_get(c, 819)
    if focused and st_get(c, 816) != id:
        # first frame of focus (e.g. via Tab): caret at end
        st_set(c, 816, id)
        caret = len(s)
        anchor = caret
    if caret > len(s):
        caret = len(s)
    if anchor > len(s):
        anchor = len(s)
    act = st_get(c, 0)
    shift = ui_key_down(c, 16)
    ctrl = ui_key_down(c, 17)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
        focused = True
        st_set(c, 816, id)
        caret = text_pos_from_x(c, s, x + 8, c.mx)
        if not shift:
            anchor = caret
    if act == id and c.dn:
        caret = text_pos_from_x(c, s, x + 8, c.mx)
    if act == id and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
        act = 0
    if focused and not off:
        if ctrl and ui_key_pressed(c, 65):
            anchor = 0
            caret = len(s)
        if ctrl and (ui_key_pressed(c, 67) or ui_key_pressed(c, 88)) and anchor != caret:
            lo = anchor
            hi = caret
            if anchor > caret:
                lo = caret
                hi = anchor
            ui_clip_set(c, str_sub(s, lo, hi))
            if ui_key_pressed(c, 88):
                me0 = edit_delete(c, s, anchor, caret)
                s = me0.text
                anchor = me0.anchor
                caret = me0.caret
                res.changed = True
        if ctrl and ui_key_pressed(c, 86):
            clip = ui_clip_get(c)
            if len(clip) > 0:
                me0 = edit_type(c, s, anchor, caret, clip)
                s = me0.text
                anchor = me0.anchor
                caret = me0.caret
                res.changed = True
        cnt = ui_char_count(c)
        if cnt > 0 and not ctrl:
            ins = ui_char_str(c)
            me0 = edit_type(c, s, anchor, caret, ins)
            s = me0.text
            anchor = me0.anchor
            caret = me0.caret
            res.changed = True
        if ui_key_pressed(c, 8):
            me0 = edit_backspace(c, s, anchor, caret)
            s = me0.text
            anchor = me0.anchor
            caret = me0.caret
            if me0.changed:
                res.changed = True
        if ui_key_pressed(c, 46):
            me0 = edit_delete(c, s, anchor, caret)
            s = me0.text
            anchor = me0.anchor
            caret = me0.caret
            if me0.changed:
                res.changed = True
        if ui_key_pressed(c, 37):
            sl = edit_left(c, s, anchor, caret, shift)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 39):
            sl = edit_right(c, s, anchor, caret, shift)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 36):
            sl = edit_home(c, s, anchor, caret, shift, ctrl)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 35):
            sl = edit_end(c, s, anchor, caret, shift, ctrl)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 13):
            res.enter = True
    st_set(c, 539, caret)
    st_set(c, 819, anchor)
    res.text = s
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if focused:
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    ui_clip_push(c, x + 4, y, x + w - 4, y + h)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    ts = ui_measure_sub(c, s, 0, len(s))
    ty = y + (h - ts.h) / 2
    lo = anchor
    hi = caret
    if anchor > caret:
        lo = caret
        hi = anchor
    if lo < hi:
        t1 = ui_measure_sub(c, s, 0, lo)
        t2 = ui_measure_sub(c, s, 0, hi)
        ui_fill_rect(c, x + 8 + t1.w, y + 2, t2.w - t1.w, h - 4, pal.sel)
        ui_draw_text_sub(c, x + 8, ty, s, 0, lo, tcol)
        ui_draw_text_sub(c, x + 8 + t1.w, ty, s, lo, hi, pal.sel_text)
        ui_draw_text_sub(c, x + 8 + t2.w, ty, s, hi, len(s), tcol)
    else:
        ui_draw_text_sub(c, x + 8, ty, s, 0, len(s), tcol)
    if focused and not off:
        if plat_now_ms() % 1000 < 650:
            t3w = caret_offset(c, id, s, 0, caret)
            ui_fill_rect(c, x + 8 + t3w, y + 5, 2, h - 10, pal.text)
    ui_clip_pop(c)
    return res

# ---- list box ----

struct ListPick:
    cur: int
    scroll: int

# scrollable single-select list. `scroll` is the first visible item (the
# caller keeps it, like every other widget value); wheel and the scrollbar
# move it. Returns the selection and the updated scroll offset.
def ui_listbox[N](c: UI, x: int, y: int, w: int, h: int, items: [string; N], n: int, cur: int, scroll: int) -> ListPick:
    item_h = 26
    vis = h / item_h
    if vis < 1:
        vis = 1
    maxs = n - vis
    if maxs < 0:
        maxs = 0
    if scroll > maxs:
        scroll = maxs
    if scroll < 0:
        scroll = 0
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    has_sb = n > vis
    sbw = 12
    if not has_sb:
        sbw = 0
    hot = ui_mouse_in(c, x, y, w - sbw, h) and not off
    if hot and has_sb and not off:
        scroll = scroll - ui_wheel(c) / 120
        if scroll > maxs:
            scroll = maxs
        if scroll < 0:
            scroll = 0
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if ui_focused(c, id):
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    ui_clip_push(c, x + 1, y + 1, x + w - sbw - 1, y + h - 1)
    i = 0
    while i < vis and i < n:
        it = i + scroll
        iy = y + i * item_h
        if it == cur:
            ui_fill_rect(c, x + 1, iy, w - sbw - 2, item_h, pal.sel)
        elif hot and c.my >= iy and c.my < iy + item_h:
            ui_fill_rect(c, x + 1, iy, w - sbw - 2, item_h, pal.widget_hover)
        tcol = pal.text
        if it == cur:
            tcol = pal.sel_text
        if off:
            tcol = pal.disabled_text
        ui_draw_text(c, x + 8, iy + (item_h - 16) / 2, items[it], tcol)
        i = i + 1
    ui_clip_pop(c)
    # selection: press + release inside the list
    if hot and c.dn and not c.dn_prev and st_get(c, 0) == 0:
        st_set(c, 0, id)
        ui_focus(c, id)
    if st_get(c, 0) == id and c.dn_prev and not c.dn:
        if hot:
            it = scroll + (c.my - y) / item_h
            if it >= 0 and it < n:
                cur = it
        st_set(c, 0, 0)
    # scrollbar
    if has_sb:
        scroll = sb_widget(c, x, y, w, h, sbw, y, h, n, vis, scroll, maxs, off)
    return ListPick(cur=cur, scroll=scroll)

# ---- tab bar ----

# tab strip: click selects; the caller draws the page content below
def ui_tabs[N](c: UI, x: int, y: int, w: int, labels: [string; N], n: int, cur: int) -> int:
    off = ui_disabled(c)
    th = 30
    pal = ui_palette_get(c)
    tx = x
    i = 0
    while i < n:
        ts = ui_measure(c, labels[i])
        tw = ts.w + 28
        if i == cur:
            ui_fill_rect(c, tx, y, tw, th, pal.panel)
            ui_fill_rect(c, tx, y, tw, 3, pal.accent)
            ui_draw_text(c, tx + 14, y + (th - ts.h) / 2 + 1, labels[i], pal.text)
        else:
            ui_fill_rect(c, tx, y, tw, th, pal.widget)
            tcol = pal.text_dim
            if off:
                tcol = pal.disabled_text
            ui_draw_text(c, tx + 14, y + (th - ts.h) / 2 + 1, labels[i], tcol)
        hot = ui_mouse_in(c, tx, y, tw, th) and not off
        id = ui_wid_id(x + i, y)
        if hot and c.dn and not c.dn_prev and st_get(c, 0) == 0:
            st_set(c, 0, id)
            ui_focus(c, id)
        if st_get(c, 0) == id and c.dn_prev and not c.dn:
            if hot:
                cur = i
            st_set(c, 0, 0)
        if hot:
            ui_frame_rect(c, tx, y, tw, th, pal.accent)
        tx = tx + tw
        i = i + 1
    ui_fill_rect(c, x, y + th, w, 1, pal.border)
    return cur

# ---- combo box (drop-down; the popup list is drawn on top in ui_present) ----

# closed: a button with the current item; press opens a popup list below.
# The popup survives frames via the overlay record; pressing an item picks
# it (and swallows the click), pressing anywhere else closes without a pick.
def ui_combobox[N](c: UI, x: int, y: int, w: int, items: [string; N], n: int, cur: int) -> int:
    if cur < 0:
        cur = 0
    if cur >= n:
        cur = n - 1
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    h = 28
    item_h = 26
    # the popup shows at most the first 32 items (the overlay item slots end
    # at st 815); scrolling further used to read garbage pointers
    pop_n = n
    if pop_n > 32:
        pop_n = 32
    vis = pop_n
    if vis > 12:
        vis = 12
    ov = ui_overlay_kind(c)
    mine = ov == 1 and st_get(c, 546) == id
    edge = c.dn and not c.dn_prev
    hot = ui_mouse_in(c, x, y, w, h) and not off
    # popup geometry (matches what ui_present draws)
    py = y + h
    ph = vis * item_h
    in_popup = mine and ui_mouse_in(c, x, py, w, ph) and not off
    if edge and not off:
        if mine and hot:
            ui_overlay_clear(c)
            st_set(c, 0, -1)
        elif mine and in_popup:
            it = st_get(c, 553) + (c.my - py) / item_h
            if it >= 0 and it < pop_n:
                cur = it
            ui_overlay_clear(c)
            st_set(c, 0, -1)
        elif mine:
            ui_overlay_clear(c)
        elif hot and (st_get(c, 0) == 0 or ov == 1):
            st_set(c, 545, 1)
            st_set(c, 546, id)
            st_set(c, 547, x)
            st_set(c, 548, py)
            st_set(c, 549, w)
            st_set(c, 550, item_h)
            st_set(c, 551, pop_n)
            st_set(c, 552, cur)
            st_set(c, 553, 0)
            overlay_items_store(c, items, pop_n)
            st_set(c, 0, -1)
    if mine and in_popup and not edge:
        scroll = st_get(c, 553) - ui_wheel(c) / 120
        maxs = pop_n - vis
        if maxs < 0:
            maxs = 0
        if scroll > maxs:
            scroll = maxs
        if scroll < 0:
            scroll = 0
        st_set(c, 553, scroll)
    if not off:
        ui_focus_reg(c, id)
    # closed box
    pal = ui_palette_get(c)
    face = pal.widget
    tcol = pal.text
    if off:
        face = pal.disabled_face
        tcol = pal.disabled_text
    pen = pal.border
    if hot or mine:
        pen = pal.accent
    round_fill(c, x, y, w, h, face, pen)
    if n > 0:
        ts = ui_measure(c, items[cur])
        ui_draw_text(c, x + 10, y + (h - ts.h) / 2, items[cur], tcol)
    ts_a = ui_measure(c, "▼")
    ui_draw_text(c, x + w - ts_a.w - 10, y + (h - ts_a.h) / 2, "▼", tcol)
    if ui_focused(c, id) and not off:
        focus_ring(c, x, y, w, h, id, pal)
    return cur

# ---- shared vertical scrollbar (list / tree / table / textedit / scroll) ----
#
# The groove + thumb for the column [x+w-sbw, x+w) over track rows
# [sy, sy+sh), plus the press-claim / drag / release cycle on the
# active-widget slot. Returns the (possibly dragged) scroll. The hit column
# spans the FULL widget height (y..y+h) even when the track starts lower
# (table header), matching the old per-widget copies. Callers guarantee
# total > visible (only widgets that show a bar call this).

def sb_widget(c: UI, x: int, y: int, w: int, h: int, sbw: int, sy: int, sh: int, total: int, visible: int, scroll: int, maxs: int, off: bool) -> int:
    id = ui_wid_id(x + w, y)
    pal = ui_palette_get(c)
    track = sh
    if track < 1:
        track = 1
    th = track * visible / total
    if th < 24:
        th = 24
    if th > track:
        th = track
    ui_fill_rect(c, x + w - sbw, sy, sbw, sh, pal.groove)
    ty = sy
    if maxs > 0:
        ty = sy + (track - th) * scroll / maxs
    tface = pal.widget
    hot_sb = ui_mouse_in(c, x + w - sbw, y, sbw, h) and not off
    if st_get(c, 0) == id:
        tface = pal.widget_down
    elif hot_sb:
        tface = pal.widget_hover
    round_fill(c, x + w - sbw + 2, ty, sbw - 4, th, tface, pal.border)
    if hot_sb and c.dn and not c.dn_prev and st_get(c, 0) == 0:
        st_set(c, 0, id)
    if st_get(c, 0) == id and c.dn:
        denom = track - th
        if denom < 1:
            denom = 1
        scroll = (c.my - sy - th / 2) * maxs / denom
        if scroll > maxs:
            scroll = maxs
        if scroll < 0:
            scroll = 0
    if st_get(c, 0) == id and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
    return scroll

# ---- scroll area (clipped viewport with wheel + scrollbar) ----

# Begin a clipped viewport: returns the NEW scroll offset; draw your content
# at (x + pad, y - scroll). ui_scroll_end MUST close the region (it pops the
# GDI clip stack). content_h is the full height of the content in px.
def ui_scroll_begin(c: UI, x: int, y: int, w: int, h: int, scroll_y: int, content_h: int) -> int:
    maxs = content_h - h
    if maxs < 0:
        maxs = 0
    has_sb = content_h > h
    sbw = 12
    if not has_sb:
        sbw = 0
    off = ui_disabled(c)
    hot = ui_mouse_in(c, x, y, w, h) and not off
    if hot and not off:
        scroll_y = scroll_y - ui_wheel(c) * 32 / 120
        if scroll_y > maxs:
            scroll_y = maxs
        if scroll_y < 0:
            scroll_y = 0
    # scrollbar input + draw happen BEFORE the content clip below, or the
    # bar would clip itself away (the clip excludes the scrollbar column)
    if has_sb:
        scroll_y = sb_widget(c, x, y, w, h, sbw, y, h, content_h, h, scroll_y, maxs, off)
    ui_clip_push(c, x, y, x + w - sbw, y + h)
    return scroll_y

def ui_scroll_end(c: UI):
    ui_clip_pop(c)

# ---- horizontal scroll area ----
#
# The horizontal twin of ui_scroll_begin/ui_scroll_end: a clipped viewport
# whose content is drawn at (x - scroll_x, y + pad), with a BOTTOM scrollbar
# over track [x, x+w) and content clipped to [x, x+w) x [y, y+h-sbw).
# Nests with the vertical variant: the clip stack intersects, so
# begin+begin_h+draw+end+end_h leaves the content region only. Wheel input
# is not wired yet (Windows WM_MOUSEHWHEEL / X11 buttons 6+7); drag the bar.

# ---- shared horizontal scrollbar (mirror of sb_widget: x/y swap, the
# thumb rides on c.mx, the hit row is the FULL widget width) ----

def sb_widget_h(c: UI, x: int, y: int, w: int, h: int, sbw: int, sx: int, sw: int, total: int, visible: int, scroll: int, maxs: int, off: bool) -> int:
    id = ui_wid_id(x, y + h)
    pal = ui_palette_get(c)
    track = sw
    if track < 1:
        track = 1
    tw = track * visible / total
    if tw < 24:
        tw = 24
    if tw > track:
        tw = track
    ui_fill_rect(c, sx, y + h - sbw, sw, sbw, pal.groove)
    tx = sx
    if maxs > 0:
        tx = sx + (track - tw) * scroll / maxs
    tface = pal.widget
    hot_sb = ui_mouse_in(c, x, y + h - sbw, w, sbw) and not off
    if st_get(c, 0) == id:
        tface = pal.widget_down
    elif hot_sb:
        tface = pal.widget_hover
    round_fill(c, tx, y + h - sbw + 2, tw, sbw - 4, tface, pal.border)
    if hot_sb and c.dn and not c.dn_prev and st_get(c, 0) == 0:
        st_set(c, 0, id)
    if st_get(c, 0) == id and c.dn:
        denom = track - tw
        if denom < 1:
            denom = 1
        scroll = (c.mx - sx - tw / 2) * maxs / denom
        if scroll > maxs:
            scroll = maxs
        if scroll < 0:
            scroll = 0
    if st_get(c, 0) == id and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
    return scroll

# Begin a horizontal clipped viewport: returns the NEW scroll offset; draw
# your content at (x - scroll_x, y) INSIDE the region. ui_scroll_end_h MUST
# close it (it pops the clip stack). content_w is the full content width.
def ui_scroll_begin_h(c: UI, x: int, y: int, w: int, h: int, scroll_x: int, content_w: int) -> int:
    maxs = content_w - w
    if maxs < 0:
        maxs = 0
    has_sb = content_w > w
    sbw = 12
    if not has_sb:
        sbw = 0
    off = ui_disabled(c)
    # scrollbar input + draw happen BEFORE the content clip below, or the
    # bar would clip itself away (the clip excludes the scrollbar row)
    if has_sb:
        scroll_x = sb_widget_h(c, x, y, w, h, sbw, x, w, content_w, w, scroll_x, maxs, off)
    ui_clip_push(c, x, y, x + w, y + h - sbw)
    return scroll_x

def ui_scroll_end_h(c: UI):
    ui_clip_pop(c)

# ---- fonts ----

# Switch the widget layer's body font to the backend's MONOSPACE face
# (Consolas on Windows, the fontconfig "Monospace" alias on Linux). Every
# widget drawn after the call measures and renders with it. Returns the
# updated context (write-back idiom); a no-op when the backend could not
# open the face (c.font_mono stays 0).
def ui_font_mono(c: UI) -> UI:
    if c.font_mono != 0:
        c.font = c.font_mono
    return c

# Restore the sans body font the backend opened at init (handle parked in
# st 826). Returns the updated context.
def ui_font_sans(c: UI) -> UI:
    f = st_get(c, 826)
    if f != 0:
        c.font = f
    return c

# ---- tooltip (hover the rect for ~0.55s; drawn on top in ui_present) ----

def ui_tooltip(c: UI, x: int, y: int, w: int, h: int, text: string):
    if ui_disabled(c):
        return
    id = ui_wid_id(x, y)
    hot = ui_mouse_in(c, x, y, w, h)
    if hot:
        ms = ui_hover_ms(c, id, plat_now_ms())
        if ms >= 550:
            st_set(c, 545, 2)
            st_set(c, 546, id)
            st_set(c, 547, c.mx)
            st_set(c, 548, c.my)
            st_set(c, 554, as_ptr(text))
    else:
        if st_get(c, 556) == id:
            ui_hover_reset(c)



struct EditView:
    text: string
    anchor: int
    caret: int
    changed: bool
    scroll: int

# full editor: Enter inserts a newline, Tab navigates (like every widget),
# arrows/up-down/Home/End move (shift extends, Ctrl jumps), Ctrl+A/C/X/V
# select-all/copy/cut/paste, mouse click + drag selects. `scroll` is the
# first visible line (app-owned, like ListPick.scroll).
def ui_textedit(c: UI, x: int, y: int, w: int, h: int, text: string, anchor: int, caret: int, scroll: int) -> EditView:
    res = EditView(text=text, anchor=anchor, caret=caret, changed=False, scroll=scroll)
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    focused = ui_focused(c, id)
    s = text
    if caret > len(s):
        caret = len(s)
    if anchor > len(s):
        anchor = len(s)
    lines_sync(c, id, s)
    cnt = line_count(c)
    row_h = 22
    vis = h / row_h
    if vis < 1:
        vis = 1
    maxs = cnt - vis
    if maxs < 0:
        maxs = 0
    if scroll > maxs:
        scroll = maxs
    if scroll < 0:
        scroll = 0
    sbw = 12
    has_sb = cnt > vis
    if not has_sb:
        sbw = 0
    hot = ui_mouse_in(c, x, y, w - sbw, h) and not off
    if hot and not off:
        scroll = scroll - ui_wheel(c) / 120 * 3
        if scroll > maxs:
            scroll = maxs
        if scroll < 0:
            scroll = 0
    act = st_get(c, 0)
    shift = ui_key_down(c, 16)
    ctrl = ui_key_down(c, 17)
    if hot and c.dn and not c.dn_prev and act == 0:
        st_set(c, 0, id)
        act = id
        ui_focus(c, id)
        focused = True
        row = scroll + (c.my - y) / row_h
        if row >= cnt:
            row = cnt - 1
        if row < 0:
            row = 0
        caret = text_pos_in_range(c, s, line_start(c, row), line_end(c, row), x + 8, c.mx)
        if not shift:
            anchor = caret
    if act == id and c.dn:
        row = scroll + (c.my - y) / row_h
        if row >= cnt:
            row = cnt - 1
        if row < 0:
            row = 0
        caret = text_pos_in_range(c, s, line_start(c, row), line_end(c, row), x + 8, c.mx)
    if act == id and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
        act = 0
    if focused and not off:
        if ctrl and ui_key_pressed(c, 65):
            anchor = 0
            caret = len(s)
        if ctrl and (ui_key_pressed(c, 67) or ui_key_pressed(c, 88)) and anchor != caret:
            lo = anchor
            hi = caret
            if anchor > caret:
                lo = caret
                hi = anchor
            ui_clip_set(c, str_sub(s, lo, hi))
            if ui_key_pressed(c, 88):
                me0 = edit_delete(c, s, anchor, caret)
                s = me0.text
                anchor = me0.anchor
                caret = me0.caret
                res.changed = True
        if ctrl and ui_key_pressed(c, 86):
            clip = ui_clip_get(c)
            if len(clip) > 0:
                me0 = edit_type(c, s, anchor, caret, clip)
                s = me0.text
                anchor = me0.anchor
                caret = me0.caret
                res.changed = True
        cnt2 = ui_char_count(c)
        if cnt2 > 0 and not ctrl:
            ins = ui_char_str(c)
            me0 = edit_type(c, s, anchor, caret, ins)
            s = me0.text
            anchor = me0.anchor
            caret = me0.caret
            res.changed = True
        if ui_key_pressed(c, 13):
            me0 = edit_type(c, s, anchor, caret, "\n")
            s = me0.text
            anchor = me0.anchor
            caret = me0.caret
            res.changed = True
        if ui_key_pressed(c, 8):
            me0 = edit_backspace(c, s, anchor, caret)
            s = me0.text
            anchor = me0.anchor
            caret = me0.caret
            if me0.changed:
                res.changed = True
        if ui_key_pressed(c, 46):
            me0 = edit_delete(c, s, anchor, caret)
            s = me0.text
            anchor = me0.anchor
            caret = me0.caret
            if me0.changed:
                res.changed = True
        if ui_key_pressed(c, 37):
            sl = edit_left(c, s, anchor, caret, shift)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 39):
            sl = edit_right(c, s, anchor, caret, shift)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 38):
            sl = edit_up(c, s, anchor, caret, shift)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 40):
            sl = edit_down(c, s, anchor, caret, shift)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 36):
            sl = edit_home(c, s, anchor, caret, shift, ctrl)
            anchor = sl.anchor
            caret = sl.caret
        if ui_key_pressed(c, 35):
            sl = edit_end(c, s, anchor, caret, shift, ctrl)
            anchor = sl.anchor
            caret = sl.caret
    lines_sync(c, id, s)
    cnt = line_count(c)
    maxs = cnt - vis
    if maxs < 0:
        maxs = 0
    if scroll > maxs:
        scroll = maxs
    if not off:
        ui_focus_reg(c, id)
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if focused:
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    ui_clip_push(c, x + 1, y + 1, x + w - sbw - 1, y + h - 1)
    tcol = pal.text
    if off:
        tcol = pal.disabled_text
    lo = anchor
    hi = caret
    if anchor > caret:
        lo = caret
        hi = anchor
    r = scroll
    while r < cnt and r < scroll + vis:
        ls = line_start(c, r)
        le = line_end(c, r)
        ry = y + (r - scroll) * row_h
        a = lo
        if a < ls:
            a = ls
        b = hi
        if b > le:
            b = le
        if a < b:
            t1 = ui_measure_sub(c, s, ls, a)
            t2 = ui_measure_sub(c, s, ls, b)
            ui_fill_rect(c, x + 8 + t1.w, ry + 2, t2.w - t1.w, row_h - 4, pal.sel)
            ui_draw_text_sub(c, x + 8, ry + 2, s, ls, a, tcol)
            ui_draw_text_sub(c, x + 8 + t1.w, ry + 2, s, a, b, pal.sel_text)
            ui_draw_text_sub(c, x + 8 + t2.w, ry + 2, s, b, le, tcol)
        else:
            ui_draw_text_sub(c, x + 8, ry + 2, s, ls, le, tcol)
        r = r + 1
    if focused and not off:
        if plat_now_ms() % 1000 < 650:
            crow = line_of(c, caret)
            if crow >= scroll and crow < scroll + vis:
                ls2 = line_start(c, crow)
                cw = caret_offset(c, id, s, ls2, caret)
                ui_fill_rect(c, x + 8 + cw, y + (crow - scroll) * row_h + 3, 2, row_h - 6, pal.text)
    ui_clip_pop(c)
    if has_sb:
        scroll = sb_widget(c, x, y, w, h, sbw, y, h, cnt, vis, scroll, maxs, off)
    res.text = s
    res.anchor = anchor
    res.caret = caret
    res.scroll = scroll
    return res

# ---- v3: menu bar (Qt's QMenuBar) ----

struct MenuBar:
    open: int
    x: int
    y: int
    w: int

struct MenuPick:
    open: int
    pick: int

# draw the menu bar and manage which title is open. Call ui_menu right after
# for the open menu's items. Esc / outside click closes.
def ui_menubar[N](c: UI, x: int, y: int, w: int, titles: [string; N], n: int, open: int) -> MenuBar:
    res = MenuBar(open=open, x=x, y=y + 28, w=140)
    pal = ui_palette_get(c)
    ui_fill_rect(c, x, y, w, 28, pal.panel)
    ui_fill_rect(c, x, y + 27, w, 1, pal.border)
    edge = c.dn and not c.dn_prev
    hit_title = False
    tx = x + 4
    i = 0
    while i < n:
        ts = ui_measure(c, titles[i])
        tw = ts.w + 24
        hot = ui_mouse_in(c, tx, y, tw, 28)
        if hot:
            hit_title = True
            if edge and (st_get(c, 0) == 0 or st_get(c, 0) == -1):
                if open == i:
                    res.open = -1
                else:
                    res.open = i
                    res.x = tx
                    res.w = tw
                st_set(c, 0, -1)
            else:
                if open >= 0 and res.open != i:
                    res.open = i
                    res.x = tx
                    res.w = tw
        tx = tx + tw
        i = i + 1
    # the open title keeps its popup anchored to its rect
    tx = x + 4
    i = 0
    while i < n:
        ts = ui_measure(c, titles[i])
        tw = ts.w + 24
        if i == res.open:
            ui_fill_rect(c, tx, y, tw, 28, pal.widget_hover)
            res.x = tx
            res.w = tw
        ui_draw_text(c, tx + 12, y + 5, titles[i], pal.text)
        tx = tx + tw
        i = i + 1
    # outside click (not on a title, not in the open popup) closes the menu
    in_popup = False
    if ui_overlay_kind(c) == 3:
        in_popup = ui_mouse_in(c, st_get(c, 547), st_get(c, 548), st_get(c, 549), st_get(c, 550) * st_get(c, 551))
    if edge and not hit_title and not in_popup and st_get(c, 0) == 0:
        res.open = -1
        st_set(c, 0, -1)
    return res

# draw the OPEN menu's items (caller supplies them; the app owns the menus).
# Returns the picked item index (-1 = none) and the updated open state.
# Keyboard navigation: Up/Down move the highlight (st 552, shared with the
# combo popup's keyboard item), Enter picks it, Esc closes. The open menu is
# MODAL for input: it consumes the navigation keys and the WM_CHAR queue so
# widgets drawn after it in the same frame do not fire on them — call
# ui_menubar / ui_menu BEFORE the page content for that to hold.
def ui_menu[M](c: UI, bar: MenuBar, items: [string; M], m: int) -> MenuPick:
    res = MenuPick(open=bar.open, pick=-1)
    if bar.open < 0:
        if ui_overlay_kind(c) == 3:
            ui_overlay_clear(c)
        return res
    if ui_key_pressed(c, 27):
        res.open = -1
        ui_overlay_clear(c)
        st_set(c, 4 + 27, 0)
        return res
    item_h = 26
    # the popup shows at most the first 32 items (the overlay item slots end
    # at st 815); overlay_item_str reads past them as "" since the clamp fix
    pop_m = m
    if pop_m > 32:
        pop_m = 32
    vis = pop_m
    if vis > 16:
        vis = 16
    w = bar.w
    if w < 140:
        w = 140
    i = 0
    while i < m:
        ts = ui_measure(c, items[i])
        if ts.w + 32 > w:
            w = ts.w + 32
        i = i + 1
    ph = vis * item_h
    # hover state: mouse position wins, Up/Down move it (both wrap), Enter
    # activates — the classic menu keyboard model
    hov = st_get(c, 552)
    if ui_mouse_in(c, bar.x, bar.y, w, ph):
        mr = (c.my - bar.y) / item_h
        if mr >= 0 and mr < vis:
            hov = mr
    if ui_key_pressed(c, 38):
        hov = hov - 1
        if hov < 0:
            hov = vis - 1
    if ui_key_pressed(c, 40):
        hov = hov + 1
        if hov >= vis:
            hov = 0
    if ui_key_pressed(c, 13) and hov >= 0:
        res.pick = hov
        res.open = -1
        ui_overlay_clear(c)
        st_set(c, 0, -1)
        st_set(c, 4 + 13, 0)
        return res
    st_set(c, 545, 3)
    st_set(c, 546, ui_wid_id(bar.x, bar.y))
    st_set(c, 547, bar.x)
    st_set(c, 548, bar.y)
    st_set(c, 549, w)
    st_set(c, 550, item_h)
    st_set(c, 551, pop_m)
    st_set(c, 552, hov)
    st_set(c, 553, 0)
    overlay_items_store(c, items, pop_m)
    edge = c.dn and not c.dn_prev
    if edge and ui_mouse_in(c, bar.x, bar.y, w, ph):
        it = (c.my - bar.y) / item_h
        if it >= 0 and it < vis:
            res.pick = it
            res.open = -1
        ui_overlay_clear(c)
        st_set(c, 0, -1)
    # modal for keys: arrows/Enter/Esc are ours this frame, and typing
    # must not leak into a textbox behind the menu
    st_set(c, 4 + 13, 0)
    st_set(c, 4 + 27, 0)
    st_set(c, 4 + 37, 0)
    st_set(c, 4 + 38, 0)
    st_set(c, 4 + 39, 0)
    st_set(c, 4 + 40, 0)
    st_set(c, 542, 0)
    return res

# ---- v3: tree view (Qt's QTreeView on a TreeModel) ----

struct TreeRet:
    sel: int
    scroll: int

# tree_has_child / tree_nth_visible live in ui.ax now (they are pure model
# math; tree_has_child is O(1) against the per-node child count there).

# flat-list tree view: +/- expander toggles model expansion IN PLACE (the
# model is a pointer — no write-back needed), clicking a label selects.
def ui_tree(c: UI, x: int, y: int, w: int, h: int, m: TreeModel, sel: int, scroll: int) -> TreeRet:
    res = TreeRet(sel=sel, scroll=scroll)
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    n = tree_count(m)
    row_h = 26
    vis = h / row_h
    if vis < 1:
        vis = 1
    vic = 0
    j = 0
    while j < n:
        if tree_visible(m, j):
            vic = vic + 1
        j = j + 1
    maxs = vic - vis
    if maxs < 0:
        maxs = 0
    if res.scroll > maxs:
        res.scroll = maxs
    if res.scroll < 0:
        res.scroll = 0
    sbw = 12
    has_sb = vic > vis
    if not has_sb:
        sbw = 0
    hot = ui_mouse_in(c, x, y, w - sbw, h) and not off
    if hot and has_sb and not off:
        res.scroll = res.scroll - ui_wheel(c) / 120
        if res.scroll > maxs:
            res.scroll = maxs
        if res.scroll < 0:
            res.scroll = 0
    if not off:
        ui_focus_reg(c, id)
    if ui_focused(c, id) and not off:
        delta = 0
        if ui_key_pressed(c, 38):
            delta = -1
        if ui_key_pressed(c, 40):
            delta = 1
        if delta != 0:
            nj = res.sel + delta
            while nj >= 0 and nj < n and not tree_visible(m, nj):
                nj = nj + delta
            if nj >= 0 and nj < n:
                res.sel = nj
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if ui_focused(c, id):
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    ui_clip_push(c, x + 1, y + 1, x + w - sbw - 1, y + h - 1)
    vidx = 0
    j = 0
    while j < n:
        if tree_visible(m, j):
            if vidx >= res.scroll and vidx < res.scroll + vis:
                ry = y + (vidx - res.scroll) * row_h
                d = tree_depth(m, j)
                tx = x + 10 + d * 18
                if j == res.sel:
                    ui_fill_rect(c, x + 1, ry, w - sbw - 2, row_h, pal.sel)
                elif hot and c.my >= ry and c.my < ry + row_h:
                    ui_fill_rect(c, x + 1, ry, w - sbw - 2, row_h, pal.widget_hover)
                lcol = pal.text
                if j == res.sel:
                    lcol = pal.sel_text
                if off:
                    lcol = pal.disabled_text
                if tree_has_child(m, j):
                    mark = "▶"
                    if tree_expanded(m, j):
                        mark = "▼"
                    ui_draw_text(c, tx - 16, ry + 3, mark, lcol)
                ui_draw_text(c, tx + 4, ry + 3, tree_label(m, j), lcol)
            vidx = vidx + 1
        j = j + 1
    ui_clip_pop(c)
    # input: expander toggle vs label select
    if hot and c.dn and not c.dn_prev and st_get(c, 0) == 0:
        st_set(c, 0, id)
        ui_focus(c, id)
    if st_get(c, 0) == id and c.dn_prev and not c.dn:
        if hot:
            row = res.scroll + (c.my - y) / row_h
            node = tree_nth_visible(m, row)
            if node >= 0:
                d = tree_depth(m, node)
                tx = x + 10 + d * 18
                if tree_has_child(m, node) and c.mx < tx - 2:
                    tree_set_expanded(m, node, not tree_expanded(m, node))
                else:
                    res.sel = node
        st_set(c, 0, 0)
    if has_sb:
        res.scroll = sb_widget(c, x, y, w, h, sbw, y, h, vic, vis, res.scroll, maxs, off)
    return res

# ---- v3: table view (Qt's QTableView on a TableModel) ----

struct TableRet:
    sel: int
    scroll: int

def ui_table(c: UI, x: int, y: int, w: int, h: int, m: TableModel, sel_row: int, scroll: int) -> TableRet:
    res = TableRet(sel=sel_row, scroll=scroll)
    off = ui_disabled(c)
    id = ui_wid_id(x, y)
    rows = tm_rows(m)
    cols = tm_cols(m)
    head_h = 28
    row_h = 26
    vis = (h - head_h) / row_h
    if vis < 1:
        vis = 1
    maxs = rows - vis
    if maxs < 0:
        maxs = 0
    if res.scroll > maxs:
        res.scroll = maxs
    if res.scroll < 0:
        res.scroll = 0
    sbw = 12
    has_sb = rows > vis
    if not has_sb:
        sbw = 0
    # column widths: explicit (tm_colw > 0) or equal shares of the rest
    fixed = 0
    flex = 0
    i = 0
    while i < cols:
        cwx = tm_colw(m, i)
        if cwx > 0:
            fixed = fixed + cwx
        else:
            flex = flex + 1
        i = i + 1
    cw0 = w - sbw - fixed
    if flex > 0:
        cw0 = cw0 / flex
    if cw0 < 20:
        cw0 = 20
    hot = ui_mouse_in(c, x, y, w - sbw, h - head_h) and not off
    if hot and has_sb and not off:
        res.scroll = res.scroll - ui_wheel(c) / 120
        if res.scroll > maxs:
            res.scroll = maxs
        if res.scroll < 0:
            res.scroll = 0
    if not off:
        ui_focus_reg(c, id)
    if ui_focused(c, id) and not off:
        delta = 0
        if ui_key_pressed(c, 38):
            delta = -1
        if ui_key_pressed(c, 40):
            delta = 1
        if delta != 0:
            res.sel = res.sel + delta
            if res.sel >= rows:
                res.sel = rows - 1
            if res.sel < 0:
                res.sel = 0
            if res.sel < res.scroll:
                res.scroll = res.sel
            if res.sel >= res.scroll + vis:
                res.scroll = res.sel - vis + 1
    pal = ui_palette_get(c)
    face = pal.panel
    if off:
        face = pal.disabled_face
    bcol = pal.border
    if ui_focused(c, id):
        bcol = pal.accent
    ui_fill_rect(c, x, y, w, h, face)
    ui_frame_rect(c, x, y, w, h, bcol)
    # header row
    ui_fill_rect(c, x + 1, y + 1, w - sbw - 2, head_h - 1, pal.widget)
    ui_fill_rect(c, x + 1, y + head_h - 1, w - sbw - 2, 1, pal.border)
    cx = x + 1
    i = 0
    while i < cols:
        cwx = tm_colw(m, i)
        if cwx <= 0:
            cwx = cw0
        tcol = pal.text_dim
        if off:
            tcol = pal.disabled_text
        ui_draw_text(c, cx + 8, y + 5, tm_header(m, i), tcol)
        if i > 0:
            ui_fill_rect(c, cx, y + 1, 1, head_h - 2, pal.border)
        cx = cx + cwx
        i = i + 1
    # rows
    ui_clip_push(c, x + 1, y + head_h, x + w - sbw - 1, y + h - 1)
    r = res.scroll
    while r < rows and r < res.scroll + vis:
        ry = y + head_h + (r - res.scroll) * row_h
        if r == res.sel:
            ui_fill_rect(c, x + 1, ry, w - sbw - 2, row_h, pal.sel)
        elif hot and c.my >= ry and c.my < ry + row_h:
            ui_fill_rect(c, x + 1, ry, w - sbw - 2, row_h, pal.widget_hover)
        cx = x + 1
        i = 0
        while i < cols:
            cwx = tm_colw(m, i)
            if cwx <= 0:
                cwx = cw0
            tcol = pal.text
            if r == res.sel:
                tcol = pal.sel_text
            if off:
                tcol = pal.disabled_text
            ui_draw_text(c, cx + 8, ry + 3, tm_get(m, r, i), tcol)
            cx = cx + cwx
            i = i + 1
        r = r + 1
    ui_clip_pop(c)
    # row select
    if hot and c.dn and not c.dn_prev and st_get(c, 0) == 0:
        st_set(c, 0, id)
        ui_focus(c, id)
    if st_get(c, 0) == id and c.dn_prev and not c.dn:
        if hot:
            row = res.scroll + (c.my - y - head_h) / row_h
            if row >= 0 and row < rows:
                res.sel = row
        st_set(c, 0, 0)
    if has_sb:
        res.scroll = sb_widget(c, x, y, w, h, sbw, y + head_h, h - head_h, rows, vis, res.scroll, maxs, off)
    return res
# ---- lifecycle: portable shell over the backend ----

def ui_init(title: string, w: int, h: int) -> UI:
    c = ui_new()
    if not plat_supported():
        print("aoxn ui: no backend for this platform (import stdlib/ui_win on Windows, stdlib/ui_x11 on Linux)")
        return c
    c = ui_state_init(c)
    c = plat_init(c, title, w, h)
    if c.open:
        # the canvas rect is what the clip falls back to when the widget
        # layer's stack is empty, and what makes culling possible at all
        ui_clip_canvas(c, 0, 0, c.w, c.h)
    return c

# Shift the key snapshot: last frame's key_cur becomes key_prev, and
# key_cur is zeroed for the backend to refill. Edge detection
# (ui_key_pressed) compares the two, so this must run exactly once per
# frame BEFORE the backend samples input.
def key_snapshot_rotate(c: UI):
    i = 0
    while i < 256:
        st_set(c, 260 + i, st_get(c, 4 + i))
        st_set(c, 4 + i, 0)
        i = i + 1

# one frame: let the backend pump events and sample input, then run the
# portable per-frame bookkeeping the widgets depend on. Returns the updated
# context; check c.open afterwards.
def ui_frame(c: UI) -> UI:
    if not plat_supported():
        return c
    key_snapshot_rotate(c)
    c.wheel = 0
    st_set(c, 544, 0)
    st_set(c, 542, 0)
    if ui_overlay_kind(c) == 2:
        ui_overlay_clear(c)
    c = plat_pump(c)
    if not c.open:
        return c
    c.wheel = st_get(c, 544)
    # the overlay "eaten press" claim (act == -1) ends on release
    if st_get(c, 0) == -1 and c.dn_prev and not c.dn:
        st_set(c, 0, 0)
    focus_swap(c)
    if ui_key_pressed(c, vk_tab()):
        ui_focus_next(c, ui_key_down(c, vk_shift()))
    # reset the frame arena: steady-state frames allocate nothing
    st_set(c, 2, 0)
    pal = ui_palette_get(c)
    plat_fill_rect(c, 0, 0, c.w, c.h, pal.bg)
    c.frames = c.frames + 1
    return c

def ui_present(c: UI):
    # plat_canvas_ok is the backend's own "is there something to draw on"
    # check (a live window AND a live off-screen surface). Testing only
    # c.open would let the overlay painters run against a dead canvas.
    if not plat_supported() or not plat_canvas_ok(c):
        return
    ov = ui_overlay_kind(c)
    if ov == 1 or ov == 3:
        draw_combo_popup(c)
    elif ov == 2:
        draw_tooltip_overlay(c)
    plat_present(c)

def ui_close(c: UI):
    if plat_supported():
        plat_close(c)

def ui_fini(c: UI):
    if plat_supported():
        plat_fini(c)
    # the widget layer's own two blocks (clip shadow stack, measure cache);
    # both are lazily allocated, so both may be 0
    if st_get(c, 827) != 0:
        free(st_get(c, 827))
    if st_get(c, 834) != 0:
        free(st_get(c, 834))
    ui_state_free(c)
    free(c.msg)
    free(c.pt)
    free(c.rect)

def ui_alert(text: string, caption: string):
    if not plat_supported():
        print(text)
        return
    plat_alert(text, caption)

def ui_clip_get(c: UI) -> string:
    if not plat_supported():
        return ""
    return plat_clip_get(c)

def ui_clip_set(c: UI, s: string):
    if not plat_supported():
        return
    plat_clip_set(c, s)

# ---- the last few drawing/lifecycle bits that stayed platform-specific ----

# resize the off-screen surface (backends call this when the window resizes)
def ui_resize_canvas(c: UI, nw: int, nh: int) -> UI:
    if nw < 1 or nh < 1:
        return c
    c = plat_canvas_resize(c, nw, nh)
    c.w = nw
    c.h = nh
    # rebias the canvas only with an empty clip stack: mid-push the stack
    # still holds rects expressed against the OLD canvas, and a resize
    # between a push and its pop cannot happen (both happen inside one frame)
    if ui_clip_depth(c) == 0:
        ui_clip_canvas(c, 0, 0, nw, nh)
    return c

